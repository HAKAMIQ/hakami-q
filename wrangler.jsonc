{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hakami-q",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-09",
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "hakami-q-auth-preview",
          "database_id": "7e846299-bcd8-4c5d-9865-fe9f3c286ae4"
        }
      ],
      "vars": {
        "TURNSTILE_SITEKEY": "1x00000000000000000000AA",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
        "AUTH_PASSWORD_PEPPER": "preview-only-password-pepper-not-for-production-2026"
      }
    },
    "production": {
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "hakami-q-auth",
          "database_id": "64ea9669-bdfb-4329-bdd6-bab0803c6de2"
        }
      ],
      "vars": {
        "TURNSTILE_SITEKEY": "0x4AAAAAAELLaYZP_eTDico5",
        "TURNSTILE_HOSTNAMES": "hakami-q.pages.dev",
        "REGISTRATION_CLOSED": "1"
      }
    }
  }
}
