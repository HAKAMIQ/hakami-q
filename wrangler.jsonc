{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hakami-q",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-09",
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "hakami-q-auth-preview",
          "database_id": "7e846299-bcd8-4c5d-9865-fe9f3c286ae4"
        }
      ]
    },
    "production": {
      "d1_databases": []
    }
  }
}
