{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:blogger-pages": "node scripts/sync-blogger-pages.mjs",
    "content:quality": "node scripts/content-quality.mjs",
    "content:quality:strict": "node scripts/content-quality.mjs --strict",
    "content:quality:report": "node scripts/content-quality.mjs --json reports/content-quality.json",
    "ui:quality": "node scripts/fluent-ui-quality.mjs",
    "ui:quality:report": "node scripts/fluent-ui-quality.mjs --json reports/fluent-ui-quality.json",
    "web:quality": "node scripts/web-standards-quality.mjs",
    "predev": "npm run sync:blogger-pages",
    "dev": "astro dev",
    "prebuild": "npm run sync:blogger-pages && npm run content:quality && npm run ui:quality && npm run web:quality",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "sharp": "^0.35.0"
  }
}
