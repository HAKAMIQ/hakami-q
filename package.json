{
  "name": "hakami-q",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "blogger:independence": "node scripts/blogger-independence-quality.mjs",
    "article:rendered-quality": "node scripts/article-rendered-quality.mjs --dist dist",
    "content:cleanup": "node scripts/content-source-cleanup.mjs --write",
    "content:cleanup:check": "node scripts/content-source-cleanup.mjs --check",
    "content:legacy-cleanup": "node scripts/content-legacy-markup-cleanup.mjs --write",
    "content:legacy-cleanup:check": "node scripts/content-legacy-markup-cleanup.mjs --check",
    "content:quality": "node scripts/content-quality.mjs",
    "content:quality:strict": "node scripts/content-quality.mjs --strict",
    "content:quality:report": "node scripts/content-quality.mjs --json reports/content-quality.json",
    "security:audit": "node scripts/security-audit.mjs --strict",
    "security:audit:report": "node scripts/security-audit.mjs --json reports/security-audit.json",
    "ui:quality": "node scripts/fluent-ui-quality.mjs",
    "ui:quality:report": "node scripts/fluent-ui-quality.mjs --json reports/fluent-ui-quality.json",
    "web:quality": "node scripts/web-standards-quality.mjs",
    "seo:quality": "node scripts/seo-quality.mjs --dist dist",
    "final:audit": "node scripts/final-site-audit.mjs --dist dist",
    "final:audit:report": "node scripts/final-site-audit.mjs --dist dist --json reports/final-site-audit.json",
    "predev": "npm run blogger:independence",
    "dev": "astro dev",
    "prebuild": "npm run blogger:independence && npm run content:quality && npm run ui:quality && npm run web:quality",
    "build": "astro build",
    "postbuild": "npm run final:audit && npm run article:rendered-quality && npm run seo:quality",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "sharp": "^0.35.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
