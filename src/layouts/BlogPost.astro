---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	originalUrl,
	labels = [],
} = Astro.props;

const genericLabels = new Set([
	'articles',
	'article',
	'gaming articles',
	'gaming article',
	'مقالات',
	'المقالات',
	'ألعاب',
	'العاب',
]);

const broadPlatformLabels = new Set([
	'nintendo',
	'playstation',
	'xbox',
	'sega',
	'pc',
]);

const normalizedLabels = labels
	.map((label) => label.trim())
	.filter(Boolean)
	.filter((label) => !genericLabels.has(label.toLocaleLowerCase('en')));

const articleCategory =
	normalizedLabels.find((label) => !broadPlatformLabels.has(label.toLocaleLowerCase('en'))) ??
	normalizedLabels[0] ??
	null;
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<main class="post-main">
			<article class="post-shell">
				<header class="article-header fui-card">
					<nav class="fui-breadcrumb article-breadcrumb" aria-label="مسار الصفحة">
						<ol>
							<li><a href="/">الرئيسية</a></li>
							<li><a href="/blog">المقالات</a></li>
							{articleCategory && <li aria-current="page">{articleCategory}</li>}
						</ol>
					</nav>

					{articleCategory && (
						<div class="article-category" aria-label="تصنيف المقال">
							<span aria-hidden="true"></span>
							{articleCategory}
						</div>
					)}

					<h1>{title}</h1>
					<p class="article-description">{description}</p>

					<div class="article-meta" aria-label="معلومات المقال">
						<span class="meta-item">
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2v3M15 2v3M3 7h14M4 4h12a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"></path></svg>
							<span>نشر</span>
							<FormattedDate date={pubDate} />
						</span>

						{updatedDate && (
							<span class="meta-separator" aria-hidden="true">·</span>
							<span class="meta-item">
								<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 6V2m0 0h-4m4 0-3 3a7 7 0 1 0 2 8"></path></svg>
								<span>تحديث</span>
								<FormattedDate date={updatedDate} />
							</span>
						)}
					</div>

					{originalUrl && (
						<a class="meta-source fui-link" href={originalUrl} target="_blank" rel="noopener noreferrer">
							المصدر الأصلي
						</a>
					)}
				</header>

				<div class="article-content fluent-rich-text">
					<slot />
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.post-main { padding-top: var(--spacing-200); }

	.post-shell {
		width: min(calc(100% - (var(--page-gutter) * 2)), 1120px);
		margin-inline: auto;
	}

	.article-header {
		width: min(100%, 920px);
		margin-inline: auto;
		padding: clamp(var(--spacing-180), 2.4vw, var(--spacing-240));
		border-color: var(--color-neutral-stroke-2);
		background: var(--color-neutral-background-2);
		box-shadow: none;
	}

	.article-breadcrumb {
		margin-bottom: var(--spacing-120);
		color: var(--color-neutral-foreground-3);
	}

	.article-breadcrumb :global(a) {
		color: var(--color-neutral-foreground-3);
	}

	.article-breadcrumb :global(a:hover),
	.article-breadcrumb :global(a:focus-visible) {
		color: var(--color-neutral-foreground-1);
	}

	.article-category {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-60);
		margin-bottom: var(--spacing-80);
		color: var(--color-brand-foreground-strong);
		font-size: var(--font-size-caption-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-caption-1);
	}

	.article-category > span {
		width: 6px;
		height: 6px;
		flex: 0 0 auto;
		border-radius: var(--radius-circular);
		background: var(--color-brand-background);
	}

	.article-header h1 {
		max-width: 840px;
		font-size: clamp(2rem, 3vw, 2.375rem);
		font-weight: var(--font-weight-semibold);
		line-height: 1.32;
		text-wrap: balance;
	}

	.article-description {
		max-width: 760px;
		margin-top: var(--spacing-100);
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-body-1);
		line-height: 1.75;
		text-wrap: pretty;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-60);
		margin-top: var(--spacing-140);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
	}

	.meta-item {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-50);
		color: inherit;
	}

	.meta-item svg {
		width: 15px;
		height: 15px;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
	}

	.meta-item :global(time) {
		color: var(--color-neutral-foreground-2);
		font-weight: var(--font-weight-medium);
	}

	.meta-separator { color: var(--color-neutral-foreground-4); }

	.meta-source {
		display: inline-flex;
		margin-top: var(--spacing-80);
		font-size: var(--font-size-caption-1);
		font-weight: var(--font-weight-semibold);
	}

	.article-content {
		width: min(100%, var(--reading-width));
		margin: var(--spacing-200) auto 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-reading);
		line-height: var(--line-height-reading);
		overflow-wrap: anywhere;
	}

	.article-content > :global(div),
	.article-content > :global(section),
	.article-content > :global(article) {
		width: 100% !important;
		max-width: 100% !important;
		margin-inline: 0 !important;
		padding-inline: 0 !important;
		border-inline: 0 !important;
		box-shadow: none !important;
	}

	.article-content > :global(:first-child) { margin-top: 0 !important; }

	.article-content :global(p) { margin: 0 0 var(--spacing-160); }

	.article-content :global(h2),
	.article-content :global(h3),
	.article-content :global(h4),
	.article-content :global(h5),
	.article-content :global(h6) {
		scroll-margin-top: var(--spacing-320);
		color: var(--color-neutral-foreground-1);
	}

	.article-content :global(h2) {
		margin: var(--spacing-400) 0 var(--spacing-120);
		padding-bottom: var(--spacing-80);
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		font-size: var(--font-size-title-3);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-title-3);
	}

	.article-content :global(h3) {
		margin: var(--spacing-320) 0 var(--spacing-100);
		font-size: var(--font-size-subtitle-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-subtitle-1);
	}

	.article-content :global(h4) {
		margin: var(--spacing-240) 0 var(--spacing-80);
		font-size: var(--font-size-subtitle-2);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-subtitle-2);
	}

	.article-content :global(a) {
		color: var(--color-brand-foreground-link);
		text-decoration-thickness: var(--stroke-thin);
		text-underline-offset: 3px;
	}

	.article-content :global(a:hover) { color: var(--color-brand-foreground-link-hover); }

	.article-content :global(img) {
		display: block;
		width: auto !important;
		max-width: min(100%, 760px) !important;
		height: auto !important;
		margin: var(--spacing-200) auto;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-2);
	}

	.article-content :global(figure) {
		width: min(100%, 820px) !important;
		max-width: 100% !important;
		margin: var(--spacing-240) auto;
	}

	.article-content :global(figcaption) {
		margin-top: var(--spacing-80);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
		text-align: center;
	}

	.article-content :global(iframe),
	.article-content :global(video) {
		width: 100% !important;
		max-width: 100% !important;
		aspect-ratio: 16 / 9;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-radius: var(--radius-large);
		background: #000;
	}

	.article-content :global(table) {
		display: block;
		width: 100% !important;
		max-width: 100% !important;
		margin: var(--spacing-200) 0;
		overflow-x: auto;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-large);
		border-collapse: separate;
		border-spacing: 0;
		background: var(--color-neutral-background-2);
	}

	.article-content :global(th),
	.article-content :global(td) {
		min-width: 120px;
		padding: var(--spacing-120);
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-inline-start: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		text-align: start;
		vertical-align: top;
	}

	.article-content :global(th) {
		background: var(--color-neutral-background-1);
		color: var(--color-neutral-foreground-1);
		font-weight: var(--font-weight-semibold);
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin: var(--spacing-160) 0 var(--spacing-200);
		padding-inline-start: var(--spacing-240);
	}

	.article-content :global(li + li) { margin-top: var(--spacing-80); }

	.article-content :global(blockquote) {
		margin: var(--spacing-240) 0;
		padding: var(--spacing-160);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-inline-start: var(--stroke-thicker) solid var(--color-brand-stroke-1);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-3);
	}

	.article-content :global(pre) {
		max-width: 100%;
		margin: var(--spacing-200) 0;
		overflow: auto;
	}

	.article-content :global(button) {
		min-height: var(--control-height-small);
		padding-inline: var(--spacing-120);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-medium);
		background: var(--color-neutral-background-1);
		color: var(--color-neutral-foreground-1);
		cursor: pointer;
	}

	.article-content :global(.separator),
	.article-content :global(.tr-caption-container) {
		width: 100% !important;
		max-width: 100% !important;
		margin-inline: auto !important;
	}

	@media (max-width: 639px) {
		.post-main { padding-top: var(--spacing-120); }
		.article-header { padding: var(--spacing-140); }
		.article-breadcrumb { margin-bottom: var(--spacing-100); }
		.article-header h1 { font-size: var(--font-size-title-2); line-height: var(--line-height-title-2); }
		.article-description { margin-top: var(--spacing-80); font-size: var(--font-size-body-1); line-height: 1.7; }
		.article-meta { margin-top: var(--spacing-120); gap: var(--spacing-50); }
		.meta-source { min-height: 40px; align-items: center; }
		.article-content { margin-top: var(--spacing-140); }
		.article-content :global(h2) { margin-top: var(--spacing-320); font-size: var(--font-size-subtitle-1); line-height: var(--line-height-subtitle-1); }
		.article-content :global(h3) { font-size: var(--font-size-subtitle-2); line-height: var(--line-height-subtitle-2); }
		.article-content :global(img) { max-width: 100% !important; margin-block: var(--spacing-160); }
	}

	@media (pointer: coarse) {
		.meta-source,
		.article-content :global(button) { min-height: 44px; }
	}
</style>
