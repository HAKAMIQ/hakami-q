---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	labels = [],
} = Astro.props;

const genericLabels = new Set([
	'articles',
	'article',
	'gaming articles',
	'gaming article',
	'مقالات',
	'المقالات',
	'ألعاب',
	'العاب',
]);

const broadPlatformLabels = new Set([
	'nintendo',
	'playstation',
	'xbox',
	'sega',
	'pc',
]);

const labelAliases = new Map([
	['ns', 'Nintendo Switch'],
]);

const normalizedLabels = labels
	.map((label) => label.trim())
	.filter(Boolean)
	.filter((label) => !genericLabels.has(label.toLocaleLowerCase('en')))
	.map((label) => labelAliases.get(label.toLocaleLowerCase('en')) ?? label);

const articleCategory =
	normalizedLabels.find((label) => !broadPlatformLabels.has(label.toLocaleLowerCase('en'))) ??
	normalizedLabels[0] ??
	null;

const sameCalendarDay = (first: Date, second: Date) =>
	first.getFullYear() === second.getFullYear() &&
	first.getMonth() === second.getMonth() &&
	first.getDate() === second.getDate();

const showUpdatedDate = updatedDate ? !sameCalendarDay(pubDate, updatedDate) : false;
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<main class="post-main">
			<article class="post-shell">
				<header class="article-header">
					<nav class="fui-breadcrumb article-breadcrumb" aria-label="مسار الصفحة">
						<ol>
							<li><a href="/">الرئيسية</a></li>
							<li><a href="/blog">المقالات</a></li>
							{articleCategory && <li aria-current="page">{articleCategory}</li>}
						</ol>
					</nav>

					<h1>{title}</h1>
					<p class="article-description">{description}</p>

					<div class="article-meta" aria-label="معلومات المقال">
						<span class="meta-item">
							<span>نشر</span>
							<FormattedDate date={pubDate} />
						</span>

						{showUpdatedDate && updatedDate && (
							<>
								<span class="meta-separator" aria-hidden="true">·</span>
								<span class="meta-item">
									<span>تحديث</span>
									<FormattedDate date={updatedDate} />
								</span>
							</>
						)}
					</div>
				</header>

				<div class="article-content fluent-rich-text">
					<slot />
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.post-main {
		padding-top: clamp(var(--spacing-120), 2vw, var(--spacing-240));
	}

	.post-shell {
		width: min(100%, 1320px);
		margin-inline: auto;
		padding-inline: clamp(var(--spacing-160), 3vw, var(--spacing-400));
		box-sizing: border-box;
	}

	.article-header {
		width: min(100%, 1120px);
		margin-inline: auto;
		padding: 0 0 clamp(var(--spacing-160), 2vw, var(--spacing-240));
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
	}

	.article-breadcrumb {
		margin-bottom: clamp(var(--spacing-120), 1.5vw, var(--spacing-160));
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
	}

	.article-breadcrumb :global(a) {
		color: var(--color-neutral-foreground-3);
		text-decoration: none;
	}

	.article-breadcrumb :global(a:hover),
	.article-breadcrumb :global(a:focus-visible) {
		color: var(--color-neutral-foreground-1);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.article-header h1 {
		max-width: 980px;
		margin: 0;
		font-size: clamp(1.75rem, 2.35vw, 2.5rem);
		font-weight: var(--font-weight-semibold);
		line-height: 1.32;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.article-description {
		max-width: 900px;
		margin: var(--spacing-100) 0 0;
		color: var(--color-neutral-foreground-3);
		font-size: clamp(var(--font-size-body-1), 1.15vw, var(--font-size-subtitle-2));
		line-height: 1.75;
		text-wrap: pretty;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-60);
		margin-top: var(--spacing-120);
		color: var(--color-neutral-foreground-4);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
	}

	.meta-item {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-40);
	}

	.meta-item :global(time) {
		color: var(--color-neutral-foreground-3);
		font-weight: var(--font-weight-regular);
	}

	.meta-separator {
		color: var(--color-neutral-foreground-disabled);
	}

	.article-content {
		width: min(100%, 1180px);
		margin: clamp(var(--spacing-160), 2.2vw, var(--spacing-280)) auto 0;
		padding: 0;
		border: 0;
		background: transparent;
		box-shadow: none;
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-reading);
		line-height: var(--line-height-reading);
		overflow-wrap: anywhere;
		container-type: inline-size;
	}

	.article-content > :global(div),
	.article-content > :global(section),
	.article-content > :global(article) {
		width: 100% !important;
		max-width: 100% !important;
	}

	.article-content > :global(:first-child) {
		margin-top: 0 !important;
	}

	.article-content :global(p) {
		margin: 0 0 var(--spacing-160);
	}

	.article-content :global(h2),
	.article-content :global(h3),
	.article-content :global(h4),
	.article-content :global(h5),
	.article-content :global(h6) {
		scroll-margin-top: var(--spacing-320);
		color: var(--color-neutral-foreground-1);
		text-wrap: balance;
	}

	.article-content :global(h2) {
		margin: var(--spacing-400) 0 var(--spacing-120);
		padding-bottom: var(--spacing-80);
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		font-size: var(--font-size-title-3);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-title-3);
	}

	.article-content :global(h3) {
		margin: var(--spacing-320) 0 var(--spacing-100);
		font-size: var(--font-size-subtitle-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-subtitle-1);
	}

	.article-content :global(h4) {
		margin: var(--spacing-240) 0 var(--spacing-80);
		font-size: var(--font-size-subtitle-2);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-subtitle-2);
	}

	.article-content :global(a) {
		color: var(--color-brand-foreground-link);
		text-decoration-thickness: var(--stroke-thin);
		text-underline-offset: 3px;
	}

	.article-content :global(a:hover) {
		color: var(--color-brand-foreground-link-hover);
	}

	.article-content :global(img) {
		display: block;
		width: auto !important;
		max-width: min(100%, 960px) !important;
		height: auto !important;
		margin: clamp(var(--spacing-160), 2vw, var(--spacing-240)) auto;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-2);
	}

	.article-content :global(figure) {
		width: min(100%, 1020px) !important;
		max-width: 100% !important;
		margin: clamp(var(--spacing-200), 2.4vw, var(--spacing-280)) auto;
	}

	.article-content :global(figcaption) {
		margin-top: var(--spacing-80);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
		text-align: center;
	}

	.article-content :global(iframe),
	.article-content :global(video) {
		display: block;
		width: min(100%, 1020px) !important;
		max-width: 100% !important;
		margin-inline: auto;
		aspect-ratio: 16 / 9;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-radius: var(--radius-large);
		background: #000;
	}

	.article-content :global(table) {
		display: block;
		width: 100% !important;
		max-width: 100% !important;
		margin: var(--spacing-200) 0;
		overflow-x: auto;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-large);
		border-collapse: separate;
		border-spacing: 0;
		background: var(--color-neutral-background-2);
	}

	.article-content :global(th),
	.article-content :global(td) {
		min-width: 120px;
		padding: var(--spacing-120);
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-inline-start: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		text-align: start;
		vertical-align: top;
	}

	.article-content :global(th) {
		background: var(--color-neutral-background-1);
		color: var(--color-neutral-foreground-1);
		font-weight: var(--font-weight-semibold);
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin: var(--spacing-160) 0 var(--spacing-200);
		padding-inline-start: var(--spacing-240);
	}

	.article-content :global(li + li) {
		margin-top: var(--spacing-80);
	}

	.article-content :global(blockquote) {
		margin: var(--spacing-240) 0;
		padding: var(--spacing-160);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-inline-start: var(--stroke-thicker) solid var(--color-brand-stroke-1);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-3);
	}

	.article-content :global(pre) {
		max-width: 100%;
		margin: var(--spacing-200) 0;
		overflow: auto;
	}

	.article-content :global(button) {
		min-height: var(--control-height-small);
		padding-inline: var(--spacing-120);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-medium);
		background: var(--color-neutral-background-1);
		color: var(--color-neutral-foreground-1);
		cursor: pointer;
	}

	.article-content :global(.separator),
	.article-content :global(.tr-caption-container) {
		width: 100% !important;
		max-width: 100% !important;
		margin-inline: auto !important;
	}

	/* Keep long-form prose comfortable while allowing rich article modules to use the wider canvas. */
	.article-content > :global(p),
	.article-content > :global(h2),
	.article-content > :global(h3),
	.article-content > :global(h4),
	.article-content > :global(h5),
	.article-content > :global(h6),
	.article-content > :global(ul),
	.article-content > :global(ol),
	.article-content > :global(blockquote),
	.article-content > :global(pre) {
		max-width: 880px;
		margin-inline: auto;
	}

	/* Responsive rich-content grids: 3 columns on wide screens, 2 on tablets, 1 on phones without hard breakpoints. */
	.article-content :global(.hq-sources),
	.article-content :global(.hq-axis-grid),
	.article-content :global(.hq-problems) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)) !important;
		gap: clamp(var(--spacing-80), 1.2vw, var(--spacing-160)) !important;
	}

	.article-content :global(.hq-card) {
		width: 100%;
		padding: clamp(var(--spacing-160), 2vw, var(--spacing-240));
	}

	.article-content :global(.hq-source),
	.article-content :global(.hq-axis),
	.article-content :global(.hq-step),
	.article-content :global(.hq-problem) {
		min-width: 0;
	}

	.article-content :global(.hq-source) {
		min-height: clamp(60px, 5.5vw, 76px);
	}

	@media (max-width: 1023px) {
		.post-shell {
			padding-inline: clamp(var(--spacing-160), 2.5vw, var(--spacing-240));
		}

		.article-header,
		.article-content {
			width: 100%;
		}

		.article-header h1 {
			font-size: clamp(1.75rem, 4vw, 2.125rem);
		}

		.article-description {
			max-width: 820px;
		}
	}

	@media (max-width: 639px) {
		.post-main {
			padding-top: var(--spacing-100);
		}

		.post-shell {
			padding-inline: var(--spacing-160);
		}

		.article-header {
			padding-bottom: var(--spacing-160);
		}

		.article-breadcrumb {
			margin-bottom: var(--spacing-100);
			overflow-x: auto;
			white-space: nowrap;
			scrollbar-width: none;
		}

		.article-breadcrumb::-webkit-scrollbar {
			display: none;
		}

		.article-header h1 {
			font-size: clamp(1.6rem, 7vw, 1.875rem);
			line-height: 1.38;
			text-wrap: pretty;
		}

		.article-description {
			margin-top: var(--spacing-80);
			font-size: var(--font-size-body-1);
			line-height: 1.7;
		}

		.article-meta {
			margin-top: var(--spacing-100);
			gap: var(--spacing-40);
		}

		.article-content {
			margin-top: var(--spacing-160);
			font-size: var(--font-size-reading);
			line-height: var(--line-height-reading);
		}

		.article-content :global(h2) {
			margin-top: var(--spacing-320);
			font-size: var(--font-size-subtitle-1);
			line-height: var(--line-height-subtitle-1);
		}

		.article-content :global(h3) {
			font-size: var(--font-size-subtitle-2);
			line-height: var(--line-height-subtitle-2);
		}

		.article-content :global(img),
		.article-content :global(figure),
		.article-content :global(iframe),
		.article-content :global(video) {
			max-width: 100% !important;
			margin-block: var(--spacing-160);
			border-radius: var(--radius-medium);
		}

		.article-content :global(.hq-card) {
			padding: var(--spacing-140, 14px);
			border-radius: var(--radius-medium);
		}
	}

	@media (pointer: coarse) {
		.article-content :global(button),
		.article-content :global(.hq-source) {
			min-height: 44px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.article-content :global(*) {
			scroll-behavior: auto !important;
		}
	}
</style>
