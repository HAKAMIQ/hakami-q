---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	labels = [],
} = Astro.props;

const genericLabels = new Set([
	'articles',
	'article',
	'gaming articles',
	'gaming article',
	'مقالات',
	'المقالات',
	'ألعاب',
	'العاب',
]);

const broadPlatformLabels = new Set([
	'nintendo',
	'playstation',
	'xbox',
	'sega',
	'pc',
]);

const labelAliases = new Map([
	['ns', 'Nintendo Switch'],
]);

const normalizedLabels = labels
	.map((label) => label.trim())
	.filter(Boolean)
	.filter((label) => !genericLabels.has(label.toLocaleLowerCase('en')))
	.map((label) => labelAliases.get(label.toLocaleLowerCase('en')) ?? label);

const articleCategory =
	normalizedLabels.find((label) => !broadPlatformLabels.has(label.toLocaleLowerCase('en'))) ??
	normalizedLabels[0] ??
	null;
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<main class="post-main">
			<article class="post-shell">
				<header class="article-header">
					<nav class="fui-breadcrumb article-breadcrumb" aria-label="مسار الصفحة">
						<ol>
							<li><a href="/">الرئيسية</a></li>
							<li><a href="/blog">المقالات</a></li>
							{articleCategory && <li aria-current="page">{articleCategory}</li>}
						</ol>
					</nav>

					<h1>{title}</h1>
				</header>

				<div class="article-content fluent-rich-text">
					<slot />
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.post-main {
		padding-top: clamp(var(--spacing-100), 1.5vw, var(--spacing-200));
	}

	.post-shell {
		width: min(100%, 1400px);
		margin-inline: auto;
		padding-inline: clamp(var(--spacing-160), 3vw, var(--spacing-400));
		box-sizing: border-box;
	}

	.article-header {
		width: min(100%, 1180px);
		margin-inline: auto;
		padding: 0;
	}

	.article-breadcrumb {
		margin-bottom: clamp(var(--spacing-100), 1.2vw, var(--spacing-140));
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
	}

	.article-breadcrumb :global(a) {
		color: var(--color-neutral-foreground-3);
		text-decoration: none;
	}

	.article-breadcrumb :global(a:hover),
	.article-breadcrumb :global(a:focus-visible) {
		color: var(--color-neutral-foreground-1);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.article-header h1 {
		max-width: 1080px;
		margin: 0;
		font-size: clamp(1.75rem, 2.25vw, 2.375rem);
		font-weight: var(--font-weight-semibold);
		line-height: 1.34;
		letter-spacing: -0.01em;
		text-align: start;
		text-wrap: balance;
	}

	.article-content {
		width: min(100%, 1200px);
		margin: clamp(var(--spacing-120), 1.5vw, var(--spacing-200)) auto 0;
		padding: 0;
		border: 0;
		background: var(--color-transparent-background);
		box-shadow: none;
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-reading);
		line-height: var(--line-height-reading);
		text-align: start;
		overflow-wrap: anywhere;
		container-type: inline-size;
	}

	.article-content > :global(div),
	.article-content > :global(section),
	.article-content > :global(article) {
		width: 100% !important;
		max-width: 100% !important;
		min-width: 0;
	}

	.article-content > :global(:first-child) {
		margin-top: 0 !important;
	}

	.article-content :global(p) {
		margin: 0 0 var(--spacing-160);
		text-wrap: pretty;
	}

	.article-content :global(h2),
	.article-content :global(h3),
	.article-content :global(h4),
	.article-content :global(h5),
	.article-content :global(h6) {
		scroll-margin-top: var(--spacing-320);
		color: var(--color-neutral-foreground-1);
		text-align: start;
		text-wrap: balance;
	}

	.article-content :global(h2) {
		margin: var(--spacing-360, 36px) 0 var(--spacing-120);
		padding-bottom: var(--spacing-80);
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		font-size: var(--font-size-title-3);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-title-3);
	}

	.article-content :global(h3) {
		margin: var(--spacing-280, 28px) 0 var(--spacing-100);
		font-size: var(--font-size-subtitle-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-subtitle-1);
	}

	.article-content :global(h4) {
		margin: var(--spacing-240) 0 var(--spacing-80);
		font-size: var(--font-size-subtitle-2);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-subtitle-2);
	}

	.article-content :global(a) {
		color: var(--color-brand-foreground-link);
		text-decoration-thickness: var(--stroke-thin);
		text-underline-offset: 3px;
	}

	.article-content :global(a:hover) {
		color: var(--color-brand-foreground-link-hover);
	}

	.article-content :global(img) {
		display: block;
		width: auto !important;
		max-width: min(100%, 1000px) !important;
		height: auto !important;
		margin: clamp(var(--spacing-160), 2vw, var(--spacing-240)) auto;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-2);
	}

	.article-content :global(figure) {
		width: min(100%, 1040px) !important;
		max-width: 100% !important;
		margin: clamp(var(--spacing-180, 18px), 2vw, var(--spacing-240)) auto;
	}

	.article-content :global(figcaption) {
		margin-top: var(--spacing-80);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
		text-align: center;
	}

	.article-content :global(iframe),
	.article-content :global(video) {
		display: block;
		width: min(100%, 1040px) !important;
		max-width: 100% !important;
		margin-inline: auto;
		aspect-ratio: 16 / 9;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-5);
	}

	.article-content :global(table) {
		display: block;
		width: 100% !important;
		max-width: 100% !important;
		margin: var(--spacing-200) 0;
		overflow-x: auto;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-large);
		border-collapse: separate;
		border-spacing: 0;
		background: var(--color-neutral-background-2);
	}

	.article-content :global(th),
	.article-content :global(td) {
		min-width: 120px;
		padding: var(--spacing-120);
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-inline-start: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		text-align: start;
		vertical-align: top;
	}

	.article-content :global(th) {
		background: var(--color-neutral-background-1);
		color: var(--color-neutral-foreground-1);
		font-weight: var(--font-weight-semibold);
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin: var(--spacing-160) 0 var(--spacing-200);
		padding-inline-start: var(--spacing-240);
	}

	.article-content :global(li + li) {
		margin-top: var(--spacing-80);
	}

	.article-content :global(blockquote) {
		margin: var(--spacing-240) 0;
		padding: var(--spacing-160);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-inline-start: var(--stroke-thicker) solid var(--color-brand-stroke-1);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-3);
	}

	.article-content :global(pre) {
		max-width: 100%;
		margin: var(--spacing-200) 0;
		overflow: auto;
	}

	.article-content :global(button) {
		min-height: var(--control-height-small);
		padding-inline: var(--spacing-120);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-medium);
		background: var(--color-neutral-background-1);
		color: var(--color-neutral-foreground-1);
		cursor: pointer;
	}

	.article-content :global(.separator),
	.article-content :global(.tr-caption-container) {
		width: 100% !important;
		max-width: 100% !important;
		margin-inline: auto !important;
	}

	/* Long prose stays readable while screenshots, grids and rich modules can use the wider article canvas. */
	.article-content > :global(p),
	.article-content > :global(h2),
	.article-content > :global(h3),
	.article-content > :global(h4),
	.article-content > :global(h5),
	.article-content > :global(h6),
	.article-content > :global(ul),
	.article-content > :global(ol),
	.article-content > :global(blockquote),
	.article-content > :global(pre) {
		width: min(100%, 920px);
		max-width: 920px;
		margin-inline: auto;
	}

	/* Imported article headers are content, not a second page title. Keep their text readable and start-aligned. */
	.article-content :global(header p) {
		max-width: 920px;
		margin-inline: auto !important;
		color: var(--color-neutral-foreground-2) !important;
		font-size: var(--font-size-reading) !important;
		line-height: var(--line-height-reading) !important;
		text-align: start !important;
		text-wrap: pretty;
	}

	.article-content :global(header h2),
	.article-content :global(header h3) {
		max-width: 920px;
		margin-inline: auto !important;
		text-align: start !important;
	}

	/* Shared treatment for the recurrent HAKAMIQ rich-guide family. No content is hidden. */
	.article-content :global(.hq-header) {
		width: min(100%, 920px) !important;
		margin: 0 auto var(--spacing-240) !important;
		padding: 0 0 var(--spacing-160) !important;
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha) !important;
		text-align: start !important;
	}

	.article-content :global(.hq-badges) {
		justify-content: flex-start !important;
		gap: var(--spacing-60) !important;
		margin: 0 0 var(--spacing-120) !important;
	}

	.article-content :global(.hq-badge),
	.article-content :global(.hq-badge-red),
	.article-content :global(.hq-badge-green),
	.article-content :global(.hq-badge-blue) {
		min-height: 24px !important;
		padding: 2px var(--spacing-100) !important;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-3) !important;
		border-radius: var(--radius-circular) !important;
		background: var(--color-neutral-background-2) !important;
		color: var(--color-neutral-foreground-2) !important;
		font-size: var(--font-size-caption-1) !important;
		font-weight: var(--font-weight-semibold) !important;
		line-height: var(--line-height-caption-1) !important;
	}

	.article-content :global(.hq-sources),
	.article-content :global(.hq-axis-grid),
	.article-content :global(.hq-problems) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)) !important;
		gap: clamp(var(--spacing-80), 1.2vw, var(--spacing-160)) !important;
	}

	.article-content :global(.hq-card) {
		width: 100%;
		padding: clamp(var(--spacing-160), 2vw, var(--spacing-240)) !important;
		border-color: var(--color-neutral-stroke-3) !important;
		box-shadow: var(--shadow-2) !important;
	}

	.article-content :global(.hq-card h3) {
		margin-top: 0 !important;
		text-align: start !important;
	}

	.article-content :global(.hq-setting-box) {
		width: 100% !important;
		max-width: 100% !important;
		margin-inline: 0 !important;
	}

	.article-content :global(.hq-setting-path) {
		max-width: 100%;
		overflow-x: auto;
		white-space: nowrap;
	}

	.article-content :global(.hq-source),
	.article-content :global(.hq-axis),
	.article-content :global(.hq-step),
	.article-content :global(.hq-problem) {
		min-width: 0;
	}

	.article-content :global(.hq-source) {
		min-height: clamp(60px, 5.5vw, 76px);
	}

	.article-content :global(.hq-shot) {
		width: min(100%, 960px) !important;
		max-width: 100% !important;
		margin-inline: auto !important;
	}

	@media (max-width: 1023px) {
		.post-shell {
			padding-inline: clamp(var(--spacing-160), 2.5vw, var(--spacing-240));
		}

		.article-header,
		.article-content {
			width: 100%;
		}

		.article-header h1 {
			font-size: clamp(1.75rem, 4vw, 2.125rem);
		}
	}

	@media (max-width: 639px) {
		.post-main {
			padding-top: var(--spacing-100);
		}

		.post-shell {
			padding-inline: var(--spacing-120);
		}

		.article-breadcrumb {
			margin-bottom: var(--spacing-100);
			overflow-x: auto;
			white-space: nowrap;
			scrollbar-width: none;
		}

		.article-breadcrumb::-webkit-scrollbar {
			display: none;
		}

		.article-header h1 {
			font-size: clamp(1.55rem, 7vw, 1.875rem);
			line-height: 1.4;
			text-wrap: pretty;
		}

		.article-content {
			margin-top: var(--spacing-120);
			font-size: var(--font-size-reading);
			line-height: var(--line-height-reading);
		}

		.article-content :global(h2) {
			margin-top: var(--spacing-280, 28px);
			font-size: var(--font-size-subtitle-1);
			line-height: var(--line-height-subtitle-1);
		}

		.article-content :global(h3) {
			margin-top: var(--spacing-240);
			font-size: var(--font-size-subtitle-2);
			line-height: var(--line-height-subtitle-2);
		}

		.article-content :global(img),
		.article-content :global(figure),
		.article-content :global(iframe),
		.article-content :global(video) {
			max-width: 100% !important;
			margin-block: var(--spacing-140, 14px);
			border-radius: var(--radius-medium);
		}

		.article-content :global(.hq-header) {
			margin-bottom: var(--spacing-160) !important;
			padding-bottom: var(--spacing-120) !important;
		}

		.article-content :global(.hq-card) {
			padding: var(--spacing-140, 14px) !important;
			border-radius: var(--radius-medium);
		}

		.article-content :global(.hq-setting-path) {
			font-size: var(--font-size-caption-1);
		}
	}

	@media (pointer: coarse) {
		.article-content :global(button),
		.article-content :global(.hq-source) {
			min-height: 44px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.article-content :global(*) {
			scroll-behavior: auto !important;
		}
	}
</style>
