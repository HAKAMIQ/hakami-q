---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	originalUrl,
	labels = [],
} = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<main class="post-main">
			<article class="post-shell">
				<header class="article-header">
					<nav class="breadcrumbs" aria-label="مسار الصفحة">
						<a href="/">الرئيسية</a>
						<span aria-hidden="true">/</span>
						<a href="/blog">المقالات</a>
					</nav>

					{
						labels.length > 0 && (
							<div class="article-labels" aria-label="تصنيفات المقال">
								{labels.slice(0, 4).map((label) => <span>{label}</span>)}
							</div>
						)
					}

					<h1>{title}</h1>
					<p class="article-description">{description}</p>

					<div class="article-meta">
						<span class="meta-item">
							<svg viewBox="0 0 20 20" aria-hidden="true">
								<path d="M5 2v3M15 2v3M3 7h14M4 4h12a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"></path>
							</svg>
							<span>نشر في</span>
							<FormattedDate date={pubDate} />
						</span>

						{
							updatedDate && (
								<span class="meta-item">
									<svg viewBox="0 0 20 20" aria-hidden="true">
										<path d="M16 6V2m0 0h-4m4 0-3 3a7 7 0 1 0 2 8"></path>
									</svg>
									<span>آخر تحديث</span>
									<FormattedDate date={updatedDate} />
								</span>
							)
						}

						{
							originalUrl && (
								<a
									class="meta-source"
									href={originalUrl}
									target="_blank"
									rel="noopener noreferrer"
								>
									المصدر الأصلي
								</a>
							)
						}
					</div>
				</header>

				<div class="article-content">
					<slot />
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.post-main {
		padding: clamp(1rem, 3vw, 2.25rem) 0 0;
	}

	.post-shell {
		width: min(calc(100% - 48px), 1240px);
		margin-inline: auto;
	}

	.article-header {
		position: relative;
		overflow: hidden;
		padding: clamp(1.4rem, 4vw, 3rem);
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-xxlarge);
		background:
			linear-gradient(120deg, rgba(232, 17, 35, 0.11), transparent 40%),
			radial-gradient(circle at 12% 14%, rgba(255, 255, 255, 0.045), transparent 26rem),
			var(--color-neutral-background-2);
		box-shadow: var(--shadow-8);
	}

	.article-header::after {
		position: absolute;
		inset: auto -8rem -12rem auto;
		width: 24rem;
		height: 24rem;
		border: 1px solid rgba(232, 17, 35, 0.16);
		border-radius: 50%;
		content: "";
		pointer-events: none;
	}

	.breadcrumbs {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 1rem;
		color: var(--color-neutral-foreground-3);
		font-size: 0.78rem;
	}

	.breadcrumbs a {
		padding: 0.2rem 0.45rem;
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		background: var(--color-neutral-background-4);
		color: var(--color-neutral-foreground-1);
	}

	.article-labels {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 0.85rem;
	}

	.article-labels span {
		display: inline-flex;
		min-height: 28px;
		align-items: center;
		padding: 0 0.62rem;
		border: 1px solid var(--color-status-danger-border);
		border-radius: 999px;
		background: var(--color-status-danger-background);
		color: var(--color-brand-foreground-strong);
		font-size: 0.72rem;
		font-weight: 700;
	}

	.article-header h1 {
		position: relative;
		z-index: 1;
		max-width: 1080px;
		font-size: clamp(2rem, 5vw, 4rem);
		font-weight: 800;
		letter-spacing: -0.025em;
		line-height: 1.25;
	}

	.article-description {
		position: relative;
		z-index: 1;
		max-width: 960px;
		margin-top: 1rem;
		color: var(--color-neutral-foreground-2);
		font-size: clamp(0.98rem, 1.4vw, 1.12rem);
		line-height: 1.9;
	}

	.article-meta {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
		margin-top: 1.35rem;
	}

	.meta-item,
	.meta-source {
		display: inline-flex;
		min-height: 34px;
		align-items: center;
		gap: 0.38rem;
		padding: 0 0.7rem;
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-medium);
		background: rgba(17, 19, 21, 0.54);
		color: var(--color-neutral-foreground-3);
		font-size: 0.76rem;
		text-decoration: none;
		box-shadow: var(--shadow-2);
	}

	.meta-item svg {
		width: 15px;
		height: 15px;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.meta-item :global(time) {
		color: var(--color-neutral-foreground-1);
		font-weight: 650;
	}

	.meta-source {
		color: var(--color-brand-foreground-strong);
	}

	.meta-source:hover {
		border-color: var(--color-status-danger-border);
		background: var(--color-status-danger-background);
	}

	.article-content {
		width: min(100%, var(--content-width));
		margin: 1.25rem auto 0;
		padding: clamp(1.25rem, 4vw, 3rem);
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-xxlarge);
		background: var(--color-neutral-background-2);
		box-shadow: var(--shadow-8);
		color: var(--color-neutral-foreground-2);
		font-size: 1rem;
		line-height: 1.95;
		overflow-wrap: anywhere;
	}

	.article-content > :global(div),
	.article-content > :global(section),
	.article-content > :global(article) {
		width: 100% !important;
		max-width: 100% !important;
		margin-inline: 0 !important;
	}

	.article-content :global(p) {
		margin: 0 0 1.15rem;
	}

	.article-content :global(h2),
	.article-content :global(h3),
	.article-content :global(h4),
	.article-content :global(h5),
	.article-content :global(h6) {
		scroll-margin-top: 1.25rem;
		color: var(--color-neutral-foreground-1);
	}

	.article-content :global(h2) {
		margin: 2.4rem 0 1rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid var(--color-neutral-stroke-subtle);
		font-size: clamp(1.45rem, 2.5vw, 2rem);
	}

	.article-content :global(h3) {
		margin: 1.9rem 0 0.8rem;
		font-size: clamp(1.2rem, 2vw, 1.55rem);
	}

	.article-content :global(h4) {
		margin: 1.5rem 0 0.65rem;
		font-size: 1.12rem;
	}

	.article-content :global(a) {
		color: var(--color-brand-foreground-strong);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.article-content :global(a:hover) {
		color: #ffb0b7;
	}

	.article-content :global(img) {
		max-width: 100% !important;
		height: auto !important;
		margin: 1.35rem auto;
		border: 1px solid var(--color-neutral-stroke-subtle);
		border-radius: var(--radius-xlarge);
		box-shadow: var(--shadow-4);
	}

	.article-content :global(figure) {
		max-width: 100% !important;
		margin: 1.5rem 0;
	}

	.article-content :global(figcaption) {
		margin-top: 0.55rem;
		color: var(--color-neutral-foreground-3);
		font-size: 0.78rem;
		text-align: center;
	}

	.article-content :global(iframe),
	.article-content :global(video) {
		width: 100% !important;
		max-width: 100% !important;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-xlarge);
		background: #000;
		box-shadow: var(--shadow-4);
	}

	.article-content :global(table) {
		display: block;
		width: 100% !important;
		max-width: 100% !important;
		margin: 1.25rem 0;
		overflow-x: auto;
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-large);
		border-collapse: separate;
		border-spacing: 0;
		background: var(--color-neutral-background-1);
	}

	.article-content :global(th),
	.article-content :global(td) {
		min-width: 130px;
		padding: 0.75rem;
		border-bottom: 1px solid var(--color-neutral-stroke-1);
		border-inline-start: 1px solid var(--color-neutral-stroke-1);
		text-align: start;
	}

	.article-content :global(th) {
		background: var(--color-neutral-background-4);
		color: var(--color-neutral-foreground-1);
		font-weight: 700;
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin: 1rem 0 1.25rem;
		padding-inline-start: 1.5rem;
	}

	.article-content :global(li) {
		margin-block: 0.4rem;
	}

	.article-content :global(blockquote) {
		margin: 1.5rem 0;
		padding: 1rem 1.15rem;
		border: 1px solid var(--color-neutral-stroke-1);
		border-inline-start: 4px solid var(--color-brand-background);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-3);
	}

	.article-content :global(pre) {
		max-width: 100%;
		margin: 1.25rem 0;
		overflow: auto;
	}

	.article-content :global(button) {
		min-height: 36px;
		padding: 0 0.75rem;
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-medium);
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
		cursor: pointer;
	}

	.article-content :global(.separator),
	.article-content :global(.tr-caption-container) {
		width: 100% !important;
		max-width: 100% !important;
		margin-inline: auto !important;
	}

	@media (max-width: 720px) {
		.post-main {
			padding-top: 0.75rem;
		}

		.post-shell {
			width: min(calc(100% - 20px), 1240px);
		}

		.article-header {
			padding: 1.25rem;
			border-radius: var(--radius-xlarge);
		}

		.article-header h1 {
			font-size: clamp(1.7rem, 9vw, 2.55rem);
		}

		.article-description {
			font-size: 0.94rem;
			line-height: 1.8;
		}

		.article-meta {
			align-items: stretch;
			flex-direction: column;
		}

		.meta-item,
		.meta-source {
			width: 100%;
			justify-content: flex-start;
		}

		.article-content {
			margin-top: 0.75rem;
			padding: 1.15rem;
			border-radius: var(--radius-xlarge);
			font-size: 0.97rem;
			line-height: 1.9;
		}

		.article-content :global(h2) {
			margin-top: 2rem;
		}
	}
</style>
