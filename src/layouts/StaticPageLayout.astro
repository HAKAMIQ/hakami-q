---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';

interface Props {
	title: string;
	description: string;
	lang?: 'ar' | 'en';
	dir?: 'rtl' | 'ltr';
	eyebrow?: string;
	alternateHref?: string;
	alternateLabel?: string;
}

const {
	title,
	description,
	lang = 'ar',
	dir = lang === 'ar' ? 'rtl' : 'ltr',
	eyebrow = lang === 'ar' ? 'صفحات HAKAMIQ' : 'HAKAMIQ pages',
	alternateHref,
	alternateLabel,
} = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<BaseHead title={`${title} | HAKAMIQ`} description={description} />
	</head>
	<body>
		<SkipLink label={lang === 'ar' ? 'تخطي إلى المحتوى' : 'Skip to content'} />
		<Header />

		<main id="main-content" tabindex="-1" class="static-main">
			<div class="site-container static-shell">
				<header class="static-hero fui-card">
					<div class="static-hero-copy">
						<nav class="fui-breadcrumb static-breadcrumb" aria-label={lang === 'ar' ? 'مسار الصفحة' : 'Breadcrumb'}>
							<ol>
								<li><a href="/">{lang === 'ar' ? 'الرئيسية' : 'Home'}</a></li>
								<li aria-current="page">{title}</li>
							</ol>
						</nav>
						<span class="eyebrow">{eyebrow}</span>
						<h1>{title}</h1>
						<p>{description}</p>
					</div>

					{alternateHref && alternateLabel && (
						<a class="language-link fui-link" href={alternateHref} hreflang={lang === 'ar' ? 'en' : 'ar'}>{alternateLabel}</a>
					)}
				</header>

				<article class="static-content fluent-rich-text">
					<slot />
				</article>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.static-main { padding-top: var(--spacing-240); }

	.static-shell {
		width: min(calc(100% - (var(--page-gutter) * 2)), 960px);
	}

	.static-hero {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--spacing-240);
		padding: clamp(var(--spacing-200), 3vw, var(--spacing-320));
	}

	.static-hero-copy { min-width: 0; max-width: 760px; }
	.static-breadcrumb { margin-bottom: var(--spacing-160); }

	.eyebrow {
		display: block;
		margin-bottom: var(--spacing-40);
		color: var(--color-brand-foreground);
		font-size: var(--font-size-caption-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-caption-1);
	}

	.static-hero h1 {
		font-size: var(--font-size-title-1);
		line-height: var(--line-height-title-1);
	}

	.static-hero p {
		max-width: 720px;
		margin-top: var(--spacing-100);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-body-1);
		line-height: var(--line-height-body-1);
	}

	.language-link { flex: 0 0 auto; margin-bottom: var(--spacing-20); }

	.static-content {
		margin-top: var(--spacing-160);
		padding: clamp(var(--spacing-200), 3vw, var(--spacing-320));
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-xlarge);
		background: var(--color-neutral-background-2);
		box-shadow: var(--shadow-4);
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-reading);
		line-height: var(--line-height-reading);
	}

	.static-content :global(section + section) {
		margin-top: var(--spacing-320);
		padding-top: var(--spacing-320);
		border-top: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
	}

	.static-content :global(h2) {
		margin: 0 0 var(--spacing-100);
		font-size: var(--font-size-subtitle-1);
		line-height: var(--line-height-subtitle-1);
	}

	.static-content :global(h3) {
		margin: var(--spacing-240) 0 var(--spacing-80);
		font-size: var(--font-size-subtitle-2);
		line-height: var(--line-height-subtitle-2);
	}

	.static-content :global(p) { margin-top: var(--spacing-100); }
	.static-content :global(ul),
	.static-content :global(ol) { margin-top: var(--spacing-120); padding-inline-start: var(--spacing-240); }
	.static-content :global(li + li) { margin-top: var(--spacing-80); }

	.static-content :global(.link-grid) {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-120);
		margin-top: var(--spacing-160);
	}

	.static-content :global(.contact-card) {
		display: grid;
		gap: var(--spacing-20);
		padding: var(--spacing-160);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-1);
		color: var(--color-neutral-foreground-1);
		text-decoration: none;
		transition: background var(--motion-duration-control) var(--curve-easy-ease), border-color var(--motion-duration-control) var(--curve-easy-ease);
	}

	.static-content :global(.contact-card:hover),
	.static-content :global(.contact-card:focus-visible) {
		border-color: var(--color-neutral-stroke-1-hover);
		background: var(--color-neutral-background-1-hover);
	}

	.static-content :global(.contact-card strong) { font-size: var(--font-size-body-1); line-height: var(--line-height-body-1); }
	.static-content :global(.contact-card span) { color: var(--color-neutral-foreground-3); font-size: var(--font-size-caption-1); line-height: var(--line-height-caption-1); }

	@media (max-width: 760px) {
		.static-hero { align-items: flex-start; flex-direction: column; gap: var(--spacing-160); }
		.static-content :global(.link-grid) { grid-template-columns: 1fr; }
	}

	@media (max-width: 639px) {
		.static-main { padding-top: var(--spacing-120); }
		.static-hero,
		.static-content { padding: var(--spacing-160); }
		.static-hero h1 { font-size: var(--font-size-title-2); line-height: var(--line-height-title-2); }
	}
</style>
