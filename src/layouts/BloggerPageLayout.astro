---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';

interface Props {
	title: string;
	description: string;
	lang: 'ar' | 'en';
	dir: 'rtl' | 'ltr';
	content: string;
}

const { title, description, lang, dir, content } = Astro.props;

function decodeEntities(value: string) {
	return value
		.replace(/&amp;/gi, '&')
		.replace(/&lt;/gi, '<')
		.replace(/&gt;/gi, '>')
		.replace(/&quot;/gi, '"')
		.replace(/&#39;|&apos;/gi, "'")
		.replace(/&#(\d+);/g, (_, code) => String.fromCodePoint(Number(code)))
		.replace(/&#x([\da-f]+);/gi, (_, code) => String.fromCodePoint(Number.parseInt(code, 16)));
}

function escapeAttribute(value: string) {
	return value
		.replace(/&/g, '&amp;')
		.replace(/"/g, '&quot;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;');
}

function normalizeImportedPageMarkup(html: string, pageTitle: string, language: 'ar' | 'en') {
	let result = html;

	// Static pages already have one page-level main and H1 in this layout.
	// Preserve imported content while preventing nested landmarks/duplicate H1s.
	result = result
		.replace(/<main\b([^>]*)>/gi, '<div$1>')
		.replace(/<\/main>/gi, '</div>')
		.replace(/<h1\b([^>]*)>/gi, '<h2$1>')
		.replace(/<\/h1>/gi, '</h2>');

	result = result.replace(/<img\b[^>]*>/gi, (tag) => {
		let normalized = tag;
		if (!/\balt\s*=/i.test(normalized)) {
			const titleAttribute = normalized.match(/\btitle\s*=\s*["']([^"']+)["']/i)?.[1];
			const fallback = titleAttribute
				? decodeEntities(titleAttribute)
				: language === 'ar'
					? `صورة توضيحية ضمن صفحة ${pageTitle}`
					: `Illustration for ${pageTitle}`;
			normalized = normalized.replace(/^<img\b/i, `<img alt="${escapeAttribute(fallback)}"`);
		}
		if (!/\bloading\s*=/i.test(normalized)) normalized = normalized.replace(/^<img\b/i, '<img loading="lazy"');
		if (!/\bdecoding\s*=/i.test(normalized)) normalized = normalized.replace(/^<img\b/i, '<img decoding="async"');
		return normalized;
	});

	result = result.replace(/<a\b[^>]*\btarget\s*=\s*["']_blank["'][^>]*>/gi, (tag) => {
		const relMatch = tag.match(/\brel\s*=\s*(["'])([^"']*)\1/i);
		if (!relMatch) return tag.replace(/^<a\b/i, '<a rel="noopener noreferrer"');
		const tokens = new Set(relMatch[2].split(/\s+/).filter(Boolean).map((token) => token.toLowerCase()));
		tokens.add('noopener');
		tokens.add('noreferrer');
		return tag.replace(relMatch[0], `rel=${relMatch[1]}${[...tokens].join(' ')}${relMatch[1]}`);
	});

	return result;
}

const renderedContent = normalizeImportedPageMarkup(content, title, lang);
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<BaseHead title={`${title} | HAKAMIQ`} description={description} />
	</head>
	<body>
		<SkipLink label={lang === 'ar' ? 'تخطي إلى المحتوى' : 'Skip to content'} />
		<Header />

		<main id="main-content" tabindex="-1" class="blogger-page-shell">
			<div class="site-container blogger-page-container">
				<header class="blogger-page-header fui-card">
					<nav class="fui-breadcrumb" aria-label={lang === 'ar' ? 'مسار الصفحة' : 'Breadcrumb'}>
						<ol>
							<li><a href="/">{lang === 'ar' ? 'الرئيسية' : 'Home'}</a></li>
							<li aria-current="page">{title}</li>
						</ol>
					</nav>
					<h1>{title}</h1>
					{description && <p>{description}</p>}
				</header>

				<article class="blogger-page-content fluent-rich-text" set:html={renderedContent} />
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.blogger-page-shell { padding-top: var(--spacing-240); }

	.blogger-page-container {
		width: min(calc(100% - (var(--page-gutter) * 2)), 960px);
	}

	.blogger-page-header {
		padding: clamp(var(--spacing-200), 3vw, var(--spacing-320));
	}

	.blogger-page-header .fui-breadcrumb { margin-bottom: var(--spacing-160); }

	.blogger-page-header h1 {
		font-size: var(--font-size-title-1);
		line-height: var(--line-height-title-1);
	}

	.blogger-page-header p {
		max-width: 760px;
		margin-top: var(--spacing-100);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-body-1);
		line-height: var(--line-height-body-1);
	}

	.blogger-page-content {
		min-width: 0;
		margin-top: var(--spacing-160);
		padding: clamp(var(--spacing-200), 3vw, var(--spacing-320));
		overflow: hidden;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-xlarge);
		background: var(--color-neutral-background-2);
		box-shadow: var(--shadow-4);
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-reading);
		line-height: var(--line-height-reading);
	}

	.blogger-page-content :global(h2) {
		margin-block: var(--spacing-320) var(--spacing-120);
		font-size: var(--font-size-title-3) !important;
		line-height: var(--line-height-title-3) !important;
	}

	.blogger-page-content :global(h3) {
		margin-block: var(--spacing-240) var(--spacing-100);
		font-size: var(--font-size-subtitle-1) !important;
		line-height: var(--line-height-subtitle-1) !important;
	}

	.blogger-page-content :global(h4) {
		margin-block: var(--spacing-200) var(--spacing-80);
		font-size: var(--font-size-subtitle-2) !important;
		line-height: var(--line-height-subtitle-2) !important;
	}

	.blogger-page-content :global(p) { margin-block: 0 var(--spacing-160); }
	.blogger-page-content :global(table) { max-width: 100%; }
	.blogger-page-content :global(a) { overflow-wrap: anywhere; }

	@media (max-width: 639px) {
		.blogger-page-shell { padding-top: var(--spacing-120); }
		.blogger-page-header,
		.blogger-page-content { padding: var(--spacing-160); }
		.blogger-page-header h1 { font-size: var(--font-size-title-2); line-height: var(--line-height-title-2); }
	}
</style>
