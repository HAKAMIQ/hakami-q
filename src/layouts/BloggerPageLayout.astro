---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	lang: 'ar' | 'en';
	dir: 'rtl' | 'ltr';
	content: string;
}

const {
	title,
	description,
	lang,
	dir,
	content,
} = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<BaseHead title={`${title} | HAKAMIQ`} description={description} />
	</head>
	<body>
		<Header />

		<main class="blogger-page-shell">
			<div class="site-container blogger-page-container">
				<article class="blogger-page-content" set:html={content} />
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.blogger-page-shell {
		padding: clamp(0.75rem, 2vw, 1.5rem) 0 0;
	}

	.blogger-page-container {
		width: min(calc(100% - 32px), 1080px);
	}

	.blogger-page-content {
		min-width: 0;
		overflow: hidden;
	}

	.blogger-page-content :global(img),
	.blogger-page-content :global(video),
	.blogger-page-content :global(iframe) {
		max-width: 100%;
	}

	.blogger-page-content :global(img) {
		height: auto;
	}

	.blogger-page-content :global(table) {
		max-width: 100%;
	}

	.blogger-page-content :global(a) {
		overflow-wrap: anywhere;
	}

	@media (max-width: 700px) {
		.blogger-page-container {
			width: min(calc(100% - 20px), 1080px);
		}
	}
</style>
