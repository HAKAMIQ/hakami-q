---
import { SITE_TITLE } from '../consts';

type MenuItem = {
	label: string;
	slug: string;
	children?: MenuItem[];
	openDirection?: 'start' | 'end';
};

type MenuGroup = {
	label: string;
	slug: string;
	tone: string;
	items?: MenuItem[];
};

const categoryHref = (slug: string) => `/blog?category=${encodeURIComponent(slug)}`;

const menuGroups: MenuGroup[] = [
	{
		label: 'NINTENDO',
		slug: 'nintendo',
		tone: 'nintendo',
		items: [
			{ label: 'Nintendo Switch', slug: 'nintendo-switch' },
			{ label: 'Wii U', slug: 'wii-u' },
			{ label: 'Wii', slug: 'wii' },
			{ label: 'GameCube - GCN', slug: 'gamecube' },
			{ label: 'Nintendo 64 - N64', slug: 'n64' },
			{ label: 'SNES', slug: 'snes' },
			{ label: 'NES', slug: 'nes' },
			{
				label: 'Nintendo Handhelds',
				slug: 'nintendo-handhelds',
				openDirection: 'end',
				children: [
					{ label: 'Nintendo 3DS', slug: 'nintendo-3ds' },
					{ label: 'Nintendo DS - NDS', slug: 'nintendo-ds' },
					{ label: 'Game Boy Advance - GBA', slug: 'gba' },
					{ label: 'Game Boy Color - GBC', slug: 'gbc' },
					{ label: 'Game Boy - GB', slug: 'game-boy' },
					{ label: 'Virtual Boy - VB', slug: 'virtual-boy' },
				],
			},
		],
	},
	{
		label: 'PLAYSTATION',
		slug: 'playstation',
		tone: 'playstation',
		items: [
			{ label: 'PlayStation 1 - PS1', slug: 'ps1' },
			{ label: 'PlayStation 2 - PS2', slug: 'ps2' },
			{ label: 'PlayStation 3 - PS3', slug: 'ps3' },
			{ label: 'PlayStation 4 - PS4', slug: 'ps4' },
			{ label: 'PlayStation 5 - PS5', slug: 'ps5' },
			{
				label: 'PlayStation Handhelds',
				slug: 'playstation-handhelds',
				openDirection: 'end',
				children: [
					{ label: 'PlayStation Portable - PSP', slug: 'psp' },
					{ label: 'PlayStation Vita - PS Vita', slug: 'ps-vita' },
				],
			},
		],
	},
	{
		label: 'XBOX',
		slug: 'xbox',
		tone: 'xbox',
		items: [
			{ label: 'Original Xbox - OG Xbox', slug: 'original-xbox' },
			{ label: 'Xbox 360 - X360', slug: 'xbox-360' },
		],
	},
	{
		label: 'SEGA',
		slug: 'sega',
		tone: 'sega',
		items: [
			{ label: 'Mega Drive / Genesis', slug: 'genesis' },
			{ label: 'SEGA Saturn', slug: 'saturn' },
			{ label: 'Dreamcast - DC', slug: 'dreamcast' },
			{ label: 'Game Gear - GG', slug: 'game-gear' },
			{ label: 'SEGA NAOMI', slug: 'naomi' },
			{ label: 'SEGA Pico', slug: 'pico' },
			{ label: 'Advanced Pico Beena', slug: 'beena' },
		],
	},
	{
		label: 'OTHER CONSOLES',
		slug: 'other-consoles',
		tone: 'other',
		items: [
			{
				label: 'Atari',
				slug: 'atari',
				openDirection: 'start',
				children: [
					{ label: 'Atari 2600', slug: 'atari-2600' },
					{ label: 'Atari 5200', slug: 'atari-5200' },
					{ label: 'Atari 7800', slug: 'atari-7800' },
					{ label: 'Atari 800', slug: 'atari-800' },
				],
			},
			{
				label: 'Commodore',
				slug: 'commodore',
				openDirection: 'start',
				children: [
					{ label: 'Commodore 64 - C64', slug: 'commodore-64' },
					{ label: 'Amiga', slug: 'amiga' },
				],
			},
			{ label: 'Android Emulators', slug: 'android-emulators' },
			{ label: 'Guides & Articles', slug: 'guides-articles' },
		],
	},
	{
		label: 'MULTI-SYSTEM',
		slug: 'multi-system',
		tone: 'multi',
		items: [
			{ label: 'RetroArch', slug: 'retroarch' },
			{ label: 'RetroBat', slug: 'retrobat' },
			{ label: 'LaunchBox', slug: 'launchbox' },
		],
	},
	{
		label: 'PC',
		slug: 'pc',
		tone: 'pc',
	},
];
---

<header class="site-header">
	<div class="utility-bar">
		<div class="site-container utility-inner">
			<nav class="utility-links" aria-label="روابط المعلومات">
				<a href="/privacy">سياسة الخصوصية</a>
				<a href="/terms">اتفاقية الاستخدام</a>
				<a href="/contact">اتصل بنا</a>
			</nav>

			<nav class="social-links" aria-label="الشبكات الاجتماعية" dir="ltr">
				<a href="https://www.youtube.com/@HAKAMIQ" target="_blank" rel="noopener noreferrer">YouTube</a>
				<a href="https://discord.gg/WqgRrmAKpC" target="_blank" rel="noopener noreferrer">Discord</a>
				<a href="https://t.me/hakamiq0" target="_blank" rel="noopener noreferrer">Telegram</a>
			</nav>
		</div>
	</div>

	<div class="brand-surface">
		<div class="site-container brand-inner">
			<a class="brand" href="/" aria-label="الصفحة الرئيسية">
				<span class="brand-mark" aria-hidden="true">H</span>
				<span class="brand-copy">
					<strong>{SITE_TITLE}</strong>
					<small>دليل المحاكيات والألعاب</small>
				</span>
			</a>

			<p class="brand-description">
				شروحات عربية عملية لتشغيل المحاكيات وإعداد الألعاب وحل المشاكل على الكمبيوتر
			</p>

			<a class="brand-action" href="/blog">
				<span>تصفح المقالات</span>
				<svg viewBox="0 0 20 20" aria-hidden="true">
					<path d="M4 10h12M11 5l5 5-5 5"></path>
				</svg>
			</a>
		</div>
	</div>

	<nav class="main-nav" aria-label="أقسام HAKAMIQ">
		<div class="site-container nav-inner">
			<button
				class="mobile-menu-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="primary-menu"
			>
				<span>الأقسام</span>
				<svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>

			<div class="menu-bar" id="primary-menu" dir="ltr">
				<a class="home-menu-link" href="/" aria-label="الصفحة الرئيسية">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="m3 11 9-8 9 8"></path>
						<path d="M5 10v10h14V10"></path>
						<path d="M9 20v-6h6v6"></path>
					</svg>
				</a>

				{
					menuGroups.map((group) =>
						group.items ? (
							<details
								class:list={['menu-group', `tone-${group.tone}`]}
								data-menu-group
							>
								<summary>
									<span>{group.label}</span>
									<svg class="menu-chevron" viewBox="0 0 20 20" aria-hidden="true">
										<path d="m6 8 4 4 4-4"></path>
									</svg>
								</summary>

								<div class="menu-panel">
									<div class="menu-list">
										{
											group.items.map((item) =>
												item.children ? (
													<details
														class:list={[
															'submenu-group',
															item.openDirection === 'end'
																? 'open-end'
																: 'open-start',
														]}
														data-submenu-group
													>
														<summary>
															<span>{item.label}</span>
															<svg viewBox="0 0 20 20" aria-hidden="true">
																<path d="m8 5 5 5-5 5"></path>
															</svg>
														</summary>

														<div class="submenu-panel">
															{
																item.children.map((child) => (
																	<a
																		href={categoryHref(child.slug)}
																		data-category={child.slug}
																	>
																		{child.label}
																	</a>
																))
															}
														</div>
													</details>
												) : (
													<a
														href={categoryHref(item.slug)}
														data-category={item.slug}
													>
														{item.label}
													</a>
												),
											)
										}
									</div>
								</div>
							</details>
						) : (
							<a
								class:list={['menu-direct', `tone-${group.tone}`]}
								href={categoryHref(group.slug)}
								data-category={group.slug}
							>
								{group.label}
							</a>
						),
					)
				}
			</div>
		</div>
	</nav>
</header>

<script>
	document.documentElement.classList.add('js-nav');

	const initializeHeader = () => {
		const header = document.querySelector<HTMLElement>('.site-header');
		if (!header || header.dataset.initialized === 'true') return;

		header.dataset.initialized = 'true';

		const menuToggle = header.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
		const topLevelMenus = Array.from(
			header.querySelectorAll<HTMLDetailsElement>('[data-menu-group]'),
		);
		const nestedMenus = Array.from(
			header.querySelectorAll<HTMLDetailsElement>('[data-submenu-group]'),
		);
		const menuLinks = Array.from(header.querySelectorAll<HTMLAnchorElement>('.menu-bar a'));
		const desktopMedia = window.matchMedia('(min-width: 961px)');

		const closeNestedMenus = (except?: HTMLDetailsElement) => {
			for (const menu of nestedMenus) {
				if (menu !== except) menu.open = false;
			}
		};

		const closeTopLevelMenus = (except?: HTMLDetailsElement) => {
			for (const menu of topLevelMenus) {
				if (menu !== except) menu.open = false;
			}
		};

		const setMobileMenu = (open: boolean) => {
			header.classList.toggle('mobile-open', open);
			menuToggle?.setAttribute('aria-expanded', String(open));

			if (!open) {
				closeNestedMenus();
				closeTopLevelMenus();
			}
		};

		for (const menu of topLevelMenus) {
			const summary = menu.querySelector<HTMLElement>(':scope > summary');

			menu.addEventListener('toggle', () => {
				if (!menu.open) return;
				closeTopLevelMenus(menu);
				closeNestedMenus();
			});

			menu.addEventListener('mouseenter', () => {
				if (!desktopMedia.matches) return;
				closeTopLevelMenus(menu);
				closeNestedMenus();
				menu.open = true;
			});

			menu.addEventListener('mouseleave', () => {
				if (!desktopMedia.matches) return;
				menu.open = false;
				for (const nested of menu.querySelectorAll<HTMLDetailsElement>('[data-submenu-group]')) {
					nested.open = false;
				}
			});

			summary?.addEventListener('click', (event) => {
				if (desktopMedia.matches && event.detail > 0) event.preventDefault();
			});
		}

		for (const menu of nestedMenus) {
			const summary = menu.querySelector<HTMLElement>(':scope > summary');

			menu.addEventListener('toggle', () => {
				if (menu.open) closeNestedMenus(menu);
			});

			menu.addEventListener('mouseenter', () => {
				if (!desktopMedia.matches) return;
				closeNestedMenus(menu);
				menu.open = true;
			});

			menu.addEventListener('mouseleave', () => {
				if (desktopMedia.matches) menu.open = false;
			});

			summary?.addEventListener('click', (event) => {
				if (desktopMedia.matches && event.detail > 0) event.preventDefault();
			});
		}

		menuToggle?.addEventListener('click', () => {
			setMobileMenu(!header.classList.contains('mobile-open'));
		});

		for (const link of menuLinks) {
			link.addEventListener('click', () => {
				if (!desktopMedia.matches) setMobileMenu(false);
			});
		}

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Node) || header.contains(target)) return;

			closeNestedMenus();
			closeTopLevelMenus();
			if (!desktopMedia.matches) setMobileMenu(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;

			closeNestedMenus();
			closeTopLevelMenus();
			setMobileMenu(false);
			menuToggle?.focus();
		});

		desktopMedia.addEventListener('change', () => {
			setMobileMenu(false);
		});

		const selectedCategory = new URLSearchParams(window.location.search)
			.get('category')
			?.trim()
			.toLowerCase();

		if (selectedCategory) {
			for (const link of header.querySelectorAll<HTMLAnchorElement>('[data-category]')) {
				if (link.dataset.category?.toLowerCase() !== selectedCategory) continue;

				link.classList.add('is-active');
				link.closest<HTMLDetailsElement>('[data-menu-group]')
					?.querySelector<HTMLElement>(':scope > summary')
					?.classList.add('has-active-child');
			}
		}
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeHeader, { once: true });
	} else {
		initializeHeader();
	}

	document.addEventListener('astro:page-load', initializeHeader);
</script>

<style>
	.site-header {
		position: relative;
		z-index: 1000;
		border-bottom: 1px solid var(--color-neutral-stroke-subtle);
		background: rgba(17, 19, 21, 0.96);
		box-shadow: var(--shadow-4);
	}

	.utility-bar {
		border-bottom: 1px solid var(--color-neutral-stroke-subtle);
		background: #0c0e10;
	}

	.utility-inner,
	.brand-inner,
	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.utility-inner {
		min-height: 36px;
		color: var(--color-neutral-foreground-3);
		font-size: 0.76rem;
	}

	.utility-links,
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.utility-bar a {
		padding: 0.25rem 0.55rem;
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		text-decoration: none;
		transition:
			background var(--duration-fast) var(--curve-easy-ease),
			color var(--duration-fast) var(--curve-easy-ease);
	}

	.utility-bar a:hover {
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
	}

	.brand-surface {
		background:
			linear-gradient(110deg, rgba(232, 17, 35, 0.08), transparent 36%),
			var(--color-neutral-background-2);
	}

	.brand-inner {
		min-height: 88px;
		padding-block: 0.85rem;
	}

	.brand {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.8rem;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 52px;
		height: 52px;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: var(--radius-xlarge);
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.16), transparent 46%),
			var(--color-brand-background);
		box-shadow: 0 8px 24px rgba(232, 17, 35, 0.28);
		color: #fff;
		font-size: 1.65rem;
		font-weight: 850;
	}

	.brand-copy {
		display: grid;
		gap: 0.1rem;
	}

	.brand-copy strong {
		color: var(--color-neutral-foreground-1);
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: 0.045em;
	}

	.brand-copy small {
		color: var(--color-neutral-foreground-3);
		font-size: 0.76rem;
	}

	.brand-description {
		max-width: 560px;
		color: var(--color-neutral-foreground-3);
		font-size: 0.9rem;
		text-align: center;
	}

	.brand-action {
		display: inline-flex;
		min-height: 38px;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		padding: 0 0.85rem;
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-medium);
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
		font-size: 0.78rem;
		font-weight: 700;
		text-decoration: none;
		box-shadow: var(--shadow-2);
		transition:
			background var(--duration-fast) var(--curve-easy-ease),
			border-color var(--duration-fast) var(--curve-easy-ease);
	}

	.brand-action:hover {
		border-color: var(--color-neutral-stroke-2);
		background: var(--color-neutral-background-4);
	}

	.brand-action svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
		transform: scaleX(-1);
	}

	.main-nav {
		position: relative;
		z-index: 20;
		border-top: 1px solid var(--color-neutral-stroke-subtle);
		background: rgba(23, 25, 28, 0.94);
		backdrop-filter: blur(18px) saturate(1.08);
	}

	.nav-inner {
		position: relative;
		min-height: 54px;
	}

	.menu-bar {
		display: flex;
		width: 100%;
		align-items: center;
		gap: 4px;
		overflow: visible;
	}

	.home-menu-link,
	.menu-direct,
	.menu-group > summary {
		display: inline-flex;
		min-height: 42px;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		box-sizing: border-box;
		border: 1px solid transparent;
		border-radius: var(--radius-medium);
		background: transparent;
		color: var(--color-neutral-foreground-2);
		font-family: inherit;
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background var(--duration-fast) var(--curve-easy-ease),
			border-color var(--duration-fast) var(--curve-easy-ease),
			color var(--duration-fast) var(--curve-easy-ease);
	}

	.home-menu-link {
		width: 44px;
		padding: 0;
	}

	.home-menu-link svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.menu-direct,
	.menu-group > summary {
		padding-inline: 0.78rem;
	}

	.menu-group {
		--menu-accent: var(--color-brand-foreground);
		position: relative;
		flex: 0 0 auto;
	}

	.menu-group.tone-nintendo {
		--menu-accent: #ff5b67;
	}

	.menu-group.tone-playstation {
		--menu-accent: #68a8ff;
	}

	.menu-group.tone-xbox {
		--menu-accent: #61cf72;
	}

	.menu-group.tone-sega {
		--menu-accent: #65b4ff;
	}

	.menu-group.tone-other {
		--menu-accent: #ff9d5c;
	}

	.menu-group.tone-multi {
		--menu-accent: #b699ff;
	}

	.menu-direct.tone-pc {
		--menu-accent: #b699ff;
	}

	.menu-group > summary,
	.submenu-group > summary {
		list-style: none;
		user-select: none;
	}

	.menu-group > summary::-webkit-details-marker,
	.submenu-group > summary::-webkit-details-marker {
		display: none;
	}

	.menu-chevron {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
		transition: transform var(--duration-fast) var(--curve-easy-ease);
	}

	.menu-group[open] > summary .menu-chevron {
		transform: rotate(180deg);
	}

	.home-menu-link:hover,
	.home-menu-link:focus-visible,
	.menu-direct:hover,
	.menu-direct:focus-visible,
	.menu-direct.is-active,
	.menu-group[open] > summary,
	.menu-group > summary:hover,
	.menu-group > summary:focus-visible,
	.menu-group > summary.has-active-child {
		border-color: var(--color-neutral-stroke-1);
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
		outline: none;
	}

	.menu-direct.is-active,
	.menu-group > summary.has-active-child {
		box-shadow: inset 0 -2px var(--menu-accent);
	}

	.menu-panel,
	.submenu-panel {
		direction: ltr;
		text-align: left;
	}

	.menu-panel {
		position: absolute;
		top: calc(100% + 7px);
		left: 0;
		width: 270px;
		padding: 8px;
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-large);
		background: rgba(31, 34, 38, 0.98);
		box-shadow: var(--shadow-64);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px) scale(0.985);
		transform-origin: top left;
		pointer-events: none;
		transition:
			opacity var(--duration-fast) var(--curve-easy-ease),
			transform var(--duration-fast) var(--curve-easy-ease),
			visibility var(--duration-fast) var(--curve-easy-ease);
		z-index: 200;
	}

	.tone-other > .menu-panel,
	.tone-multi > .menu-panel {
		right: 0;
		left: auto;
		transform-origin: top right;
	}

	.menu-group[open] > .menu-panel,
	.menu-group:focus-within > .menu-panel {
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
		pointer-events: auto;
	}

	.menu-list {
		display: grid;
		gap: 2px;
	}

	.menu-list > a,
	.submenu-group > summary,
	.submenu-panel > a {
		position: relative;
		display: flex;
		min-height: 40px;
		align-items: center;
		box-sizing: border-box;
		border: 1px solid transparent;
