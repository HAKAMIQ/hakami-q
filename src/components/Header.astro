	label: string;
	slug: string;
	children?: MenuItem[];
};

type MenuGroup = {
	label: string;
	slug: string;
	items?: MenuItem[];
};

const categoryHref = (slug: string) => `/blog?category=${encodeURIComponent(slug)}`;

const menuGroups: MenuGroup[] = [
