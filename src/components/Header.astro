---

<header class="site-header" data-site-header>
	<div class="utility-bar">
		<div class="site-container utility-inner">
			<p class="hq-welcome">
				<span>مرحباً بك في <strong>HAKAMIQ</strong></span>
				<span class="hq-welcome-divider" aria-hidden="true"></span>
				<span>وجهتك العربية لعالم الألعاب والمحاكاة</span>
			</p>

			<nav class="utility-links" aria-label="أدوات الموقع">
				<button class="utility-action" type="button" data-header-search>
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="5.5"></circle><path d="m15 15 4.5 4.5"></path></svg>
					<span>بحث</span>
				</button>
				<span class="utility-status" title="الموقع يستخدم المظهر الداكن">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 15.5A7.5 7.5 0 0 1 8.5 5 7.5 7.5 0 1 0 19 15.5Z"></path></svg>
					<span>المظهر الداكن</span>
				</span>
				<a class="utility-action" href="/rss.xml" aria-label="خلاصة التحديثات RSS">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5a14 14 0 0 1 14 14M5 10a9 9 0 0 1 9 9"></path><circle cx="6" cy="18" r="1"></circle></svg>
					<span>التحديثات</span>
				</a>
				<a class="utility-action" href="https://discord.gg/WqgRrmAKpC" target="_blank" rel="noopener noreferrer" aria-label="مجتمع HAKAMIQ على Discord، يفتح في علامة تبويب جديدة">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.2 7.2a11 11 0 0 1 7.6 0M7 17c3.3 2 6.7 2 10 0M6.2 8.2C4.7 10.3 4 12.8 4 15.5c1.7 1.4 3.5 2.3 5.4 2.7l1-1.4M17.8 8.2c1.5 2.1 2.2 4.6 2.2 7.3-1.7 1.4-3.5 2.3-5.4 2.7l-1-1.4"></path><circle cx="9" cy="13" r="1"></circle><circle cx="15" cy="13" r="1"></circle></svg>
					<span>Discord</span>
				</a>
			</nav>
		</div>
	</div>

	<nav class="main-nav" aria-label="أقسام HAKAMIQ">
		<div class="site-container nav-inner">
			<div class="hq-nav-shell">
				<a class="brand" href="/" aria-label="HAKAMIQ - الصفحة الرئيسية">
					<span class="brand-word">HAKAMIQ</span>
					<svg class="brand-gamepad" viewBox="0 0 48 32" aria-hidden="true">
						<path d="M13 8h22c4 0 7 3 8 7l2 8c.6 2.5-2 4.5-4 2.8l-6-5.3H13l-6 5.3C5 27.5 2.4 25.5 3 23l2-8c1-4 4-7 8-7Z"></path>
						<path d="M13 13v7m-3.5-3.5h7M33.5 14.5h.01M37 18h.01"></path>
					</svg>
				</a>

				<button class="mobile-menu-toggle" type="button" aria-label="الأقسام" aria-expanded="false" aria-controls="primary-menu">
					<span>الأقسام</span>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
				</button>

				<div class="menu-bar" id="primary-menu">
					<a class="home-menu-link" href="/" aria-label="الصفحة الرئيسية" title="الصفحة الرئيسية">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path></svg>
						<span class="home-menu-text">الرئيسية</span>
					</a>

					{menuGroups.map((group) => {
						const panelId = `nav-panel-${group.slug}`;
						return group.items ? (
							<div class="menu-group" data-menu-group>
								<button class="menu-trigger" type="button" aria-expanded="false" aria-controls={panelId}>
									<svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={group.iconPath}></path></svg>
									<span>{group.label}</span>
									<svg class="menu-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4"></path></svg>
								</button>

								<div class="menu-panel" id={panelId} data-menu-panel>
									<div class="menu-surface" aria-label={group.label}>
										<div class="menu-list">
											{group.items.map((item) => {
												const submenuId = `nav-submenu-${group.slug}-${item.slug}`;
												return item.children ? (
													<div class="submenu-group" data-submenu-group>
														<button class="submenu-trigger" type="button" aria-expanded="false" aria-controls={submenuId} aria-label={`عرض ${item.label}`}>
															<span>{item.label}</span>
															<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6"></path></svg>
														</button>
														<div class="submenu-panel" id={submenuId} data-submenu-panel>
															<div class="submenu-surface" aria-label={item.label}>
																{item.children.map((child) => (
																	<a href={categoryHref(child.slug)} data-category={child.slug}>{child.label}</a>
																))}
															</div>
														</div>
													</div>
												) : (
													<a href={categoryHref(item.slug)} data-category={item.slug}>{item.label}</a>
												);
											})}
										</div>
									</div>
								</div>
							</div>
						) : (
							<a class="menu-direct" href={categoryHref(group.slug)} data-category={group.slug}>
								<svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={group.iconPath}></path></svg>
								<span>{group.label}</span>
							</a>
						);
					})}
				</div>
			</div>
		</div>
	</nav>
</header>

<script>
	const initializeHeader = () => {
		const header = document.querySelector<HTMLElement>('[data-site-header]');
		if (!header || header.dataset.initialized === 'true') return;
		header.dataset.initialized = 'true';

		const desktop = window.matchMedia('(min-width: 1024px)');
		const menuToggle = header.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
		const topMenus = Array.from(header.querySelectorAll<HTMLElement>('[data-menu-group]'));
		const nestedMenus = Array.from(header.querySelectorAll<HTMLElement>('[data-submenu-group]'));
		const timers = new WeakMap<HTMLElement, number>();
		const closeDelay = 140;
		const viewportGap = 12;

		const clearTimer = (menu: HTMLElement) => {
			const timer = timers.get(menu);
			if (timer !== undefined) window.clearTimeout(timer);
			timers.delete(menu);
		};

		const setOpen = (menu: HTMLElement, open: boolean) => {
			clearTimer(menu);
			menu.classList.toggle('is-open', open);
			menu.querySelector<HTMLButtonElement>(':scope > button')?.setAttribute('aria-expanded', String(open));
		};

		const closeNestedMenus = (except?: HTMLElement) => {
			for (const menu of nestedMenus) if (menu !== except) setOpen(menu, false);
		};

		const closeTopMenus = (except?: HTMLElement) => {
			for (const menu of topMenus) if (menu !== except) setOpen(menu, false);
		};

		const positionTopPanel = (menu: HTMLElement) => {
			if (!desktop.matches) return;
			const panel = menu.querySelector<HTMLElement>(':scope > [data-menu-panel]');
			if (!panel) return;
			panel.classList.remove('align-end');
			if (panel.getBoundingClientRect().right > window.innerWidth - viewportGap) panel.classList.add('align-end');
		};

		const positionSubmenu = (menu: HTMLElement) => {
			if (!desktop.matches) return;
			const panel = menu.querySelector<HTMLElement>(':scope > [data-submenu-panel]');
			if (!panel) return;
			panel.classList.remove('open-start');
			if (panel.getBoundingClientRect().right > window.innerWidth - viewportGap) panel.classList.add('open-start');
		};

		const openTopMenu = (menu: HTMLElement) => {
			closeTopMenus(menu);
			closeNestedMenus();
			setOpen(menu, true);
			window.requestAnimationFrame(() => positionTopPanel(menu));
		};

		const openNestedMenu = (menu: HTMLElement) => {
			closeNestedMenus(menu);
			setOpen(menu, true);
			window.requestAnimationFrame(() => positionSubmenu(menu));
		};

		const scheduleClose = (menu: HTMLElement, nested = false) => {
			clearTimer(menu);
			timers.set(menu, window.setTimeout(() => {
				setOpen(menu, false);
				if (!nested) closeNestedMenus();
			}, closeDelay));
		};

		const closeAll = () => {
			header.classList.remove('mobile-open');
			menuToggle?.setAttribute('aria-expanded', 'false');
			closeNestedMenus();
			closeTopMenus();
		};

		for (const menu of topMenus) {
			const trigger = menu.querySelector<HTMLButtonElement>(':scope > .menu-trigger');
			menu.addEventListener('pointerenter', () => {
				if (!desktop.matches) return;
				clearTimer(menu);
				openTopMenu(menu);
			});
			menu.addEventListener('pointerleave', (event) => {
				if (!desktop.matches) return;
				const next = event.relatedTarget;
				if (next instanceof Node && menu.contains(next)) return;
				scheduleClose(menu);
			});
			menu.addEventListener('focusin', () => {
				if (desktop.matches) openTopMenu(menu);
			});
			menu.addEventListener('focusout', () => {
				window.setTimeout(() => {
					if (!menu.contains(document.activeElement)) scheduleClose(menu);
				}, 0);
			});
			trigger?.addEventListener('click', () => {
				const willOpen = !menu.classList.contains('is-open');
				if (willOpen) openTopMenu(menu);
				else {
					setOpen(menu, false);
					closeNestedMenus();
				}
			});
		}

		for (const menu of nestedMenus) {
			const trigger = menu.querySelector<HTMLButtonElement>(':scope > .submenu-trigger');
			trigger?.addEventListener('click', (event) => {
				event.stopPropagation();
				const willOpen = !menu.classList.contains('is-open');
				if (willOpen) openNestedMenu(menu);
				else setOpen(menu, false);
			});
		}

		menuToggle?.addEventListener('click', () => {
			const open = !header.classList.contains('mobile-open');
			header.classList.toggle('mobile-open', open);
			menuToggle.setAttribute('aria-expanded', String(open));
			if (!open) {
				closeNestedMenus();
				closeTopMenus();
			}
		});

		header.querySelector<HTMLButtonElement>('[data-header-search]')?.addEventListener('click', () => {
			const homeSearch = document.querySelector<HTMLInputElement>('#home-search-input');
			if (homeSearch) {
				homeSearch.scrollIntoView({ behavior: 'smooth', block: 'center' });
				window.setTimeout(() => homeSearch.focus(), 240);
				return;
			}
			window.location.href = '/blog';
		});

		header.querySelectorAll<HTMLAnchorElement>('.menu-bar a').forEach((link) => link.addEventListener('click', closeAll));
		document.addEventListener('pointerdown', (event) => {
			if (event.target instanceof Node && !header.contains(event.target)) closeAll();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			const nestedTrigger = header.querySelector<HTMLButtonElement>('.submenu-group.is-open > .submenu-trigger');
			const topTrigger = header.querySelector<HTMLButtonElement>('.menu-group.is-open > .menu-trigger');
			const restoreTarget = nestedTrigger ?? topTrigger ?? (header.classList.contains('mobile-open') ? menuToggle : null);
			closeAll();
			restoreTarget?.focus();
		});
		desktop.addEventListener('change', closeAll);

		if (window.location.pathname === '/') {
			header.querySelector<HTMLAnchorElement>('.home-menu-link')?.setAttribute('aria-current', 'page');
		}

		const selected = new URLSearchParams(window.location.search).get('category')?.trim().toLowerCase();
		if (selected) {
			header.querySelectorAll<HTMLAnchorElement>('[data-category]').forEach((link) => {
				if (link.dataset.category?.toLowerCase() !== selected) return;
				link.classList.add('is-active');
				link.setAttribute('aria-current', 'page');
				link.closest<HTMLElement>('[data-menu-group]')?.querySelector<HTMLElement>(':scope > .menu-trigger')?.classList.add('has-active-child');
			});
		}
	};

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeHeader, { once: true });
	else initializeHeader();
	document.addEventListener('astro:page-load', initializeHeader);
</script>
