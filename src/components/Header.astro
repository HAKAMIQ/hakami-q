---

<header class="site-header" data-site-header>
	<div class="utility-bar">
		<div class="site-container utility-inner">
			<nav class="social-links" aria-label="الشبكات الاجتماعية" dir="ltr">
				<a href="https://www.youtube.com/@HAKAMIQ" target="_blank" rel="noopener noreferrer" aria-label="YouTube، يفتح في علامة تبويب جديدة" title="YouTube — علامة تبويب جديدة">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 8.1a3 3 0 0 0-2.1-2.1C17.1 5.5 12 5.5 12 5.5S6.9 5.5 5.1 6A3 3 0 0 0 3 8.1 31 31 0 0 0 2.5 12 31 31 0 0 0 3 15.9 3 3 0 0 0 5.1 18c1.8.5 6.9.5 6.9.5s5.1 0 6.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-3.9 31 31 0 0 0-.5-3.9Z"></path><path d="m10 9 5 3-5 3Z"></path></svg>
				</a>
				<a href="https://discord.gg/WqgRrmAKpC" target="_blank" rel="noopener noreferrer" aria-label="Discord، يفتح في علامة تبويب جديدة" title="Discord — علامة تبويب جديدة">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.2 7.2a11 11 0 0 1 7.6 0M7 17c3.3 2 6.7 2 10 0M6.2 8.2C4.7 10.3 4 12.8 4 15.5c1.7 1.4 3.5 2.3 5.4 2.7l1-1.4M17.8 8.2c1.5 2.1 2.2 4.6 2.2 7.3-1.7 1.4-3.5 2.3-5.4 2.7l-1-1.4"></path><circle cx="9" cy="13" r="1"></circle><circle cx="15" cy="13" r="1"></circle></svg>
				</a>
				<a href="https://t.me/hakamiq0" target="_blank" rel="noopener noreferrer" aria-label="Telegram، يفتح في علامة تبويب جديدة" title="Telegram — علامة تبويب جديدة">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 4-3.2 15-5.2-3.9-2.7 2.6.4-4.8L18 7.2 8.5 12l-4.2-1.4Z"></path></svg>
				</a>
			</nav>

			<nav class="utility-links" aria-label="روابط سريعة">
				<a href="/blog">المقالات</a>
				<a href="/services">خدمة المحاكيات</a>
				<a href="/about">من نحن</a>
				<a href="/contact">اتصل بنا</a>
			</nav>
		</div>
	</div>

	<div class="brand-surface">
		<div class="site-container brand-inner">
			<a class="brand" href="/" aria-label="HAKAMIQ - الصفحة الرئيسية">
				<img src="/hakamiq-logo.svg" width="500" height="241" alt="HAKAMIQ" />
			</a>

			<p class="brand-description">شروحات عربية عملية لتشغيل المحاكيات وإعداد الألعاب وحل المشاكل على الكمبيوتر وأجهزة الألعاب</p>

			<button class="mobile-menu-toggle fui-button fui-button--secondary" type="button" aria-label="الأقسام" aria-expanded="false" aria-controls="primary-menu">
				<span>الأقسام</span>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			</button>
		</div>
	</div>

	<nav class="main-nav" aria-label="أقسام HAKAMIQ">
		<div class="site-container nav-inner">
			<div class="menu-bar" id="primary-menu" dir="ltr">
				<a class="home-menu-link" href="/" aria-label="الصفحة الرئيسية" title="الصفحة الرئيسية">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path></svg>
					<span class="home-menu-text">الرئيسية</span>
				</a>

				{menuGroups.map((group) => {
					const panelId = `nav-panel-${group.slug}`;
					return group.items ? (
						<div class="menu-group" data-menu-group>
							<a class="menu-parent-link" href={categoryHref(group.slug)} data-category={group.slug}>{group.label}</a>
							<button class="menu-trigger" type="button" aria-label={`فتح قائمة ${group.label}`} aria-expanded="false" aria-controls={panelId}>
								<svg class="menu-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4"></path></svg>
							</button>

							<div class="menu-panel" id={panelId} data-menu-panel>
								<div class="menu-surface" aria-label={group.label}>
									<div class="menu-list">
										{group.items.map((item) => {
											const submenuId = `nav-submenu-${group.slug}-${item.slug}`;
											return item.children ? (
												<div class="submenu-group" data-submenu-group>
													<a class="submenu-parent-link" href={categoryHref(item.slug)} data-category={item.slug}>{item.label}</a>
													<button class="submenu-trigger" type="button" aria-expanded="false" aria-controls={submenuId} aria-label={`فتح قائمة ${item.label}`}>
														<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6"></path></svg>
													</button>

													<div class="submenu-panel" id={submenuId} data-submenu-panel>
														<div class="submenu-surface" aria-label={item.label}>
															{item.children.map((child) => (
																<a href={categoryHref(child.slug)} data-category={child.slug}>{child.label}</a>
															))}
														</div>
													</div>
												</div>
											) : (
												<a href={categoryHref(item.slug)} data-category={item.slug}>{item.label}</a>
											);
										})}
									</div>
								</div>
							</div>
						</div>
					) : (
						<a class="menu-direct" href={categoryHref(group.slug)} data-category={group.slug}>{group.label}</a>
					);
				})}
			</div>
		</div>
	</nav>
</header>

<script>
	const initializeHeader = () => {
		const header = document.querySelector<HTMLElement>('[data-site-header]');
		if (!header || header.dataset.initialized === 'true') return;
		header.dataset.initialized = 'true';

		const desktop = window.matchMedia('(min-width: 1024px)');
		const menuToggle = header.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
		const topMenus = Array.from(header.querySelectorAll<HTMLElement>('[data-menu-group]'));
		const nestedMenus = Array.from(header.querySelectorAll<HTMLElement>('[data-submenu-group]'));
		const timers = new WeakMap<HTMLElement, number>();
		const closeDelay = 160;
		const viewportGap = 12;

		const clearTimer = (menu: HTMLElement) => {
			const timer = timers.get(menu);
			if (timer !== undefined) window.clearTimeout(timer);
			timers.delete(menu);
		};

		const setOpen = (menu: HTMLElement, open: boolean) => {
			clearTimer(menu);
			menu.classList.toggle('is-open', open);
			menu.querySelector<HTMLButtonElement>(':scope > button')?.setAttribute('aria-expanded', String(open));
		};

		const closeNestedMenus = (except?: HTMLElement) => {
			for (const menu of nestedMenus) if (menu !== except) setOpen(menu, false);
		};

		const closeTopMenus = (except?: HTMLElement) => {
			for (const menu of topMenus) if (menu !== except) setOpen(menu, false);
		};

		const positionTopPanel = (menu: HTMLElement) => {
			if (!desktop.matches) return;
			const panel = menu.querySelector<HTMLElement>(':scope > [data-menu-panel]');
			if (!panel) return;
			panel.classList.remove('align-end');
			if (panel.getBoundingClientRect().right > window.innerWidth - viewportGap) panel.classList.add('align-end');
		};

		const positionSubmenu = (menu: HTMLElement) => {
			if (!desktop.matches) return;
			const panel = menu.querySelector<HTMLElement>(':scope > [data-submenu-panel]');
			if (!panel) return;
			panel.classList.remove('open-start');
			menu.classList.remove('opens-start');
			if (panel.getBoundingClientRect().right > window.innerWidth - viewportGap) {
				panel.classList.add('open-start');
				menu.classList.add('opens-start');
			}
		};

		const openTopMenu = (menu: HTMLElement) => {
			closeTopMenus(menu);
			closeNestedMenus();
			setOpen(menu, true);
			window.requestAnimationFrame(() => positionTopPanel(menu));
		};

		const openNestedMenu = (menu: HTMLElement) => {
			closeNestedMenus(menu);
			setOpen(menu, true);
			window.requestAnimationFrame(() => positionSubmenu(menu));
		};

		const scheduleClose = (menu: HTMLElement, nested = false) => {
			clearTimer(menu);
			timers.set(menu, window.setTimeout(() => {
				setOpen(menu, false);
				if (!nested) closeNestedMenus();
			}, closeDelay));
		};

		const closeAll = () => {
			header.classList.remove('mobile-open');
			menuToggle?.setAttribute('aria-expanded', 'false');
			closeNestedMenus();
			closeTopMenus();
		};

		for (const menu of topMenus) {
			const trigger = menu.querySelector<HTMLButtonElement>(':scope > .menu-trigger');
			menu.addEventListener('pointerenter', () => {
				if (!desktop.matches) return;
				clearTimer(menu);
				openTopMenu(menu);
			});
			menu.addEventListener('pointerleave', (event) => {
				if (!desktop.matches) return;
				const next = event.relatedTarget;
				if (next instanceof Node && menu.contains(next)) return;
				scheduleClose(menu);
			});
			menu.addEventListener('focusin', () => {
				if (desktop.matches) openTopMenu(menu);
			});
			menu.addEventListener('focusout', () => {
				window.setTimeout(() => {
					if (!menu.contains(document.activeElement)) scheduleClose(menu);
				}, 0);
			});
			trigger?.addEventListener('click', () => {
				const willOpen = !menu.classList.contains('is-open');
				if (willOpen) openTopMenu(menu);
				else {
					setOpen(menu, false);
					closeNestedMenus();
				}
			});
		}

		for (const menu of nestedMenus) {
			const trigger = menu.querySelector<HTMLButtonElement>(':scope > .submenu-trigger');
			menu.addEventListener('pointerenter', () => {
				if (!desktop.matches) return;
				clearTimer(menu);
				openNestedMenu(menu);
			});
			menu.addEventListener('pointerleave', (event) => {
				if (!desktop.matches) return;
				const next = event.relatedTarget;
				if (next instanceof Node && menu.contains(next)) return;
				scheduleClose(menu, true);
			});
			menu.addEventListener('focusin', () => {
				if (desktop.matches) openNestedMenu(menu);
			});
			menu.addEventListener('focusout', () => {
				window.setTimeout(() => {
					if (!menu.contains(document.activeElement)) scheduleClose(menu, true);
				}, 0);
			});
			trigger?.addEventListener('click', (event) => {
				event.stopPropagation();
				const willOpen = !menu.classList.contains('is-open');
				if (willOpen) openNestedMenu(menu);
				else setOpen(menu, false);
			});
		}

		menuToggle?.addEventListener('click', () => {
			const open = !header.classList.contains('mobile-open');
			header.classList.toggle('mobile-open', open);
			menuToggle.setAttribute('aria-expanded', String(open));
			if (!open) {
				closeNestedMenus();
				closeTopMenus();
			}
		});

		header.querySelectorAll<HTMLAnchorElement>('.menu-bar a').forEach((link) => link.addEventListener('click', closeAll));
		document.addEventListener('pointerdown', (event) => {
			if (event.target instanceof Node && !header.contains(event.target)) closeAll();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			const nestedTrigger = header.querySelector<HTMLButtonElement>('.submenu-group.is-open > .submenu-trigger');
			const topTrigger = header.querySelector<HTMLButtonElement>('.menu-group.is-open > .menu-trigger');
			const restoreTarget = nestedTrigger ?? topTrigger ?? (header.classList.contains('mobile-open') ? menuToggle : null);
			closeAll();
			restoreTarget?.focus();
		});
		desktop.addEventListener('change', closeAll);
		window.addEventListener('resize', () => {
			for (const menu of topMenus) if (menu.classList.contains('is-open')) positionTopPanel(menu);
			for (const menu of nestedMenus) if (menu.classList.contains('is-open')) positionSubmenu(menu);
		});

		if (window.location.pathname === '/') {
			header.querySelector<HTMLAnchorElement>('.home-menu-link')?.setAttribute('aria-current', 'page');
		}

		const selected = new URLSearchParams(window.location.search).get('category')?.trim().toLowerCase();
		if (selected) {
			header.querySelectorAll<HTMLAnchorElement>('[data-category]').forEach((link) => {
				if (link.dataset.category?.toLowerCase() !== selected) return;
				link.classList.add('is-active');
				link.setAttribute('aria-current', 'page');
				link.closest<HTMLElement>('[data-menu-group]')?.querySelector<HTMLElement>(':scope > .menu-trigger')?.classList.add('has-active-child');
			});
		}
	};

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeHeader, { once: true });
	else initializeHeader();
	document.addEventListener('astro:page-load', initializeHeader);
</script>

<style>
	.site-header {
		position: relative;
		z-index: 1000;
		overflow: visible;
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		background: var(--color-neutral-background-3);
		box-shadow: var(--shadow-4);
	}

	.utility-bar {
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		background: var(--color-neutral-background-4);
	}

	.utility-inner {
		display: flex;
		min-height: 32px;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-160);
		direction: ltr;
	}

	.social-links,
	.utility-links {
		display: flex;
		align-items: center;
	}

	.social-links { gap: var(--spacing-20); }
	.utility-links { gap: var(--spacing-20); direction: rtl; }

	.social-links a,
	.utility-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		text-decoration: none;
	}

	.social-links a {
		width: 28px;
		height: 28px;
	}

	.utility-links a {
		min-height: 28px;
		padding-inline: var(--spacing-80);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
		white-space: nowrap;
	}

	.social-links a:hover,
	.utility-links a:hover,
	.social-links a:focus-visible,
	.utility-links a:focus-visible {
		background: var(--color-subtle-background-hover);
		color: var(--color-neutral-foreground-1);
	}

	.social-links svg {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
	}

	.social-links a:first-child svg path:first-child { fill: currentColor; stroke: none; }
	.social-links a:first-child svg path:last-child { fill: var(--color-neutral-background-4); stroke: none; }

	.brand-surface { background: var(--color-neutral-background-2); }

	.brand-inner {
		display: grid;
		min-height: 88px;
		grid-template-columns: auto minmax(260px, 1fr);
		align-items: center;
		gap: clamp(var(--spacing-240), 5vw, var(--spacing-560));
		direction: ltr;
	}

	.brand {
		display: inline-flex;
		width: clamp(180px, 18vw, 214px);
		align-items: center;
		text-decoration: none;
	}

	.brand img {
		width: 100%;
		height: 72px;
		object-fit: contain;
		object-position: left center;
	}

	.brand-description {
		max-width: 680px;
		justify-self: end;
		direction: rtl;
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-body-1);
		line-height: var(--line-height-body-1);
		text-align: right;
	}

	.mobile-menu-toggle { display: none; }

	.main-nav {
		position: relative;
		z-index: 30;
		overflow: visible;
		border-top: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		background: var(--color-neutral-background-3);
	}

	.nav-inner {
		position: relative;
		min-height: 48px;
		overflow: visible;
	}

	.menu-bar {
		display: flex;
		width: 100%;
		min-height: 48px;
		align-items: center;
		gap: var(--spacing-20);
		overflow: visible;
	}

	.home-menu-link,
	.menu-direct,
	.menu-parent-link,
	.menu-trigger {
		display: inline-flex;
		min-height: 40px;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		border: var(--stroke-thin) solid transparent;
		border-radius: var(--radius-medium);
		background: transparent;
		color: var(--color-neutral-foreground-2);
		font: inherit;
		font-size: var(--font-size-caption-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-caption-1);
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background var(--motion-duration-control) var(--curve-easy-ease),
			border-color var(--motion-duration-control) var(--curve-easy-ease),
			color var(--motion-duration-control) var(--curve-easy-ease),
			box-shadow var(--motion-duration-control) var(--curve-easy-ease);
	}

	.home-menu-link { width: 40px; padding: 0; }
	.home-menu-text { display: none; }
	.menu-direct { padding-inline: var(--spacing-120); }
	.menu-parent-link { padding-inline: var(--spacing-120) var(--spacing-60); border-start-end-radius: 0; border-end-end-radius: 0; }
	.menu-trigger { width: 32px; padding: 0; border-start-start-radius: 0; border-end-start-radius: 0; }

	.home-menu-link:hover,
	.menu-direct:hover,
	.menu-parent-link:hover,
	.menu-trigger:hover,
	.home-menu-link:focus-visible,
	.menu-direct:focus-visible,
	.menu-parent-link:focus-visible,
	.menu-trigger:focus-visible,
	.menu-group.is-open > .menu-parent-link,
	.menu-group.is-open > .menu-trigger {
		background: var(--color-subtle-background-hover);
		color: var(--color-neutral-foreground-1);
	}

	.home-menu-link[aria-current='page'],
	.menu-direct.is-active,
	.menu-parent-link.is-active,
