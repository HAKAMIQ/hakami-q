---
import { SITE_TITLE } from '../consts';

type MenuItem = {
	label: string;
	slug: string;
	children?: MenuItem[];
	openDirection?: 'start' | 'end';
};

type MenuGroup = {
	label: string;
	slug: string;
	tone: string;
	items?: MenuItem[];
};

const categoryHref = (slug: string) => `/blog?category=${encodeURIComponent(slug)}`;

const menuGroups: MenuGroup[] = [
	{
		label: 'NINTENDO',
		slug: 'nintendo',
		tone: 'nintendo',
		items: [
			{ label: 'Nintendo Switch', slug: 'nintendo-switch' },
			{ label: 'Wii U', slug: 'wii-u' },
			{ label: 'Wii', slug: 'wii' },
			{ label: 'GameCube - GCN', slug: 'gamecube' },
			{ label: 'Nintendo 64 - N64', slug: 'n64' },
			{ label: 'SNES', slug: 'snes' },
			{ label: 'NES', slug: 'nes' },
			{
				label: 'Nintendo Handhelds',
				slug: 'nintendo-handhelds',
				openDirection: 'end',
				children: [
					{ label: 'Nintendo 3DS', slug: 'nintendo-3ds' },
					{ label: 'Nintendo DS - NDS', slug: 'nintendo-ds' },
					{ label: 'Game Boy Advance - GBA', slug: 'gba' },
					{ label: 'Game Boy Color - GBC', slug: 'gbc' },
					{ label: 'Game Boy - GB', slug: 'game-boy' },
					{ label: 'Virtual Boy - VB', slug: 'virtual-boy' },
				],
			},
		],
	},
	{
		label: 'PLAYSTATION',
		slug: 'playstation',
		tone: 'playstation',
		items: [
			{ label: 'PlayStation 1 - PS1', slug: 'ps1' },
			{ label: 'PlayStation 2 - PS2', slug: 'ps2' },
			{ label: 'PlayStation 3 - PS3', slug: 'ps3' },
			{ label: 'PlayStation 4 - PS4', slug: 'ps4' },
			{ label: 'PlayStation 5 - PS5', slug: 'ps5' },
			{
				label: 'PlayStation Handhelds',
				slug: 'playstation-handhelds',
				openDirection: 'end',
				children: [
					{ label: 'PlayStation Portable - PSP', slug: 'psp' },
					{ label: 'PlayStation Vita - PS Vita', slug: 'ps-vita' },
				],
			},
		],
	},
	{
		label: 'XBOX',
		slug: 'xbox',
		tone: 'xbox',
		items: [
			{ label: 'Original Xbox - OG Xbox', slug: 'original-xbox' },
			{ label: 'Xbox 360 - X360', slug: 'xbox-360' },
		],
	},
	{
		label: 'SEGA',
		slug: 'sega',
		tone: 'sega',
		items: [
			{ label: 'Mega Drive / Genesis', slug: 'genesis' },
			{ label: 'SEGA Saturn', slug: 'saturn' },
			{ label: 'Dreamcast - DC', slug: 'dreamcast' },
			{ label: 'Game Gear - GG', slug: 'game-gear' },
			{ label: 'SEGA NAOMI', slug: 'naomi' },
			{ label: 'SEGA Pico', slug: 'pico' },
			{ label: 'Advanced Pico Beena', slug: 'beena' },
		],
	},
	{
		label: 'OTHER CONSOLES',
		slug: 'other-consoles',
		tone: 'other',
		items: [
			{
				label: 'Atari',
				slug: 'atari',
				openDirection: 'start',
				children: [
					{ label: 'Atari 2600', slug: 'atari-2600' },
					{ label: 'Atari 5200', slug: 'atari-5200' },
					{ label: 'Atari 7800', slug: 'atari-7800' },
					{ label: 'Atari 800', slug: 'atari-800' },
				],
			},
			{
				label: 'Commodore',
				slug: 'commodore',
				openDirection: 'start',
				children: [
					{ label: 'Commodore 64 - C64', slug: 'commodore-64' },
					{ label: 'Amiga', slug: 'amiga' },
				],
			},
			{ label: 'Android Emulators', slug: 'android-emulators' },
			{ label: 'Guides & Articles', slug: 'guides-articles' },
		],
	},
	{
		label: 'MULTI-SYSTEM',
		slug: 'multi-system',
		tone: 'multi',
		items: [
			{ label: 'RetroArch', slug: 'retroarch' },
			{ label: 'RetroBat', slug: 'retrobat' },
			{ label: 'LaunchBox', slug: 'launchbox' },
		],
	},
	{
		label: 'PC',
		slug: 'pc',
		tone: 'pc',
	},
];
---

<header class="site-header">
	<div class="topbar">
		<div class="site-container topbar-inner">
			<div class="top-links" aria-label="روابط إضافية">
				<a href="/privacy">سياسة الخصوصية</a>
				<a href="/terms">اتفاقية الاستخدام</a>
				<a href="/contact">اتصل بنا</a>
			</div>

			<div class="social-links" aria-label="الشبكات الاجتماعية">
				<a href="https://www.youtube.com/@HAKAMIQ" target="_blank" rel="noopener noreferrer">YouTube</a>
				<a href="https://discord.gg/WqgRrmAKpC" target="_blank" rel="noopener noreferrer">Discord</a>
				<a href="https://t.me/hakamiq0" target="_blank" rel="noopener noreferrer">Telegram</a>
			</div>
		</div>
	</div>

	<div class="brand-row">
		<div class="site-container brand-row-inner">
			<a class="brand" href="/" aria-label="الصفحة الرئيسية">
				<span class="brand-mark">H</span>
				<span class="brand-copy">
					<strong>{SITE_TITLE}</strong>
					<small>دليل المحاكيات والألعاب</small>
				</span>
			</a>

			<p class="brand-description">
				شروحات تشغيل المحاكيات وإعداد الألعاب وحلول المشاكل على الكمبيوتر
			</p>
		</div>
	</div>

	<nav class="main-nav" aria-label="أقسام HAKAMIQ">
		<div class="site-container nav-inner">
			<button
				class="mobile-menu-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="primary-menu"
			>
				<span>الأقسام</span>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>

			<div class="menu-bar" id="primary-menu" dir="ltr">
				<a class="home-menu-link" href="/" aria-label="الصفحة الرئيسية">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="m3 11 9-8 9 8"></path>
						<path d="M5 10v10h14V10"></path>
						<path d="M9 20v-6h6v6"></path>
					</svg>
				</a>

				{
					menuGroups.map((group) =>
						group.items ? (
							<details
								class:list={['menu-group', `tone-${group.tone}`]}
								data-menu-group
							>
								<summary>
									<span>{group.label}</span>
									<svg class="menu-chevron" viewBox="0 0 20 20" aria-hidden="true">
										<path d="m6 8 4 4 4-4"></path>
									</svg>
								</summary>

								<div class="menu-panel">
									<a
										class="menu-overview"
										href={categoryHref(group.slug)}
										data-category={group.slug}
									>
										<span>All {group.label}</span>
										<svg viewBox="0 0 20 20" aria-hidden="true">
											<path d="M4 10h12M12 6l4 4-4 4"></path>
										</svg>
									</a>

									<div class="menu-list">
										{
											group.items.map((item) =>
												item.children ? (
													<details
														class:list={[
															'submenu-group',
															item.openDirection === 'end'
																? 'open-end'
																: 'open-start',
														]}
														data-submenu-group
													>
														<summary>
															<span>{item.label}</span>
															<svg viewBox="0 0 20 20" aria-hidden="true">
																<path d="m8 5 5 5-5 5"></path>
															</svg>
														</summary>

														<div class="submenu-panel">
															<a
																class="submenu-overview"
																href={categoryHref(item.slug)}
																data-category={item.slug}
															>
																All {item.label}
															</a>

															{
																item.children.map((child) => (
																	<a
																		href={categoryHref(child.slug)}
																		data-category={child.slug}
																	>
																		{child.label}
																	</a>
																))
															}
														</div>
													</details>
												) : (
													<a
														href={categoryHref(item.slug)}
														data-category={item.slug}
													>
														{item.label}
													</a>
												),
											)
										}
									</div>
								</div>
							</details>
						) : (
							<a
								class:list={['menu-direct', `tone-${group.tone}`]}
								href={categoryHref(group.slug)}
								data-category={group.slug}
							>
								{group.label}
							</a>
						),
					)
				}
			</div>
		</div>
	</nav>
</header>

<script>
	document.documentElement.classList.add('js-nav');

	const header = document.querySelector<HTMLElement>('.site-header');

	if (header) {
		const menuToggle = header.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
		const menuLinks = Array.from(header.querySelectorAll<HTMLAnchorElement>('.menu-bar a'));
		const topLevelMenus = Array.from(
			header.querySelectorAll<HTMLDetailsElement>('[data-menu-group]'),
		);
		const nestedMenus = Array.from(
			header.querySelectorAll<HTMLDetailsElement>('[data-submenu-group]'),
		);
		const mobileMedia = window.matchMedia('(max-width: 920px)');

		const closeNestedMenus = (except?: HTMLDetailsElement) => {
			for (const menu of nestedMenus) {
				if (menu !== except) menu.open = false;
			}
		};

		const closeTopLevelMenus = (except?: HTMLDetailsElement) => {
			for (const menu of topLevelMenus) {
				if (menu !== except) menu.open = false;
			}
		};

		const setMobileMenu = (open: boolean) => {
			header.classList.toggle('mobile-open', open);
			menuToggle?.setAttribute('aria-expanded', String(open));

			if (!open) {
				closeNestedMenus();
				closeTopLevelMenus();
			}
		};

		for (const menu of topLevelMenus) {
			menu.addEventListener('toggle', () => {
				if (!menu.open) return;
				closeTopLevelMenus(menu);
				closeNestedMenus();
			});
		}

		for (const menu of nestedMenus) {
			menu.addEventListener('toggle', () => {
				if (menu.open) closeNestedMenus(menu);
			});
		}

		menuToggle?.addEventListener('click', () => {
			setMobileMenu(!header.classList.contains('mobile-open'));
		});

		for (const link of menuLinks) {
			link.addEventListener('click', () => {
				if (mobileMedia.matches) setMobileMenu(false);
			});
		}

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Node) || header.contains(target)) return;

			closeNestedMenus();
			closeTopLevelMenus();
			if (mobileMedia.matches) setMobileMenu(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;

			closeNestedMenus();
			closeTopLevelMenus();
			setMobileMenu(false);
			menuToggle?.focus();
		});

		mobileMedia.addEventListener('change', () => {
			setMobileMenu(false);
		});

		const selectedCategory = new URLSearchParams(window.location.search)
			.get('category')
			?.trim()
			.toLowerCase();

		if (selectedCategory) {
			for (const link of header.querySelectorAll<HTMLAnchorElement>('[data-category]')) {
				if (link.dataset.category?.toLowerCase() !== selectedCategory) continue;

				link.classList.add('is-active');
				link.closest<HTMLDetailsElement>('[data-menu-group]')
					?.querySelector<HTMLElement>(':scope > summary')
					?.classList.add('has-active-child');
			}
		}
	}
</script>

<style>
	.site-header {
		position: relative;
		z-index: 50;
		border-bottom: 1px solid var(--hq-border);
		background: rgba(17, 20, 24, 0.97);
		box-shadow: 0 14px 32px rgba(0, 0, 0, 0.22);
	}

	.topbar {
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
		background: #0c0f13;
	}

	.topbar-inner,
	.brand-row-inner,
	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
	}

	.topbar-inner {
		min-height: 38px;
		color: var(--hq-muted);
		font-size: 0.8rem;
	}

	.top-links,
	.social-links {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.topbar a {
		color: var(--hq-muted);
		text-decoration: none;
		transition: color 0.18s ease;
	}

	.topbar a:hover {
		color: var(--hq-text);
	}

	.brand-row {
		background:
			linear-gradient(90deg, transparent, rgba(229, 21, 21, 0.06), transparent),
			var(--hq-surface);
	}

	.brand-row-inner {
		min-height: 92px;
		padding-block: 1rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 50px;
		height: 50px;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 15px;
		background: linear-gradient(145deg, #ff2c35, var(--hq-red-dark));
		box-shadow: 0 12px 26px rgba(229, 21, 21, 0.24);
		color: #fff;
		font-size: 1.65rem;
		font-weight: 900;
	}

	.brand-copy {
		display: grid;
		gap: 0.05rem;
	}

	.brand-copy strong {
		color: var(--hq-text);
		font-size: 1.35rem;
		letter-spacing: 0.04em;
	}

	.brand-copy small {
		color: var(--hq-muted);
		font-size: 0.78rem;
	}

	.brand-description {
		max-width: 520px;
		color: var(--hq-muted);
		font-size: 0.92rem;
		text-align: left;
	}

	.main-nav {
		position: relative;
		z-index: 60;
		border-top: 1px solid rgba(255, 255, 255, 0.07);
		border-bottom: 1px solid rgba(0, 0, 0, 0.28);
		background: linear-gradient(180deg, #ef262c 0%, #cb1017 100%);
		box-shadow:
			inset 0 1px rgba(255, 255, 255, 0.08),
			0 8px 20px rgba(0, 0, 0, 0.2);
	}

	.nav-inner {
		position: relative;
		min-height: 52px;
		overflow: visible;
	}

	.menu-bar {
		display: flex;
		width: 100%;
		align-items: stretch;
		overflow: visible;
	}

	.home-menu-link,
	.menu-direct,
	.menu-group > summary {
		display: flex;
		min-height: 52px;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		box-sizing: border-box;
		border: 0;
		border-inline-end: 1px solid rgba(0, 0, 0, 0.12);
		border-radius: 0;
		background: transparent;
		color: #fff;
		font-family: inherit;
		font-size: 0.76rem;
		font-weight: 800;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background 0.16s ease,
			color 0.16s ease;
	}

	.home-menu-link {
		width: 54px;
		padding: 0;
		background: rgba(255, 255, 255, 0.08);
	}

	.home-menu-link svg {
		width: 19px;
		height: 19px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.menu-direct,
	.menu-group > summary {
		padding: 0 0.85rem;
	}

	.menu-group {
		--menu-accent: #ff3b42;
		position: relative;
		flex: 0 0 auto;
	}

	.menu-group.tone-nintendo {
		--menu-accent: #ff3342;
	}

	.menu-group.tone-playstation {
		--menu-accent: #3d96ff;
	}

	.menu-group.tone-xbox {
		--menu-accent: #47c95a;
	}

	.menu-group.tone-sega {
		--menu-accent: #3b9cff;
	}

	.menu-group.tone-other {
		--menu-accent: #ff8a3d;
	}

	.menu-group.tone-multi {
		--menu-accent: #aa83ff;
	}

	.menu-group > summary,
	.submenu-group > summary {
		list-style: none;
		user-select: none;
	}

	.menu-group > summary::-webkit-details-marker,
	.submenu-group > summary::-webkit-details-marker {
		display: none;
	}

	.menu-chevron {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
		transition: transform 0.18s ease;
	}

	.menu-group[open] > summary .menu-chevron {
		transform: rotate(180deg);
	}

	.home-menu-link:hover,
	.home-menu-link:focus-visible,
	.menu-direct:hover,
	.menu-direct:focus-visible,
	.menu-direct.is-active,
	.menu-group[open] > summary,
	.menu-group > summary:hover,
	.menu-group > summary:focus-visible,
	.menu-group > summary.has-active-child {
		background: rgba(121, 0, 5, 0.34);
		color: #fff;
		outline: none;
	}

	.menu-panel,
	.submenu-panel {
		direction: ltr;
		text-align: left;
	}

	.menu-panel {
		position: absolute;
		top: 100%;
		left: 0;
		width: 244px;
		padding: 6px 0 8px;
		border: 1px solid rgba(255, 255, 255, 0.09);
		border-top: 3px solid var(--menu-accent);
		border-radius: 0 0 10px 10px;
		background: #101217;
		box-shadow: 0 18px 38px rgba(0, 0, 0, 0.46);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-7px);
		pointer-events: none;
		transition:
			opacity 0.16s ease,
			transform 0.16s ease,
			visibility 0.16s ease;
		z-index: 200;
	}

	.tone-other > .menu-panel,
	.tone-multi > .menu-panel {
		right: 0;
		left: auto;
	}

	.menu-group[open] > .menu-panel,
	.menu-group:focus-within > .menu-panel {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		pointer-events: auto;
	}

	.menu-overview {
		display: flex;
		min-height: 40px;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin: 0 6px 6px;
		padding: 0 11px;
		border: 1px solid color-mix(in srgb, var(--menu-accent) 30%, transparent);
		border-radius: 7px;
		background: color-mix(in srgb, var(--menu-accent) 10%, transparent);
		color: #fff;
		font-size: 0.76rem;
		font-weight: 800;
		text-decoration: none;
	}

	.menu-overview svg {
		width: 15px;
		height: 15px;
		fill: none;
		stroke: var(--menu-accent);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.menu-list > a,
	.submenu-group > summary,
	.submenu-panel > a {
		position: relative;
		display: flex;
		min-height: 38px;
		align-items: center;
		box-sizing: border-box;
		border-bottom: 1px solid rgba(255, 255, 255, 0.055);
		background: transparent;
		color: #f4f5f7;
		font-size: 0.76rem;
		font-weight: 700;
		line-height: 1.35;
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			padding 0.15s ease;
	}

	.menu-list > a,
	.submenu-panel > a {
		padding: 0.45rem 13px 0.45rem 24px;
	}

	.menu-list > a::before,
	.submenu-panel > a::before {
		position: absolute;
		left: 12px;
		width: 4px;
		height: 4px;
		border-radius: 999px;
		background: var(--menu-accent);
		content: '';
		opacity: 0.72;
	}

	.menu-list > a:hover,
	.menu-list > a:focus-visible,
	.menu-list > a.is-active,
	.submenu-group > summary:hover,
	.submenu-group > summary:focus-visible,
	.submenu-panel > a:hover,
	.submenu-panel > a:focus-visible,
	.submenu-panel > a.is-active {
		background: linear-gradient(90deg, color-mix(in srgb, var(--menu-accent) 88%, #b40008), #b90d14);
		color: #fff;
		outline: none;
	}

	.menu-list > a:hover,
	.menu-list > a:focus-visible,
	.menu-list > a.is-active,
	.submenu-panel > a:hover,
	.submenu-panel > a:focus-visible,
	.submenu-panel > a.is-active {
		padding-left: 27px;
	}

	.submenu-group {
		position: relative;
	}

	.submenu-group > summary {
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.45rem 11px 0.45rem 13px;
		cursor: pointer;
	}

	.submenu-group > summary svg {
		width: 15px;
		height: 15px;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
		transition: transform 0.16s ease;
	}

	.submenu-group.open-start > summary svg {
		transform: rotate(180deg);
	}

	.submenu-panel {
		position: absolute;
		top: -7px;
		width: 232px;
