---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>

		<div class="internal-links">
			<HeaderLink href="/">الرئيسية</HeaderLink>
			<HeaderLink href="/blog">المقالات</HeaderLink>
			<HeaderLink href="/about">عن HAKAMIQ</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	h2 {
		margin: 0;
		font-size: 1.2em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.internal-links {
		display: flex;
		gap: 0.5rem;
	}

	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	nav a.active {
		border-bottom-color: var(--accent);
	}

	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>