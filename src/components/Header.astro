---
type MenuItem = {
	label: string;
	slug: string;
	children?: MenuItem[];
};

type MenuGroup = {
	label: string;
	slug: string;
	items?: MenuItem[];
};

const categoryHref = (slug: string) => `/blog?category=${encodeURIComponent(slug)}`;

const menuGroups: MenuGroup[] = [
	{
		label: 'Nintendo',
		slug: 'nintendo',
		items: [
			{ label: 'Nintendo Switch', slug: 'nintendo-switch' },
			{ label: 'Wii U', slug: 'wii-u' },
			{ label: 'Wii', slug: 'wii' },
			{ label: 'GameCube - GCN', slug: 'gamecube' },
			{ label: 'Nintendo 64 - N64', slug: 'n64' },
			{ label: 'SNES', slug: 'snes' },
			{ label: 'NES', slug: 'nes' },
			{
				label: 'Nintendo handhelds',
				slug: 'nintendo-handhelds',
				children: [
					{ label: 'Nintendo 3DS', slug: 'nintendo-3ds' },
					{ label: 'Nintendo DS - NDS', slug: 'nintendo-ds' },
					{ label: 'Game Boy Advance - GBA', slug: 'gba' },
					{ label: 'Game Boy Color - GBC', slug: 'gbc' },
					{ label: 'Game Boy - GB', slug: 'game-boy' },
					{ label: 'Virtual Boy - VB', slug: 'virtual-boy' },
				],
			},
		],
	},
	{
		label: 'PlayStation',
		slug: 'playstation',
		items: [
			{ label: 'PlayStation 1 - PS1', slug: 'ps1' },
			{ label: 'PlayStation 2 - PS2', slug: 'ps2' },
			{ label: 'PlayStation 3 - PS3', slug: 'ps3' },
			{ label: 'PlayStation 4 - PS4', slug: 'ps4' },
			{ label: 'PlayStation 5 - PS5', slug: 'ps5' },
			{
				label: 'PlayStation handhelds',
				slug: 'playstation-handhelds',
				children: [
					{ label: 'PlayStation Portable - PSP', slug: 'psp' },
					{ label: 'PlayStation Vita - PS Vita', slug: 'ps-vita' },
				],
			},
		],
	},
	{
		label: 'Xbox',
		slug: 'xbox',
		items: [
			{ label: 'Original Xbox - OG Xbox', slug: 'original-xbox' },
			{ label: 'Xbox 360 - X360', slug: 'xbox-360' },
		],
	},
	{
		label: 'SEGA',
		slug: 'sega',
		items: [
			{ label: 'Mega Drive / Genesis', slug: 'genesis' },
			{ label: 'SEGA Saturn', slug: 'saturn' },
			{ label: 'Dreamcast - DC', slug: 'dreamcast' },
			{ label: 'Game Gear - GG', slug: 'game-gear' },
			{ label: 'SEGA NAOMI', slug: 'naomi' },
			{ label: 'SEGA Pico', slug: 'pico' },
			{ label: 'Advanced Pico Beena', slug: 'beena' },
		],
	},
	{
		label: 'Other consoles',
		slug: 'other-consoles',
		items: [
			{
				label: 'Atari',
				slug: 'atari',
				children: [
					{ label: 'Atari 2600', slug: 'atari-2600' },
					{ label: 'Atari 5200', slug: 'atari-5200' },
					{ label: 'Atari 7800', slug: 'atari-7800' },
					{ label: 'Atari 800', slug: 'atari-800' },
				],
			},
			{
				label: 'Commodore',
				slug: 'commodore',
				children: [
					{ label: 'Commodore 64 - C64', slug: 'commodore-64' },
					{ label: 'Amiga', slug: 'amiga' },
				],
			},
			{ label: 'Android emulators', slug: 'android-emulators' },
			{ label: 'Guides & articles', slug: 'guides-articles' },
		],
	},
	{
		label: 'Multi-system',
		slug: 'multi-system',
		items: [
			{ label: 'RetroArch', slug: 'retroarch' },
			{ label: 'RetroBat', slug: 'retrobat' },
			{ label: 'LaunchBox', slug: 'launchbox' },
		],
	},
	{ label: 'PC', slug: 'pc' },
];
---

<header class="site-header" data-site-header>
	<div class="utility-bar">
		<div class="site-container utility-inner">
			<nav class="social-links" aria-label="الشبكات الاجتماعية" dir="ltr">
				<a href="https://www.youtube.com/@HAKAMIQ" target="_blank" rel="noopener noreferrer">YouTube</a>
				<a href="https://discord.gg/WqgRrmAKpC" target="_blank" rel="noopener noreferrer">Discord</a>
				<a href="https://t.me/hakamiq0" target="_blank" rel="noopener noreferrer">Telegram</a>
			</nav>

			<nav class="utility-links" aria-label="روابط المعلومات" dir="rtl">
				<a href="/privacy">سياسة الخصوصية</a>
				<a href="/terms">اتفاقية الاستخدام</a>
				<a href="/contact">اتصل بنا</a>
			</nav>
		</div>
	</div>

	<div class="brand-surface">
		<div class="site-container brand-inner">
			<a class="brand" href="/" aria-label="HAKAMIQ - الصفحة الرئيسية">
				<img src="/hakamiq-logo.svg" width="214" height="102" alt="HAKAMIQ" />
			</a>

			<p class="brand-description">
				شروحات عربية عملية لتشغيل المحاكيات وإعداد الألعاب وحل المشاكل على الكمبيوتر
			</p>

			<a class="brand-action" href="/blog">
				<span>تصفح المقالات</span>
				<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4M9 5l-5 5 5 5"></path></svg>
			</a>
		</div>
	</div>

	<nav class="main-nav" aria-label="أقسام HAKAMIQ">
		<div class="site-container nav-inner">
			<button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="primary-menu">
				<span>الأقسام</span>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			</button>

			<div class="menu-bar" id="primary-menu" dir="ltr">
				<a class="home-menu-link" href="/" aria-label="الصفحة الرئيسية">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="m3 11 9-8 9 8"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path>
					</svg>
				</a>

				{
					menuGroups.map((group) =>
						group.items ? (
							<div class="menu-group" data-menu-group>
								<button class="menu-trigger" type="button" aria-expanded="false" aria-haspopup="menu">
									<span>{group.label}</span>
									<svg class="menu-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4"></path></svg>
								</button>

								<div class="menu-panel" data-menu-panel>
									<div class="menu-surface" role="menu" aria-label={group.label}>
										<div class="menu-list">
											{
												group.items.map((item) =>
													item.children ? (
														<div class="submenu-group" data-submenu-group>
															<button
																class="submenu-trigger"
																type="button"
																aria-expanded="false"
																aria-haspopup="menu"
																aria-label={`فتح ${item.label}`}
															>
																<span>{item.label}</span>
																<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6"></path></svg>
															</button>

															<div class="submenu-panel" data-submenu-panel>
																<div class="submenu-surface" role="menu" aria-label={item.label}>
																	{item.children.map((child) => (
																		<a role="menuitem" href={categoryHref(child.slug)} data-category={child.slug}>{child.label}</a>
																	))}
																</div>
															</div>
														</div>
													) : (
														<a role="menuitem" href={categoryHref(item.slug)} data-category={item.slug}>{item.label}</a>
													),
												)
											}
										</div>
									</div>
								</div>
							</div>
						) : (
							<a class="menu-direct" href={categoryHref(group.slug)} data-category={group.slug}>{group.label}</a>
						),
					)
				}
			</div>
		</div>
	</nav>
</header>

<script>
	document.documentElement.classList.add('js-nav');

	const initializeHeader = () => {
		const header = document.querySelector<HTMLElement>('[data-site-header]');
		if (!header || header.dataset.initialized === 'true') return;
		header.dataset.initialized = 'true';

		const desktop = window.matchMedia('(min-width: 1081px)');
		const menuToggle = header.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
		const topMenus = Array.from(header.querySelectorAll<HTMLElement>('[data-menu-group]'));
		const nestedMenus = Array.from(header.querySelectorAll<HTMLElement>('[data-submenu-group]'));
		const timers = new WeakMap<HTMLElement, number>();
		const closeDelay = 180;
		const viewportGap = 12;

		const clearTimer = (menu: HTMLElement) => {
			const timer = timers.get(menu);
			if (timer !== undefined) window.clearTimeout(timer);
			timers.delete(menu);
		};

		const setOpen = (menu: HTMLElement, open: boolean) => {
			clearTimer(menu);
			menu.classList.toggle('is-open', open);
			menu.querySelector<HTMLButtonElement>(':scope > button')?.setAttribute('aria-expanded', String(open));
		};

		const closeNestedMenus = (except?: HTMLElement) => {
			for (const menu of nestedMenus) if (menu !== except) setOpen(menu, false);
		};

		const closeTopMenus = (except?: HTMLElement) => {
			for (const menu of topMenus) if (menu !== except) setOpen(menu, false);
		};

		const positionTopPanel = (menu: HTMLElement) => {
			if (!desktop.matches) return;
			const panel = menu.querySelector<HTMLElement>(':scope > [data-menu-panel]');
			if (!panel) return;

			panel.classList.remove('align-end');
			if (panel.getBoundingClientRect().right > window.innerWidth - viewportGap) panel.classList.add('align-end');
		};

		const positionSubmenu = (menu: HTMLElement) => {
			if (!desktop.matches) return;
			const panel = menu.querySelector<HTMLElement>(':scope > [data-submenu-panel]');
			if (!panel) return;

			panel.classList.remove('open-start');
			menu.classList.remove('opens-start');
			if (panel.getBoundingClientRect().right > window.innerWidth - viewportGap) {
				panel.classList.add('open-start');
				menu.classList.add('opens-start');
			}
		};

		const openTopMenu = (menu: HTMLElement) => {
			closeTopMenus(menu);
			closeNestedMenus();
			setOpen(menu, true);
			window.requestAnimationFrame(() => positionTopPanel(menu));
		};

		const openNestedMenu = (menu: HTMLElement) => {
			closeNestedMenus(menu);
			setOpen(menu, true);
			window.requestAnimationFrame(() => positionSubmenu(menu));
		};

		const scheduleClose = (menu: HTMLElement, nested = false) => {
			clearTimer(menu);
			timers.set(menu, window.setTimeout(() => {
				setOpen(menu, false);
				if (!nested) closeNestedMenus();
			}, closeDelay));
		};

		const closeAll = () => {
			header.classList.remove('mobile-open');
			menuToggle?.setAttribute('aria-expanded', 'false');
			closeNestedMenus();
			closeTopMenus();
		};

		for (const menu of topMenus) {
			const trigger = menu.querySelector<HTMLButtonElement>(':scope > .menu-trigger');

			menu.addEventListener('pointerenter', () => {
				if (!desktop.matches) return;
				clearTimer(menu);
				openTopMenu(menu);
			});

			menu.addEventListener('pointerleave', (event) => {
				if (!desktop.matches) return;
				const next = event.relatedTarget;
				if (next instanceof Node && menu.contains(next)) return;
				scheduleClose(menu);
			});

			menu.addEventListener('focusin', () => {
				if (desktop.matches) openTopMenu(menu);
			});

			menu.addEventListener('focusout', () => {
				window.setTimeout(() => {
					if (!menu.contains(document.activeElement)) scheduleClose(menu);
				}, 0);
			});

			trigger?.addEventListener('click', () => {
				const willOpen = !menu.classList.contains('is-open');
				if (willOpen) openTopMenu(menu);
				else {
					setOpen(menu, false);
					closeNestedMenus();
				}
			});
		}

		for (const menu of nestedMenus) {
			const trigger = menu.querySelector<HTMLButtonElement>(':scope > .submenu-trigger');

			menu.addEventListener('pointerenter', () => {
				if (!desktop.matches) return;
				clearTimer(menu);
				openNestedMenu(menu);
			});

			menu.addEventListener('pointerleave', (event) => {
				if (!desktop.matches) return;
				const next = event.relatedTarget;
				if (next instanceof Node && menu.contains(next)) return;
				scheduleClose(menu, true);
			});

			menu.addEventListener('focusin', () => {
				if (desktop.matches) openNestedMenu(menu);
			});

			menu.addEventListener('focusout', () => {
				window.setTimeout(() => {
					if (!menu.contains(document.activeElement)) scheduleClose(menu, true);
				}, 0);
			});

			trigger?.addEventListener('click', (event) => {
				event.stopPropagation();
				const willOpen = !menu.classList.contains('is-open');
				if (willOpen) openNestedMenu(menu);
				else setOpen(menu, false);
			});
		}

		menuToggle?.addEventListener('click', () => {
			const open = !header.classList.contains('mobile-open');
			header.classList.toggle('mobile-open', open);
			menuToggle.setAttribute('aria-expanded', String(open));
			if (!open) {
				closeNestedMenus();
				closeTopMenus();
			}
		});

		header.querySelectorAll<HTMLAnchorElement>('.menu-bar a').forEach((link) => {
			link.addEventListener('click', closeAll);
		});

		document.addEventListener('pointerdown', (event) => {
			if (event.target instanceof Node && !header.contains(event.target)) closeAll();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeAll();
		});

		desktop.addEventListener('change', closeAll);
		window.addEventListener('resize', () => {
			for (const menu of topMenus) if (menu.classList.contains('is-open')) positionTopPanel(menu);
			for (const menu of nestedMenus) if (menu.classList.contains('is-open')) positionSubmenu(menu);
		});

		const selected = new URLSearchParams(window.location.search).get('category')?.trim().toLowerCase();
		if (selected) {
			header.querySelectorAll<HTMLAnchorElement>('[data-category]').forEach((link) => {
				if (link.dataset.category?.toLowerCase() !== selected) return;
				link.classList.add('is-active');
				link.closest<HTMLElement>('[data-menu-group]')?.querySelector<HTMLElement>(':scope > .menu-trigger')?.classList.add('has-active-child');
			});
		}
	};

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeHeader, { once: true });
	else initializeHeader();
	document.addEventListener('astro:page-load', initializeHeader);
</script>

<style>
	.site-header {
		--header-space-1: 4px;
		--header-space-2: 8px;
		--header-space-3: 12px;
		--header-space-4: 16px;
		--header-radius-small: 4px;
		--header-radius-medium: 8px;
		--header-radius-large: 12px;
		--header-menu-width: 288px;
		--header-menu-surface: rgba(31, 34, 38, 0.98);
		--header-menu-hover: rgba(255, 255, 255, 0.065);
		position: relative;
		z-index: 1000;
		overflow: visible;
		border-bottom: 1px solid var(--color-neutral-stroke-subtle);
		background: var(--color-neutral-background-1);
		box-shadow: var(--shadow-2);
	}

	.utility-bar {
		border-bottom: 1px solid var(--color-neutral-stroke-subtle);
		background: #0d0f11;
	}

	.utility-inner {
		display: flex;
		min-height: 32px;
		align-items: center;
		justify-content: space-between;
		gap: var(--header-space-4);
		direction: ltr;
		font-size: 0.72rem;
	}

	.utility-links,
	.social-links {
		display: flex;
		align-items: center;
		gap: var(--header-space-1);
	}

	.utility-bar a {
		display: inline-flex;
		min-height: 28px;
		align-items: center;
		padding-inline: var(--header-space-2);
		border-radius: var(--header-radius-small);
		color: var(--color-neutral-foreground-3);
		text-decoration: none;
	}

	.utility-bar a:hover,
	.utility-bar a:focus-visible {
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
		outline: none;
	}

	.brand-surface {
		background: var(--color-neutral-background-2);
	}

	.brand-inner {
		display: grid;
		min-height: 84px;
		grid-template-columns: auto minmax(260px, 1fr) auto;
		align-items: center;
		gap: clamp(20px, 3vw, 44px);
		direction: rtl;
	}

	.brand {
		display: inline-flex;
		width: 176px;
		align-items: center;
		justify-content: flex-start;
		text-decoration: none;
	}

	.brand img {
		display: block;
		width: 100%;
		height: 68px;
		object-fit: contain;
		object-position: right center;
	}

	.brand-description {
		max-width: 650px;
		margin: 0 auto;
		color: var(--color-neutral-foreground-3);
		font-size: 0.875rem;
		line-height: 1.65;
		text-align: right;
	}

	.brand-action {
		display: inline-flex;
		min-height: 40px;
		align-items: center;
		justify-content: center;
		gap: var(--header-space-2);
		padding-inline: var(--header-space-4);
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--header-radius-medium);
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		box-shadow: var(--shadow-2);
	}

	.brand-action:hover,
	.brand-action:focus-visible {
		border-color: var(--color-neutral-stroke-2);
		background: var(--color-neutral-background-4);
		outline: none;
	}

	.brand-action svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.main-nav {
		position: relative;
		z-index: 20;
		overflow: visible;
		border-top: 1px solid var(--color-neutral-stroke-subtle);
		background: rgba(23, 25, 28, 0.98);
		backdrop-filter: blur(16px) saturate(1.05);
	}

	.nav-inner {
		position: relative;
		min-height: 52px;
		overflow: visible;
	}

	.menu-bar {
		display: flex;
		width: 100%;
		align-items: center;
		gap: var(--header-space-1);
		overflow: visible;
	}

	.home-menu-link,
	.menu-direct,
	.menu-trigger {
		display: inline-flex;
		min-height: 40px;
		align-items: center;
		justify-content: center;
		gap: 6px;
		box-sizing: border-box;
		border: 1px solid transparent;
		border-radius: var(--header-radius-medium);
		background: transparent;
		color: var(--color-neutral-foreground-2);
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: background var(--duration-faster) var(--curve-easy-ease), border-color var(--duration-faster) var(--curve-easy-ease), color var(--duration-faster) var(--curve-easy-ease);
	}

	.home-menu-link { width: 40px; padding: 0; }
	.menu-direct,
	.menu-trigger { padding-inline: var(--header-space-3); }

	.home-menu-link svg,
	.menu-chevron,
	.submenu-trigger svg {
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.home-menu-link svg { width: 18px; height: 18px; }
	.menu-chevron { width: 14px; height: 14px; transition: transform var(--duration-faster) var(--curve-easy-ease); }

	.menu-group {
		position: relative;
		flex: 0 0 auto;
	}

	.home-menu-link:hover,
	.home-menu-link:focus-visible,
	.menu-direct:hover,
	.menu-direct:focus-visible,
	.menu-direct.is-active,
	.menu-trigger:hover,
	.menu-trigger:focus-visible,
	.menu-trigger.has-active-child,
	.menu-group.is-open > .menu-trigger {
		border-color: var(--color-neutral-stroke-1);
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
		outline: none;
	}

	.menu-direct.is-active,
	.menu-trigger.has-active-child {
		box-shadow: inset 0 -2px var(--color-brand-background);
	}

	.menu-group.is-open > .menu-trigger .menu-chevron { transform: rotate(180deg); }

	.menu-panel,
	.submenu-panel {
		direction: ltr;
		text-align: left;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity var(--duration-faster) var(--curve-easy-ease), transform var(--duration-faster) var(--curve-easy-ease), visibility var(--duration-faster) var(--curve-easy-ease);
	}

	.menu-panel {
		position: absolute;
		top: 100%;
		left: 0;
		right: auto;
		width: min(var(--header-menu-width), calc(100vw - 24px));
		padding-top: var(--header-space-1);
		transform: translateY(-4px);
		z-index: 220;
	}

	.menu-panel.align-end {
		left: auto;
		right: 0;
	}

	.menu-group.is-open > .menu-panel,
	.submenu-group.is-open > .submenu-panel {
		opacity: 1;
		visibility: visible;
		transform: translate(0);
		pointer-events: auto;
	}

	.menu-surface,
	.submenu-surface {
		padding: var(--header-space-2);
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--header-radius-medium);
		background: var(--header-menu-surface);
		box-shadow: var(--shadow-16);
		backdrop-filter: blur(20px) saturate(1.08);
	}

	.menu-surface {
		max-height: min(70vh, 560px);
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.menu-list {
