@"
---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>

		<div class="internal-links">
			<HeaderLink href="/">الرئيسية</HeaderLink>
			<HeaderLink href="/blog">المقالات</HeaderLink>
			<HeaderLink href="/emulators">المحاكيات</HeaderLink>
			<HeaderLink href="/games">الألعاب</HeaderLink>
			<HeaderLink href="/services">الخدمات</HeaderLink>
			<HeaderLink href="/about">من نحن</HeaderLink>
			<HeaderLink href="/contact">اتصل بنا</HeaderLink>
		</div>

		<div class="social-links">
			<a href="https://www.youtube.com/@HAKAMIQ" target="_blank">
				YouTube
			</a>

			<a href="https://discord.gg/WqgRrmAKpC" target="_blank">
				Discord
			</a>

			<a href="https://t.me/hakamiq0" target="_blank">
				Telegram
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	h2 {
		margin: 0;
		font-size: 1.3rem;
	}

	h2 a {
		text-decoration: none;
	}

	.internal-links,
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	nav a {
		padding: 1rem 0.5rem;
		color: var(--black);
		text-decoration: none;
		border-bottom: 3px solid transparent;
	}

	nav a:hover {
		border-bottom-color: var(--accent);
	}

	@media (max-width: 900px) {
		nav {
			flex-direction: column;
			padding: 1rem 0;
		}

		.internal-links,
		.social-links {
			flex-wrap: wrap;
			justify-content: center;
		}
	}
</style>
"@ | Set-Content -Encoding UTF8 .\src\components\Header.astro