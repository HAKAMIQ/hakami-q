---
import '../styles/fluent-core-theme.css';
import '../styles/global.css';
import '../styles/fluent-text.css';
import '../styles/fluent-tooltip.css';
import '../styles/fluent-web-components.css';
import '../styles/fluent-native-controls.css';
import '../styles/header-persistent-nav.css';
import '../styles/blog-listing-card-auto.css';
import '../styles/media-frame.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	canonicalPath?: string;
}

const siteURL = Astro.site ?? Astro.url;
const pathname = Astro.url.pathname;
const isBlogArchiveRoute =
	pathname === '/blog/' ||
	pathname.startsWith('/blog/category/') ||
	pathname.startsWith('/blog/page/');
const inferredType = pathname.startsWith('/blog/') && !isBlogArchiveRoute ? 'article' : 'website';
const noIndexRoutes = ['/admin', '/login'];
const shouldNoIndex = noIndexRoutes.some(
	(route) => pathname === route || pathname === `${route}/` || pathname.startsWith(`${route}/`),
);
const robotsContent = shouldNoIndex
	? 'noindex,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'
	: 'max-snippet:-1,max-image-preview:large,max-video-preview:-1';
const inheritedSocialImage = (Astro.locals as { seoImage?: ImageMetadata | string }).seoImage;
const {
	title,
	description,
	image = inheritedSocialImage ?? FallbackImage,
	type = inferredType,
	canonicalPath = Astro.url.pathname,
} = Astro.props;
const normalizedCanonicalPath = canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const canonicalURL = new URL(normalizedCanonicalPath, siteURL);
const imageURL = typeof image === 'string' ? new URL(image, siteURL) : new URL(image.src, siteURL);

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: new URL('/', siteURL).href,
	inLanguage: 'ar',
};
const websiteSchemaJson = JSON.stringify(websiteSchema).replace(/</g, '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="theme-color" content="#0a0a0a" />
<meta name="color-scheme" content="dark" />
<meta name="application-name" content="HAKAMIQ" />
<meta name="apple-mobile-web-app-title" content="HAKAMIQ" />
<meta name="google-site-verification" content="XtigMu7Eoi7r0s5KVr8hpRRJGqcFmQisyEVfBjZKKjE" />
<meta name="robots" content={robotsContent} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" />
<link rel="mask-icon" href="/favicon.svg" color="#d71047" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', siteURL)} />
<meta name="generator" content={Astro.generator} />
<script src="/header-persistent-nav.js" defer></script>
<script src="/fluent-tooltip.js" defer></script>
<script src="/fluent-category-tree.js" defer></script>

<link rel="canonical" href={canonicalURL} />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ar_SA" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
{Astro.url.pathname === '/' && (
	<script type="application/ld+json" set:html={websiteSchemaJson}></script>
)}
