---
import type { CollectionEntry } from 'astro:content';
import { categoryDefinitions, getPostCategories } from '../data/blog-taxonomy';
import ArticleShare from './ArticleShare.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	posts: CollectionEntry<'blog'>[];
}

const { post, posts } = Astro.props;
const currentCategories = getPostCategories(post);
const primaryCategory =
	categoryDefinitions.find(
		(category) => currentCategories.includes(category.slug) && (category.parents?.length ?? 0) > 0,
	) ?? categoryDefinitions.find((category) => currentCategories.includes(category.slug));

const relatedPosts = posts
	.filter((candidate) => candidate.id !== post.id)
	.map((candidate) => {
		const candidateCategories = getPostCategories(candidate);
		const overlap = candidateCategories.filter((slug) => currentCategories.includes(slug)).length;
		return { candidate, overlap };
	})
	.filter(({ overlap }) => overlap > 0)
	.sort(
		(a, b) =>
			b.overlap - a.overlap ||
			b.candidate.data.pubDate.valueOf() - a.candidate.data.pubDate.valueOf(),
	)
	.slice(0, 4)
	.map(({ candidate }) => candidate);

const chronologicalPosts = [...posts].sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const currentIndex = chronologicalPosts.findIndex((candidate) => candidate.id === post.id);
const newerPost = currentIndex > 0 ? chronologicalPosts[currentIndex - 1] : null;
const olderPost = currentIndex >= 0 && currentIndex < chronologicalPosts.length - 1
	? chronologicalPosts[currentIndex + 1]
	: null;
---

<ArticleShare title={post.data.title} description={post.data.description} />

<section class="article-discovery" aria-labelledby="article-discovery-title">
	<header class="article-discovery__header">
		<div>
			<span>استكشف المزيد</span>
			<h2 id="article-discovery-title">تابع القراءة</h2>
		</div>
		{primaryCategory && (
			<a class="article-discovery__category" href={`/blog/category/${primaryCategory.slug}/`}>
				جميع مقالات {primaryCategory.name}
			</a>
		)}
	</header>

	{relatedPosts.length > 0 && (
		<div class="article-discovery__grid">
			{relatedPosts.map((related) => {
				const image = related.data.heroImageUrl ?? related.data.heroImage?.src;
				return (
					<article class="article-discovery__card">
						<a href={`/blog/${related.id}/`} aria-label={`قراءة مقال: ${related.data.title}`}>
							<div class="article-discovery__media">
								{image ? (
									<img src={image} alt={related.data.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
								) : (
									<div class="article-discovery__placeholder" aria-hidden="true">HAKAMIQ</div>
								)}
								<span class="article-discovery__scrim" aria-hidden="true"></span>
								<span class="article-discovery__label">articles</span>
								<div class="article-discovery__title"><h3>{related.data.title}</h3></div>
							</div>
							<div class="article-discovery__body"><p>{related.data.description}</p></div>
						</a>
					</article>
				);
			})}
		</div>
	)}

	{(newerPost || olderPost) && (
		<nav class="article-discovery__sequence" aria-label="التنقل بين المقالات">
			{newerPost ? (
				<a href={`/blog/${newerPost.id}/`} rel="prev">
					<span>المقال الأحدث</span>
					<strong>{newerPost.data.title}</strong>
				</a>
			) : <span></span>}
			{olderPost && (
				<a href={`/blog/${olderPost.id}/`} rel="next">
					<span>المقال الأقدم</span>
					<strong>{olderPost.data.title}</strong>
				</a>
			)}
		</nav>
	)}
</section>

<style>
	.article-discovery {
		width: min(100%, 1040px);
		max-width: 1040px;
		margin: clamp(var(--spacing-320), 5vw, var(--spacing-520)) auto 0;
		padding-top: clamp(var(--spacing-200), 3vw, var(--spacing-320));
		border-top: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
	}

	.article-discovery__header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--spacing-160);
		margin-bottom: var(--spacing-200);
	}

	.article-discovery__header span,
	.article-discovery__sequence span {
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
	}

	.article-discovery__header h2 {
		margin: var(--spacing-40) 0 0;
		padding: 0;
		border: 0;
		font-size: var(--font-size-title-2);
	}

	.article-discovery__category {
		color: var(--color-brand-foreground-link);
		font-size: var(--font-size-body-1);
		text-decoration: none;
	}

	.article-discovery__category:hover,
	.article-discovery__category:focus-visible {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.article-discovery__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-160);
		align-items: stretch;
	}

	.article-discovery__card {
		overflow: hidden;
		border: 2px solid #4b4b50;
		border-radius: 18px;
		background: #242426;
		box-shadow: 0 0 0 3px #111214, 0 10px 24px rgba(0, 0, 0, 0.28), inset 0 0 0 1px rgba(255, 255, 255, 0.08);
	}

	.article-discovery__card > a {
		display: flex;
		height: 100%;
		flex-direction: column;
		padding: 7px;
		color: inherit;
		text-decoration: none;
	}

	.article-discovery__media {
		position: relative;
		isolation: isolate;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.34);
		border-radius: 13px 13px 6px 6px;
		border-bottom: 2px solid #4385ff;
		background: #ececee;
		box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.16), 0 1px 0 rgba(255, 255, 255, 0.1);
	}

	.article-discovery__media img,
	.article-discovery__placeholder {
		display: block;
		width: 100%;
		height: 100%;
	}

	.article-discovery__media img {
		object-fit: cover;
		object-position: center;
		transition: transform 180ms ease;
	}

	.article-discovery__card:hover .article-discovery__media img,
	.article-discovery__card:focus-within .article-discovery__media img {
		transform: scale(1.015);
	}

	.article-discovery__placeholder {
		display: grid;
		place-items: center;
		background: linear-gradient(145deg, #eeeeef, #cfcfd2);
		color: #3e3e42;
		font-weight: 700;
	}

	.article-discovery__scrim {
		position: absolute;
		z-index: 1;
		inset: 0;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.84) 0%, rgba(0, 0, 0, 0.54) 28%, rgba(0, 0, 0, 0.12) 58%, transparent 78%);
		pointer-events: none;
	}

	.article-discovery__label {
		position: absolute;
		z-index: 3;
		top: 14px;
		left: 14px;
		display: inline-flex;
		min-height: 32px;
		align-items: center;
		padding: 0 13px;
		border: 1px solid rgba(255, 138, 158, 0.46);
		border-radius: 999px;
		background: linear-gradient(180deg, #5b0718 0%, #26040c 100%);
		box-shadow: 0 3px 8px rgba(0, 0, 0, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.1);
		color: #ff5270;
		font-size: 0.86rem;
		font-weight: 700;
		line-height: 1;
	}

	.article-discovery__title {
		position: absolute;
		z-index: 2;
		right: 16px;
		bottom: 15px;
		left: 16px;
		text-align: right;
	}

	.article-discovery__title h3 {
		display: -webkit-box;
		overflow: hidden;
		margin: 0;
		color: #fff;
		font-size: clamp(1.05rem, 1.6vw, 1.45rem);
		font-weight: 800;
		line-height: 1.42;
		text-wrap: balance;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		-webkit-text-stroke: 0.75px rgba(0, 0, 0, 0.9);
		paint-order: stroke fill;
		text-shadow: 0 2px 1px #000, 0 0 7px rgba(0, 0, 0, 0.95);
	}

	.article-discovery__body {
		display: flex;
		min-height: 108px;
		flex: 1;
		align-items: center;
		justify-content: center;
		padding: 15px 17px 16px;
		border-radius: 0 0 11px 11px;
		background: linear-gradient(180deg, #303033 0%, #29292c 100%);
	}

	.article-discovery__body p {
		display: -webkit-box;
		overflow: hidden;
		margin: 0;
		color: #d5d5d8;
		font-size: 1rem;
		line-height: 1.72;
		text-align: center;
		text-wrap: pretty;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.article-discovery__sequence {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-120);
		margin-top: var(--spacing-200);
	}

	.article-discovery__sequence a {
		display: block;
		min-width: 0;
		padding: var(--spacing-160);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-2);
		color: var(--color-neutral-foreground-1);
		text-decoration: none;
	}

	.article-discovery__sequence a:hover,
	.article-discovery__sequence a:focus-visible {
		border-color: var(--color-neutral-stroke-1);
		background: var(--color-neutral-background-2-hover);
	}

	.article-discovery__sequence strong {
		display: block;
		margin-top: var(--spacing-60);
		line-height: 1.55;
		text-wrap: balance;
	}

	@media (max-width: 700px) {
		.article-discovery__header {
			align-items: start;
			flex-direction: column;
		}

		.article-discovery__grid,
		.article-discovery__sequence {
			grid-template-columns: 1fr;
		}

		.article-discovery__sequence > span:empty {
			display: none;
		}

		.article-discovery__card > a { padding: 6px; }
		.article-discovery__label { top: 11px; left: 11px; min-height: 29px; padding-inline: 11px; font-size: 0.78rem; }
		.article-discovery__title { right: 13px; bottom: 12px; left: 13px; }
		.article-discovery__title h3 { font-size: clamp(1rem, 4.6vw, 1.25rem); }
		.article-discovery__body { min-height: 94px; padding: 13px 14px 14px; }
		.article-discovery__body p { font-size: 0.95rem; line-height: 1.65; }
	}
</style>
