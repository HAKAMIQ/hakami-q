---
const today = new Date();
---

<footer class="site-footer">
	<div class="site-container footer-main">
		<section class="footer-brand" aria-label="HAKAMIQ">
			<a class="footer-logo" href="/" aria-label="HAKAMIQ - الصفحة الرئيسية">
				<img src="/hakamiq-logo.svg" width="214" height="102" alt="HAKAMIQ" loading="lazy" />
			</a>

			<p>
				دليل عربي عملي للمحاكيات وتشغيل الألعاب وإعدادها وحلول المشاكل على الكمبيوتر وأجهزة الألعاب
			</p>

			<nav class="footer-social" aria-label="الشبكات الاجتماعية" dir="ltr">
				<a href="https://www.youtube.com/@HAKAMIQ" target="_blank" rel="noopener noreferrer">YouTube</a>
				<a href="https://discord.gg/WqgRrmAKpC" target="_blank" rel="noopener noreferrer">Discord</a>
				<a href="https://t.me/hakamiq0" target="_blank" rel="noopener noreferrer">Telegram</a>
			</nav>
		</section>

		<div class="footer-navigation">
			<nav class="footer-column" aria-label="روابط الموقع">
				<h2>الموقع</h2>
				<a href="/blog">المقالات</a>
				<a href="/services">خدمة المحاكيات</a>
				<a href="/about">من نحن</a>
				<a href="/contact">اتصل بنا</a>
			</nav>

			<nav class="footer-column" aria-label="الروابط القانونية">
				<h2>السياسات</h2>
				<a href="/privacy">سياسة الخصوصية</a>
				<a href="/terms">اتفاقية الاستخدام</a>
				<a href="/disclaimer">إخلاء المسؤولية</a>
			</nav>

			<nav class="footer-column footer-column-english" aria-label="English pages" dir="ltr">
				<h2>English</h2>
				<a href="/en/about">About us</a>
				<a href="/en/contact">Contact us</a>
				<a href="/en/services">Emulator service</a>
				<a href="/en/privacy">Privacy & terms</a>
			</nav>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="site-container footer-bottom-inner">
			<p>&copy; {today.getFullYear()} HAKAMIQ جميع الحقوق محفوظة</p>
			<nav class="footer-meta" aria-label="روابط إضافية" dir="ltr">
				<a href="/rss.xml">RSS</a>
				<a href="/en/about" lang="en">English</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		--footer-space-1: 4px;
		--footer-space-2: 8px;
		--footer-space-3: 12px;
		--footer-space-4: 16px;
		--footer-space-6: 24px;
		--footer-space-8: 32px;
		--footer-radius-small: 4px;
		--footer-radius-medium: 8px;
		margin-top: clamp(2.5rem, 4vw, 4rem);
		border-top: 1px solid var(--color-neutral-stroke-subtle);
		background: var(--color-neutral-background-2);
		color: var(--color-neutral-foreground-3);
	}

	.footer-main {
		display: grid;
		grid-template-columns: minmax(300px, 1.15fr) minmax(520px, 1.85fr);
		gap: clamp(32px, 5vw, 72px);
		align-items: start;
		padding-block: clamp(32px, 4vw, 48px);
	}

	.footer-brand {
		display: grid;
		justify-items: start;
		gap: var(--footer-space-3);
		max-width: 560px;
	}

	.footer-logo {
		display: inline-flex;
		width: 158px;
		align-items: center;
		justify-content: flex-start;
		text-decoration: none;
	}

	.footer-logo img {
		display: block;
		width: 100%;
		height: 64px;
		object-fit: contain;
		object-position: right center;
	}

	.footer-brand > p {
		max-width: 520px;
		margin: 0;
		color: var(--color-neutral-foreground-3);
		font-size: 0.875rem;
		line-height: 1.75;
	}

	.footer-social {
		display: flex;
		flex-wrap: wrap;
		gap: var(--footer-space-2);
		margin-top: var(--footer-space-1);
	}

	.footer-social a {
		display: inline-flex;
		min-height: 36px;
		align-items: center;
		justify-content: center;
		padding-inline: var(--footer-space-3);
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: var(--footer-radius-medium);
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-2);
		font-size: 0.78rem;
		font-weight: 600;
		text-decoration: none;
		box-shadow: var(--shadow-2);
		transition: background var(--duration-faster) var(--curve-easy-ease), border-color var(--duration-faster) var(--curve-easy-ease), color var(--duration-faster) var(--curve-easy-ease);
	}

	.footer-social a:hover,
	.footer-social a:focus-visible {
		border-color: var(--color-neutral-stroke-2);
		background: var(--color-neutral-background-4);
		color: var(--color-neutral-foreground-1);
		outline: none;
	}

	.footer-navigation {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(24px, 3vw, 44px);
		align-items: start;
	}

	.footer-column {
		display: grid;
		align-content: start;
		gap: var(--footer-space-1);
	}

	.footer-column h2 {
		margin: 0 0 var(--footer-space-2);
		color: var(--color-neutral-foreground-1);
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.5;
	}

	.footer-column a {
		display: inline-flex;
		width: fit-content;
		min-height: 34px;
		align-items: center;
		padding-inline: var(--footer-space-2);
		border-radius: var(--footer-radius-small);
		color: var(--color-neutral-foreground-3);
		font-size: 0.8rem;
		line-height: 1.45;
		text-decoration: none;
		transition: background var(--duration-faster) var(--curve-easy-ease), color var(--duration-faster) var(--curve-easy-ease);
	}

	.footer-column a:hover,
	.footer-column a:focus-visible {
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
		outline: none;
	}

	.footer-column-english {
		text-align: left;
	}

	.footer-bottom {
		border-top: 1px solid var(--color-neutral-stroke-subtle);
		background: var(--color-neutral-background-1);
	}

	.footer-bottom-inner {
		display: flex;
		min-height: 50px;
		align-items: center;
		justify-content: space-between;
		gap: var(--footer-space-4);
		font-size: 0.74rem;
	}

	.footer-bottom-inner p {
		margin: 0;
	}

	.footer-meta {
		display: flex;
		align-items: center;
		gap: var(--footer-space-1);
	}

	.footer-meta a {
		display: inline-flex;
		min-height: 30px;
		align-items: center;
		padding-inline: var(--footer-space-2);
		border-radius: var(--footer-radius-small);
		color: var(--color-neutral-foreground-3);
		text-decoration: none;
	}

	.footer-meta a:hover,
	.footer-meta a:focus-visible {
		background: var(--color-neutral-background-2);
		color: var(--color-neutral-foreground-1);
		outline: none;
	}

	@media (max-width: 980px) {
		.footer-main {
			grid-template-columns: 1fr;
			gap: var(--footer-space-8);
		}

		.footer-brand {
			max-width: 680px;
		}

		.footer-navigation {
			padding-block-start: var(--footer-space-6);
			border-block-start: 1px solid var(--color-neutral-stroke-subtle);
		}
	}

	@media (max-width: 640px) {
		.site-footer { margin-top: 2.5rem; }

		.footer-main {
			padding-block: var(--footer-space-8);
		}

		.footer-logo {
			width: 146px;
		}

		.footer-logo img {
			height: 58px;
		}

		.footer-navigation {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--footer-space-6);
		}

		.footer-column-english {
			grid-column: 1 / -1;
		}

		.footer-bottom-inner {
			min-height: 64px;
			flex-direction: column;
			justify-content: center;
			gap: var(--footer-space-1);
			text-align: center;
		}
	}

	@media (max-width: 420px) {
		.footer-navigation {
			grid-template-columns: 1fr;
		}

		.footer-column-english {
			grid-column: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-social a,
		.footer-column a {
			transition: none;
		}
	}
</style>
