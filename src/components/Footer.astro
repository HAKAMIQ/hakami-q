@"
---
const today = new Date();
---

<footer>
	<p>
		&copy; {today.getFullYear()} HAKAMIQ. جميع الحقوق محفوظة.
	</p>

	<nav>
		<a href="/privacy">سياسة الخصوصية</a>
		<a href="/terms">اتفاقية الاستخدام</a>
		<a href="/contact">اتصل بنا</a>
		<a href="/services">خدمة المحاكيات</a>
	</nav>

	<div class="social-links">
		<a href="https://www.youtube.com/@HAKAMIQ" target="_blank">
			YouTube
		</a>

		<a href="https://discord.gg/WqgRrmAKpC" target="_blank">
			Discord
		</a>

		<a href="https://t.me/hakamiq0" target="_blank">
			Telegram
		</a>
	</div>
</footer>

<style>
	footer {
		padding: 2em 1em 4em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		direction: rtl;
	}

	nav {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 1rem 0;
	}

	nav a,
	.social-links a {
		color: rgb(var(--gray));
		text-decoration: none;
	}

	nav a:hover,
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 1rem;
	}

	@media (max-width: 720px) {
		nav,
		.social-links {
			flex-direction: column;
		}
	}
</style>
"@ | Set-Content -Encoding UTF8 .\src\components\Footer.astro