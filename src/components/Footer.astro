---
const today = new Date();
---

<footer class="site-footer">
	<div class="site-container footer-main">
		<section class="footer-brand">
			<a class="footer-logo" href="/" aria-label="الصفحة الرئيسية">
				<span class="footer-mark" aria-hidden="true">H</span>
				<span class="footer-logo-copy">
					<strong>HAKAMIQ</strong>
					<small>دليل المحاكيات والألعاب</small>
				</span>
			</a>

			<p>
				شروحات عربية للمحاكيات وتشغيل الألعاب وإعدادها وحلول المشاكل على الكمبيوتر وأجهزة الألعاب
			</p>

			<nav class="footer-social" aria-label="الشبكات الاجتماعية" dir="ltr">
				<a href="https://www.youtube.com/@HAKAMIQ" target="_blank" rel="noopener noreferrer">YouTube</a>
				<a href="https://discord.gg/WqgRrmAKpC" target="_blank" rel="noopener noreferrer">Discord</a>
				<a href="https://t.me/hakamiq0" target="_blank" rel="noopener noreferrer">Telegram</a>
			</nav>
		</section>

		<div class="footer-navigation">
			<nav class="footer-column" aria-label="روابط الموقع">
				<h2>روابط الموقع</h2>
				<a href="/blog">المقالات</a>
				<a href="/emulators">المحاكيات</a>
				<a href="/games">الألعاب</a>
				<a href="/services">الخدمات</a>
			</nav>

			<nav class="footer-column" aria-label="روابط المعلومات">
				<h2>معلومات</h2>
				<a href="/about">من نحن</a>
				<a href="/contact">اتصل بنا</a>
				<a href="/privacy">سياسة الخصوصية</a>
				<a href="/terms">اتفاقية الاستخدام</a>
			</nav>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="site-container footer-bottom-inner">
			<p>&copy; {today.getFullYear()} HAKAMIQ جميع الحقوق محفوظة</p>
			<a href="/rss.xml">RSS</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: clamp(2.75rem, 5vw, 4.5rem);
		border-top: 1px solid var(--color-neutral-stroke-subtle);
		background:
			radial-gradient(circle at 92% 0%, rgba(232, 17, 35, 0.08), transparent 28rem),
			#0d0f11;
		color: var(--color-neutral-foreground-3);
	}

	.footer-main {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(360px, 0.9fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
		padding-block: clamp(2.25rem, 4vw, 3.5rem);
	}

	.footer-brand {
		max-width: 650px;
	}

	.footer-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--color-neutral-foreground-1);
		text-decoration: none;
	}

	.footer-mark {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: var(--radius-large);
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.15), transparent 48%),
			var(--color-brand-background);
		box-shadow: 0 8px 20px rgba(232, 17, 35, 0.2);
		color: #fff;
		font-size: 1.2rem;
		font-weight: 850;
	}

	.footer-logo-copy {
		display: grid;
		gap: 0.02rem;
	}

	.footer-logo strong {
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: 0.045em;
	}

	.footer-logo small {
		color: var(--color-neutral-foreground-3);
		font-size: 0.68rem;
	}

	.footer-brand > p {
		max-width: 590px;
		margin-top: 0.9rem;
		color: var(--color-neutral-foreground-3);
		font-size: 0.84rem;
		line-height: 1.85;
	}

	.footer-social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 1.05rem;
	}

	.footer-social a {
		display: inline-flex;
		min-height: 32px;
		align-items: center;
		justify-content: center;
		padding-inline: 0.68rem;
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: 999px;
		background: rgba(31, 34, 38, 0.72);
		color: var(--color-neutral-foreground-2);
		font-size: 0.72rem;
		font-weight: 650;
		text-decoration: none;
		transition:
			background var(--duration-fast) var(--curve-easy-ease),
			border-color var(--duration-fast) var(--curve-easy-ease),
			color var(--duration-fast) var(--curve-easy-ease),
			transform var(--duration-fast) var(--curve-easy-ease);
	}

	.footer-social a:hover {
		border-color: var(--color-neutral-stroke-2);
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
		transform: translateY(-1px);
	}

	.footer-navigation {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
		padding-inline-start: clamp(0rem, 2vw, 1.5rem);
		border-inline-start: 1px solid var(--color-neutral-stroke-subtle);
	}

	.footer-column {
		display: grid;
		align-content: start;
		gap: 0.2rem;
	}

	.footer-column h2 {
		margin-bottom: 0.65rem;
		color: var(--color-neutral-foreground-1);
		font-size: 0.88rem;
		font-weight: 750;
	}

	.footer-column a {
		display: inline-flex;
		min-height: 34px;
		align-items: center;
		width: fit-content;
		padding-inline: 0.45rem;
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		font-size: 0.79rem;
		text-decoration: none;
		transition:
			background var(--duration-fast) var(--curve-easy-ease),
			color var(--duration-fast) var(--curve-easy-ease);
	}

	.footer-column a:hover {
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
	}

	.footer-bottom {
		border-top: 1px solid var(--color-neutral-stroke-subtle);
		background: #090b0d;
	}

	.footer-bottom-inner {
		display: flex;
		min-height: 54px;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.73rem;
	}

	.footer-bottom a {
		padding: 0.2rem 0.45rem;
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		text-decoration: none;
	}

	.footer-bottom a:hover {
		background: var(--color-neutral-background-2);
		color: var(--color-neutral-foreground-1);
	}

	@media (max-width: 900px) {
		.footer-main {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.footer-brand {
			max-width: none;
		}

		.footer-navigation {
			padding-block-start: 1.5rem;
			padding-inline-start: 0;
			border-block-start: 1px solid var(--color-neutral-stroke-subtle);
			border-inline-start: 0;
		}
	}

	@media (max-width: 560px) {
		.site-footer {
			margin-top: 2.5rem;
		}

		.footer-main {
			padding-block: 1.85rem;
		}

		.footer-navigation {
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
		}

		.footer-bottom-inner {
			min-height: 64px;
			flex-direction: column;
			justify-content: center;
			gap: 0.15rem;
			text-align: center;
		}
	}

	@media (max-width: 380px) {
		.footer-navigation {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-social a,
		.footer-column a {
			transition: none;
		}
	}
</style>
