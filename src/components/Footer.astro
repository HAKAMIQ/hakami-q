---
const today = new Date();
---

<footer class="site-footer" dir="rtl">
	<div class="site-container footer-row" dir="ltr">
		<p class="footer-copyright">
			<span class="copyright-latin" dir="ltr">Copyright &copy;{today.getFullYear()} HAKAMIQ</span>
		</p>

		<nav class="footer-links" aria-label="روابط الفوتر" dir="rtl">
			<a href="/about">من نحن</a>
			<a href="/contact">اتصل بنا</a>
			<a href="/terms">اتفاقية الاستخدام</a>
			<a href="/privacy">سياسة الخصوصية</a>
			<a href="/">الصفحة الرئيسية</a>
			<a href="/services">خدمة المحاكيات</a>
			<a href="/disclaimer">إخلاء المسؤولية</a>
		</nav>

		<button class="footer-back-to-top" type="button" aria-label="العودة إلى أعلى الصفحة" title="العودة إلى أعلى الصفحة">
			<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 12 4-4 4 4"></path></svg>
		</button>
	</div>
</footer>

<script>
	const initializeFooterBackToTop = () => {
		document.querySelectorAll<HTMLButtonElement>('.footer-back-to-top').forEach((button) => {
			if (button.dataset.initialized === 'true') return;
			button.dataset.initialized = 'true';
			button.addEventListener('click', () => {
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
			});
		});
	};

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeFooterBackToTop, { once: true });
	else initializeFooterBackToTop();
	document.addEventListener('astro:page-load', initializeFooterBackToTop);
</script>

<style>
	.site-footer {
		margin-top: var(--spacing-480);
		border-top: var(--stroke-thin) solid var(--color-brand-stroke-1);
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-3);
	}

	.footer-row {
		display: grid;
		min-height: 52px;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--spacing-160);
	}

	.footer-copyright {
		margin: 0;
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-2);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-caption-2);
		white-space: nowrap;
	}

	.copyright-latin { unicode-bidi: isolate; }

	.footer-links {
		display: flex;
		min-width: 0;
		align-items: center;
		justify-content: flex-end;
		gap: var(--spacing-20);
		overflow: hidden;
	}

	.footer-links a {
		display: inline-flex;
		min-height: 32px;
		align-items: center;
		padding-inline: var(--spacing-80);
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-caption-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-caption-1);
		text-decoration: none;
		white-space: nowrap;
		transition:
			background var(--motion-duration-control) var(--curve-easy-ease),
			color var(--motion-duration-control) var(--curve-easy-ease);
	}

	.footer-links a:hover,
	.footer-links a:focus-visible {
		background: var(--color-subtle-background-hover);
		color: var(--color-neutral-foreground-1);
	}

	.footer-back-to-top {
		display: grid;
		width: 36px;
		height: 36px;
		place-items: center;
		padding: 0;
		border: var(--stroke-thin) solid var(--color-brand-stroke-1);
		border-radius: 50%;
		background: var(--color-brand-background-1);
		color: var(--color-neutral-foreground-on-brand);
		box-shadow: var(--shadow-4);
		cursor: pointer;
		transition:
			background var(--motion-duration-control) var(--curve-easy-ease),
			box-shadow var(--motion-duration-control) var(--curve-easy-ease),
			transform var(--motion-duration-control) var(--curve-easy-ease);
	}

	.footer-back-to-top:hover,
	.footer-back-to-top:focus-visible {
		background: var(--color-brand-background-1-hover);
		box-shadow: var(--shadow-8);
		transform: translateY(-1px);
	}

	.footer-back-to-top svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.75;
	}

	@media (max-width: 1020px) {
		.footer-row { gap: var(--spacing-80); }
		.footer-links { gap: 0; }
		.footer-links a { padding-inline: var(--spacing-40); font-size: var(--font-size-caption-2); }
		.footer-copyright { font-size: var(--font-size-caption-2); }
	}

	@media (max-width: 760px) {
		.footer-row {
			min-height: 76px;
			grid-template-columns: 1fr auto;
			grid-template-areas:
				"links top"
				"copyright top";
			gap: var(--spacing-40) var(--spacing-100);
			padding-block: var(--spacing-80);
		}

		.footer-links {
			grid-area: links;
			justify-content: flex-start;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.footer-links::-webkit-scrollbar { display: none; }
		.footer-copyright { grid-area: copyright; }
		.footer-back-to-top { grid-area: top; align-self: center; }
	}

	@media (pointer: coarse) {
		.footer-links a { min-height: var(--control-height-touch); }
		.footer-back-to-top { width: var(--control-height-touch); height: var(--control-height-touch); }
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-links a,
		.footer-back-to-top { transition: none; }
		.footer-back-to-top:hover,
		.footer-back-to-top:focus-visible { transform: none; }
	}
</style>
