---
const today = new Date();
---

<footer class="site-footer">
	<div class="site-container footer-shell">
		<section class="footer-brand">
			<a class="footer-logo" href="/" aria-label="الصفحة الرئيسية">
				<span class="footer-mark" aria-hidden="true">H</span>
				<span>
					<strong>HAKAMIQ</strong>
					<small>دليل المحاكيات والألعاب</small>
				</span>
			</a>

			<p>
				دليل عربي لشروحات المحاكيات وتشغيل الألعاب وإعدادها وحلول المشاكل على الكمبيوتر
				وأجهزة الألعاب
			</p>

			<nav class="footer-social" aria-label="الشبكات الاجتماعية" dir="ltr">
				<a href="https://www.youtube.com/@HAKAMIQ" target="_blank" rel="noopener noreferrer">
					YouTube
				</a>
				<a href="https://discord.gg/WqgRrmAKpC" target="_blank" rel="noopener noreferrer">
					Discord
				</a>
				<a href="https://t.me/hakamiq0" target="_blank" rel="noopener noreferrer">
					Telegram
				</a>
			</nav>
		</section>

		<div class="footer-links-grid">
			<section class="footer-column">
				<h2>روابط الموقع</h2>
				<nav aria-label="روابط الموقع">
					<a href="/blog">المقالات</a>
					<a href="/emulators">المحاكيات</a>
					<a href="/games">الألعاب</a>
					<a href="/services">الخدمات</a>
				</nav>
			</section>

			<section class="footer-column">
				<h2>معلومات</h2>
				<nav aria-label="روابط المعلومات">
					<a href="/about">من نحن</a>
					<a href="/contact">اتصل بنا</a>
					<a href="/privacy">سياسة الخصوصية</a>
					<a href="/terms">اتفاقية الاستخدام</a>
				</nav>
			</section>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="site-container footer-bottom-inner">
			<p>&copy; {today.getFullYear()} HAKAMIQ جميع الحقوق محفوظة</p>
			<a href="/rss.xml">RSS</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: clamp(3rem, 7vw, 6rem);
		border-top: 1px solid var(--color-neutral-stroke-subtle);
		background:
			linear-gradient(135deg, rgba(232, 17, 35, 0.06), transparent 34%),
			#0d0f11;
		color: var(--color-neutral-foreground-3);
	}

	.footer-shell {
		display: grid;
		grid-template-columns: minmax(300px, 1.3fr) minmax(360px, 1fr);
		gap: clamp(2rem, 6vw, 5rem);
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
	}

	.footer-brand {
		max-width: 620px;
	}

	.footer-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--color-neutral-foreground-1);
		text-decoration: none;
	}

	.footer-mark {
		display: grid;
		width: 46px;
		height: 46px;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: var(--radius-large);
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.15), transparent 48%),
			var(--color-brand-background);
		box-shadow: 0 8px 22px rgba(232, 17, 35, 0.22);
		color: #fff;
		font-size: 1.35rem;
		font-weight: 850;
	}

	.footer-logo > span:last-child {
		display: grid;
		gap: 0.05rem;
	}

	.footer-logo strong {
		font-size: 1.25rem;
		font-weight: 800;
		letter-spacing: 0.045em;
	}

	.footer-logo small {
		color: var(--color-neutral-foreground-3);
		font-size: 0.72rem;
	}

	.footer-brand > p {
		max-width: 560px;
		margin-top: 1rem;
		color: var(--color-neutral-foreground-3);
		font-size: 0.9rem;
		line-height: 1.9;
	}

	.footer-social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	.footer-social a {
		display: inline-flex;
		min-height: 34px;
		align-items: center;
		justify-content: center;
		padding: 0 0.72rem;
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: 999px;
		background: var(--color-neutral-background-2);
		color: var(--color-neutral-foreground-2);
		font-size: 0.76rem;
		font-weight: 650;
		text-decoration: none;
		box-shadow: var(--shadow-2);
		transition:
			background var(--duration-fast) var(--curve-easy-ease),
			border-color var(--duration-fast) var(--curve-easy-ease),
			color var(--duration-fast) var(--curve-easy-ease);
	}

	.footer-social a:hover {
		border-color: var(--color-neutral-stroke-2);
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
	}

	.footer-links-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.footer-column {
		padding: 1.25rem;
		border: 1px solid var(--color-neutral-stroke-subtle);
		border-radius: var(--radius-xlarge);
		background: rgba(31, 34, 38, 0.64);
		box-shadow: var(--shadow-4);
		backdrop-filter: blur(14px);
	}

	.footer-column h2 {
		margin-bottom: 0.85rem;
		color: var(--color-neutral-foreground-1);
		font-size: 0.95rem;
		font-weight: 750;
	}

	.footer-column nav {
		display: grid;
		gap: 0.25rem;
	}

	.footer-column nav a {
		display: flex;
		min-height: 36px;
		align-items: center;
		padding: 0 0.65rem;
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		font-size: 0.84rem;
		text-decoration: none;
		transition:
			background var(--duration-fast) var(--curve-easy-ease),
			color var(--duration-fast) var(--curve-easy-ease);
	}

	.footer-column nav a:hover {
		background: var(--color-neutral-background-4);
		color: var(--color-neutral-foreground-1);
	}

	.footer-bottom {
		border-top: 1px solid var(--color-neutral-stroke-subtle);
		background: #090b0d;
	}

	.footer-bottom-inner {
		display: flex;
		min-height: 58px;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.78rem;
	}

	.footer-bottom a {
		padding: 0.25rem 0.55rem;
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		text-decoration: none;
	}

	.footer-bottom a:hover {
		background: var(--color-neutral-background-2);
		color: var(--color-neutral-foreground-1);
	}

	@media (max-width: 900px) {
		.footer-shell {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-brand {
			max-width: none;
		}
	}

	@media (max-width: 560px) {
		.site-footer {
			margin-top: 3rem;
		}

		.footer-shell {
			padding-block: 2rem;
		}

		.footer-links-grid {
			grid-template-columns: 1fr;
		}

		.footer-column {
			padding: 1rem;
		}

		.footer-bottom-inner {
			min-height: 68px;
			flex-direction: column;
			justify-content: center;
			gap: 0.25rem;
			text-align: center;
		}
	}
</style>
