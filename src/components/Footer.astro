---
const today = new Date();
---

<footer class="site-footer">
	<div class="site-container footer-main">
		<section class="footer-brand">
			<p>
				دليل عربي عملي للمحاكيات وتشغيل الألعاب وإعدادها وحلول المشاكل على الكمبيوتر وأجهزة الألعاب
			</p>

			<nav class="footer-social" aria-label="الشبكات الاجتماعية" dir="ltr">
				<a href="https://www.youtube.com/@HAKAMIQ" target="_blank" rel="noopener noreferrer">YouTube</a>
				<a href="https://discord.gg/WqgRrmAKpC" target="_blank" rel="noopener noreferrer">Discord</a>
				<a href="https://t.me/hakamiq0" target="_blank" rel="noopener noreferrer">Telegram</a>
			</nav>
		</section>

		<div class="footer-navigation">
			<nav class="footer-column" aria-label="روابط الموقع">
				<h2>الموقع</h2>
				<a href="/blog">المقالات</a>
				<a href="/services">خدمة المحاكيات</a>
				<a href="/about">من نحن</a>
				<a href="/contact">اتصل بنا</a>
			</nav>

			<nav class="footer-column" aria-label="الروابط القانونية">
				<h2>السياسات</h2>
				<a href="/privacy">سياسة الخصوصية</a>
				<a href="/terms">اتفاقية الاستخدام</a>
				<a href="/disclaimer">إخلاء المسؤولية</a>
				<a href="/rss.xml">RSS</a>
			</nav>

			<nav class="footer-column" aria-label="English pages" dir="ltr">
				<h2>English</h2>
				<a href="/en/about">About Us</a>
				<a href="/en/contact">Contact Us</a>
				<a href="/en/services">Emulator Service</a>
				<a href="/en/privacy">Privacy & Terms</a>
			</nav>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="site-container footer-bottom-inner">
			<p>&copy; {today.getFullYear()} HAKAMIQ جميع الحقوق محفوظة</p>
			<a href="/en/about" lang="en" dir="ltr">English</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: clamp(2.75rem, 5vw, 4.5rem);
		border-top: 1px solid var(--color-neutral-stroke-subtle);
		background:
			radial-gradient(circle at 8% 0%, rgba(215, 16, 71, 0.09), transparent 28rem),
			#0d0f11;
		color: var(--color-neutral-foreground-3);
	}

	.footer-main {
		display: grid;
		grid-template-columns: minmax(280px, 1.15fr) minmax(520px, 1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
		padding-block: clamp(2.25rem, 4vw, 3.5rem);
	}

	.footer-brand {
		max-width: 640px;
	}

	.footer-brand > p {
		max-width: 590px;
		margin: 0;
		color: var(--color-neutral-foreground-3);
		font-size: 0.83rem;
		line-height: 1.9;
	}

	.footer-social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 1rem;
	}

	.footer-social a {
		display: inline-flex;
		min-height: 32px;
		align-items: center;
		justify-content: center;
		padding-inline: 0.68rem;
		border: 1px solid var(--color-neutral-stroke-1);
		border-radius: 999px;
		background: rgba(31, 34, 38, 0.72);
		color: var(--color-neutral-foreground-2);
		font-size: 0.72rem;
		font-weight: 650;
		text-decoration: none;
	}

	.footer-social a:hover,
	.footer-social a:focus-visible {
		border-color: color-mix(in srgb, var(--color-brand-foreground) 35%, var(--color-neutral-stroke-1));
		background: rgba(215, 16, 71, 0.08);
		color: var(--color-neutral-foreground-1);
		outline: none;
	}

	.footer-navigation {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2.5vw, 2.25rem);
		padding-inline-start: clamp(0rem, 2vw, 1.5rem);
		border-inline-start: 1px solid var(--color-neutral-stroke-subtle);
	}

	.footer-column {
		display: grid;
		align-content: start;
		gap: 0.16rem;
	}

	.footer-column h2 {
		margin-bottom: 0.65rem;
		color: var(--color-neutral-foreground-1);
		font-size: 0.86rem;
		font-weight: 760;
	}

	.footer-column a {
		display: inline-flex;
		width: fit-content;
		min-height: 34px;
		align-items: center;
		padding-inline: 0.42rem;
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		font-size: 0.77rem;
		text-decoration: none;
	}

	.footer-column a:hover,
	.footer-column a:focus-visible {
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-1);
		outline: none;
	}

	.footer-bottom {
		border-top: 1px solid var(--color-neutral-stroke-subtle);
		background: #090b0d;
	}

	.footer-bottom-inner {
		display: flex;
		min-height: 54px;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.72rem;
	}

	.footer-bottom a {
		padding: 0.25rem 0.5rem;
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		text-decoration: none;
	}

	.footer-bottom a:hover,
	.footer-bottom a:focus-visible {
		background: var(--color-neutral-background-2);
		color: var(--color-neutral-foreground-1);
		outline: none;
	}

	@media (max-width: 980px) {
		.footer-main {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.footer-navigation {
			padding-block-start: 1.5rem;
			padding-inline-start: 0;
			border-block-start: 1px solid var(--color-neutral-stroke-subtle);
			border-inline-start: 0;
		}
	}

	@media (max-width: 620px) {
		.site-footer { margin-top: 2.5rem; }
		.footer-main { padding-block: 1.85rem; }
		.footer-navigation { grid-template-columns: 1fr 1fr; gap: 1rem; }
		.footer-column:last-child { grid-column: 1 / -1; }
		.footer-bottom-inner {
			min-height: 64px;
			flex-direction: column;
			justify-content: center;
			gap: 0.15rem;
			text-align: center;
		}
	}

	@media (max-width: 390px) {
		.footer-navigation { grid-template-columns: 1fr; }
		.footer-column:last-child { grid-column: auto; }
	}
</style>
