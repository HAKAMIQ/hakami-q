---
const today = new Date();
---

<footer class="site-footer" dir="rtl">
	<div class="site-container footer-row">
		<nav class="footer-legal" aria-label="الروابط القانونية">
			<a href="/privacy">سياسة الخصوصية</a>
			<a href="/terms">اتفاقية الاستخدام</a>
			<a href="/disclaimer">إخلاء المسؤولية</a>
		</nav>

		<p class="footer-copyright">
			<span class="copyright-latin" dir="ltr">&copy; {today.getFullYear()} HAKAMIQ</span>
			<span class="copyright-arabic" dir="rtl">جميع الحقوق محفوظة</span>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--spacing-480);
		border-top: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-3);
	}

	.footer-row {
		display: flex;
		min-height: 52px;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-240);
	}

	.footer-legal {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: var(--spacing-20);
	}

	.footer-legal a {
		display: inline-flex;
		min-height: 32px;
		align-items: center;
		padding-inline: var(--spacing-80);
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
		text-decoration: none;
		white-space: nowrap;
		transition:
			background var(--motion-duration-control) var(--curve-easy-ease),
			color var(--motion-duration-control) var(--curve-easy-ease);
	}

	.footer-legal a:hover,
	.footer-legal a:focus-visible {
		background: var(--color-subtle-background-hover);
		color: var(--color-neutral-foreground-1);
	}

	.footer-copyright {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.45em;
		margin: 0;
		direction: ltr;
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
		white-space: nowrap;
	}

	.copyright-latin,
	.copyright-arabic {
		unicode-bidi: isolate;
	}

	@media (max-width: 760px) {
		.footer-row {
			gap: var(--spacing-120);
		}

		.footer-legal {
			gap: 0;
		}

		.footer-legal a {
			padding-inline: var(--spacing-40);
		}
	}

	@media (max-width: 560px) {
		.footer-row {
			min-height: 72px;
			flex-wrap: wrap;
			justify-content: center;
			padding-block: var(--spacing-80);
			text-align: center;
		}

		.footer-legal {
			width: 100%;
			justify-content: center;
			flex-wrap: wrap;
		}
	}

	@media (pointer: coarse) {
		.footer-legal a {
			min-height: var(--control-height-touch);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-legal a {
			transition: none;
		}
	}
</style>
