---
const today = new Date();
---

<footer class="site-footer">
	<div class="site-container footer-grid">
		<section class="footer-brand">
			<a class="footer-logo" href="/">HAKAMIQ</a>
			<p>
				دليل عربي لشروحات المحاكيات وتشغيل الألعاب وحلول المشاكل على الكمبيوتر وأجهزة الألعاب
			</p>
		</section>

		<section>
			<h2>روابط الموقع</h2>
			<nav aria-label="روابط الموقع">
				<a href="/blog">المقالات</a>
				<a href="/emulators">المحاكيات</a>
				<a href="/games">الألعاب</a>
				<a href="/services">الخدمات</a>
			</nav>
		</section>

		<section>
			<h2>معلومات</h2>
			<nav aria-label="روابط المعلومات">
				<a href="/about">من نحن</a>
				<a href="/contact">اتصل بنا</a>
				<a href="/privacy">سياسة الخصوصية</a>
				<a href="/terms">اتفاقية الاستخدام</a>
			</nav>
		</section>

		<section>
			<h2>تابع HAKAMIQ</h2>
			<nav aria-label="الشبكات الاجتماعية">
				<a href="https://www.youtube.com/@HAKAMIQ" target="_blank" rel="noopener noreferrer">YouTube</a>
				<a href="https://discord.gg/WqgRrmAKpC" target="_blank" rel="noopener noreferrer">Discord</a>
				<a href="https://t.me/hakamiq0" target="_blank" rel="noopener noreferrer">Telegram</a>
			</nav>
		</section>
	</div>

	<div class="footer-bottom">
		<div class="site-container">
			<p>&copy; {today.getFullYear()} HAKAMIQ جميع الحقوق محفوظة</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--hq-border);
		background: #0d1014;
		color: var(--hq-muted);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: minmax(260px, 1.5fr) repeat(3, minmax(150px, 1fr));
		gap: 2rem;
		padding-block: 2.8rem;
	}

	.footer-brand {
		max-width: 420px;
	}

	.footer-logo {
		display: inline-block;
		margin-bottom: 0.8rem;
		color: var(--hq-text);
		font-size: 1.5rem;
		font-weight: 900;
		letter-spacing: 0.04em;
		text-decoration: none;
	}

	.footer-brand p {
		font-size: 0.92rem;
		line-height: 1.9;
	}

	h2 {
		margin-bottom: 0.85rem;
		font-size: 1rem;
	}

	nav {
		display: grid;
		gap: 0.45rem;
	}

	nav a {
		width: fit-content;
		color: var(--hq-muted);
		font-size: 0.88rem;
		text-decoration: none;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	nav a:hover {
		color: var(--hq-text);
		transform: translateX(-3px);
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.07);
		background: #0a0d10;
	}

	.footer-bottom .site-container {
		display: flex;
		min-height: 58px;
		align-items: center;
		justify-content: center;
		font-size: 0.82rem;
		text-align: center;
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.site-footer {
			margin-top: 3rem;
		}

		.footer-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding-block: 2rem;
		}
	}
</style>
