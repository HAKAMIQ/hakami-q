---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BlogSidebar from '../../components/fluent/BlogSidebar.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SkipLink from '../../components/SkipLink.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import '../../styles/blog-listing-page.css';

const PAGE_SIZE = 12;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const visiblePosts = posts.slice(0, PAGE_SIZE);
const pageHref = (page: number) => page <= 1 ? '/blog/' : `/blog/page/${page}/`;
const visiblePageNumbers = Array.from(new Set([1, 2, 3, totalPages]))
	.filter((page) => page >= 1 && page <= totalPages)
	.sort((a, b) => a - b);
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={`المقالات | ${SITE_TITLE}`} description={SITE_DESCRIPTION} canonicalPath="/blog/" />
		{totalPages > 1 && <link rel="next" href={new URL(pageHref(2), Astro.site ?? Astro.url)} />}
	</head>

	<body>
		<SkipLink />
		<Header />

		<main id="main-content" tabindex="-1">
			<h1 class="sr-only">المقالات</h1>

			<section class="posts-section" aria-label="قائمة المقالات">
				<div class="site-container blog-layout">
					<BlogSidebar posts={posts} />

					<div class="posts-content">
						<div class="posts-grid" id="posts-grid">
							{visiblePosts.map((post) => {
								const imageSrc = post.data.heroImageUrl ?? post.data.heroImage?.src;
								return (
									<article class="post-card fui-card fui-card--interactive">
										<a href={`/blog/${post.id}/`} aria-label={post.data.title}>
											<div class="post-image">
												{imageSrc ? (
													<img src={imageSrc} alt={post.data.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
												) : (
													<div class="image-placeholder">HAKAMIQ</div>
												)}

												{post.data.labels.length > 0 && (
													<span class="post-label fui-badge fui-badge--brand">{post.data.labels[0]}</span>
												)}

												<div class="post-title-overlay">
													<h2>{post.data.title}</h2>
												</div>
											</div>

											<div class="post-content">
												<p>{post.data.description}</p>
											</div>
										</a>
									</article>
								);
							})}
						</div>

						{totalPages > 1 && (
							<nav class="posts-pagination" aria-label="صفحات المقالات">
								{visiblePageNumbers.map((page, index) => {
									const previous = visiblePageNumbers[index - 1];
									return (
										<>
											{previous && page - previous > 1 && <span class="page-ellipsis" aria-hidden="true">…</span>}
											<a class="page-link" href={pageHref(page)} aria-current={page === 1 ? 'page' : undefined} aria-label={`الصفحة ${page}`}>
												{page}
											</a>
										</>
									);
								})}
								<a class="page-link" href={pageHref(2)} rel="next" aria-label="الصفحة التالية">التالي</a>
							</nav>
						)}
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<script>
	const params = new URLSearchParams(window.location.search);
	const category = params.get('category')?.trim().toLowerCase();
	const requestedPage = Number.parseInt(params.get('page') ?? '1', 10);

	if (category) {
		const categoryLink = document.querySelector<HTMLAnchorElement>(`[data-category-link="${CSS.escape(category)}"]`);
		if (categoryLink?.dataset.categoryLink) {
			window.location.replace(`/blog/category/${encodeURIComponent(categoryLink.dataset.categoryLink)}/`);
		}
	} else if (Number.isFinite(requestedPage) && requestedPage > 1) {
		window.location.replace(`/blog/page/${requestedPage}/`);
	}
</script>
