---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BlogSidebar from '../../components/fluent/BlogSidebar.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import {
	categoryNames,
	formatArabicDate,
	getPostCategories,
} from '../../data/blog-taxonomy';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postItems = posts.map((post) => ({
	post,
	categories: getPostCategories(post),
}));
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={`المقالات | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="page-hero">
				<div class="site-container">
					<span>مكتبة HAKAMIQ</span>
					<h1>المقالات والشروحات</h1>
					<p>شروحات المحاكيات وإعداد الألعاب وحلول المشاكل مرتبة من الأحدث إلى الأقدم</p>
					<strong id="post-count" data-total={posts.length}>{posts.length} مقال</strong>
				</div>
			</section>

			<section class="posts-section">
				<div
					id="category-data"
					data-categories={JSON.stringify(categoryNames)}
					hidden
				></div>

				<div class="site-container blog-layout">
					<div class="posts-content">
						<div class="filter-status" id="filter-status" hidden>
							<p>
								القسم الحالي
								<strong id="filter-name"></strong>
							</p>
							<a href="/blog">عرض جميع المقالات</a>
						</div>

						<p class="no-results" id="no-results" hidden>لا توجد مقالات مطابقة لهذا القسم حاليا</p>

						<div class="posts-grid" id="posts-grid">
							{
								postItems.map(({ post, categories }, index) => (
									<article
										class:list={['post-card', { featured: index === 0 }]}
										data-categories={categories.join(' ')}
									>
										<a href={`/blog/${post.id}/`}>
											<div class="post-image">
												{post.data.heroImageUrl ? (
													<img
														src={post.data.heroImageUrl}
														alt={post.data.title}
														loading={index === 0 ? 'eager' : 'lazy'}
														fetchpriority={index === 0 ? 'high' : 'auto'}
														referrerpolicy="no-referrer"
													/>
												) : (
													<div class="image-placeholder">HAKAMIQ</div>
												)}
											</div>

											<div class="post-content">
												{post.data.labels.length > 0 && <span class="post-label">{post.data.labels[0]}</span>}
												<h2>{post.data.title}</h2>
												<p>{post.data.description}</p>
												<time datetime={post.data.pubDate.toISOString()}>{formatArabicDate(post.data.pubDate)}</time>
											</div>
										</a>
									</article>
								))
							}
						</div>
					</div>

					<BlogSidebar posts={posts} />
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<script>
	const categoryData = document.querySelector<HTMLElement>('#category-data');
	const categoryNames = JSON.parse(categoryData?.dataset.categories ?? '{}') as Record<string, string>;
	const selectedCategory = new URLSearchParams(window.location.search).get('category')?.trim().toLowerCase();

	if (selectedCategory && categoryNames[selectedCategory]) {
		const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));
		const filterStatus = document.querySelector<HTMLElement>('#filter-status');
		const filterName = document.querySelector<HTMLElement>('#filter-name');
		const postCount = document.querySelector<HTMLElement>('#post-count');
		const noResults = document.querySelector<HTMLElement>('#no-results');
		let visibleCount = 0;
		let firstVisibleCard: HTMLElement | undefined;

		for (const card of cards) {
			card.classList.remove('featured');
			const categories = (card.dataset.categories ?? '').split(' ').filter(Boolean);
			const visible = categories.includes(selectedCategory);
			card.hidden = !visible;

			if (visible) {
				visibleCount += 1;
				firstVisibleCard ??= card;
			}
		}

		firstVisibleCard?.classList.add('featured');
		if (filterStatus) filterStatus.hidden = false;
		if (filterName) filterName.textContent = categoryNames[selectedCategory];
		if (postCount) postCount.textContent = `${visibleCount} مقال`;
		if (noResults) noResults.hidden = visibleCount !== 0;
	}
</script>

<style>
	.page-hero {
		padding: clamp(2.25rem, 4vw, 3.25rem) 0;
		border-bottom: 1px solid var(--color-neutral-stroke-alpha);
		background: var(--color-neutral-background-2);
	}

	.page-hero span {
		display: inline-block;
		margin-bottom: 6px;
		color: var(--color-brand-foreground);
		font-size: 0.75rem;
		font-weight: 650;
	}

	.page-hero h1 {
		margin: 0;
		color: var(--color-neutral-foreground-1);
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		line-height: 1.25;
	}

	.page-hero p {
		max-width: 700px;
		margin: 10px 0 0;
		color: var(--color-neutral-foreground-3);
		font-size: 0.92rem;
		line-height: 1.75;
	}

	.page-hero strong {
		display: inline-flex;
		min-height: 28px;
		align-items: center;
		margin-top: 14px;
		padding-inline: 10px;
		border-radius: 999px;
		background: var(--color-brand-background-2);
		color: var(--color-brand-foreground);
		font-size: 0.72rem;
		font-weight: 650;
	}

	.posts-section {
		padding: 28px 0 8px;
	}

	.blog-layout {
		display: grid;
		grid-template-columns: 304px minmax(0, 1fr);
		gap: 22px;
		align-items: start;
	}

	.posts-content {
		min-width: 0;
		grid-column: 2;
	}

	.blog-layout :global(.blog-sidebar) {
		grid-column: 1;
	}

	.filter-status {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 16px;
		padding: 10px 12px;
		border: 1px solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-medium);
		background: var(--color-neutral-background-2);
		box-shadow: var(--shadow-2);
	}

	.filter-status[hidden],
	.no-results[hidden],
	.post-card[hidden] {
		display: none;
	}

	.filter-status p {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		color: var(--color-neutral-foreground-3);
		font-size: 0.8rem;
	}

	.filter-status strong {
		color: var(--color-brand-foreground);
	}

	.filter-status a {
		display: inline-flex;
		min-height: 32px;
		align-items: center;
		padding-inline: 10px;
		border-radius: var(--radius-small);
		background: var(--color-brand-background-2);
		color: var(--color-brand-foreground);
		font-size: 0.75rem;
		font-weight: 650;
		text-decoration: none;
	}

	.filter-status a:hover,
	.filter-status a:focus-visible {
		background: var(--color-brand-background-2-hover);
		color: var(--color-neutral-foreground-1);
		outline: none;
	}

	.no-results {
		margin: 0 0 16px;
		padding: 24px;
		border: 1px dashed var(--color-neutral-stroke-1);
		border-radius: var(--radius-medium);
		color: var(--color-neutral-foreground-3);
		text-align: center;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}

	.post-card {
		overflow: hidden;
		border: 1px solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-2);
		box-shadow: var(--shadow-4);
		transition:
			border-color var(--duration-normal) var(--curve-easy-ease),
			box-shadow var(--duration-normal) var(--curve-easy-ease),
			transform var(--duration-normal) var(--curve-easy-ease);
	}

	.post-card:hover {
		border-color: var(--color-brand-stroke-2);
		box-shadow: var(--shadow-8);
		transform: translateY(-2px);
	}

	.post-card.featured {
		grid-column: span 2;
	}

	.post-card > a {
		display: grid;
		height: 100%;
		text-decoration: none;
	}

	.post-card.featured > a {
		grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.75fr);
	}

	.post-image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-neutral-background-3);
	}

	.featured .post-image {
		aspect-ratio: auto;
	}

	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--duration-slower) var(--curve-easy-ease);
	}

	.post-card:hover img {
		transform: scale(1.025);
	}

	.image-placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		min-height: 190px;
		place-items: center;
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-4);
		font-size: 1rem;
		font-weight: 700;
	}

	.post-content {
		display: flex;
		min-height: 190px;
		flex-direction: column;
		align-items: flex-start;
		padding: 16px;
	}

	.post-label {
		display: inline-flex;
		min-height: 24px;
		align-items: center;
		margin-bottom: 8px;
		padding-inline: 8px;
		border-radius: 999px;
		background: var(--color-brand-background-2);
		color: var(--color-brand-foreground);
		font-size: 0.66rem;
		font-weight: 650;
	}

	.post-content h2 {
		display: -webkit-box;
		overflow: hidden;
		margin: 0;
		color: var(--color-neutral-foreground-1);
		font-size: 1rem;
		line-height: 1.55;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.featured .post-content h2 {
		font-size: clamp(1.15rem, 2vw, 1.55rem);
	}

	.post-content p {
		display: -webkit-box;
		overflow: hidden;
		margin: 8px 0 0;
		color: var(--color-neutral-foreground-3);
		font-size: 0.8rem;
		line-height: 1.7;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.post-content time {
		margin-top: auto;
		padding-top: 14px;
		color: var(--color-neutral-foreground-3);
		font-size: 0.7rem;
	}

	@media (max-width: 1180px) {
		.blog-layout {
			grid-template-columns: 284px minmax(0, 1fr);
			gap: 18px;
		}

		.post-card.featured > a {
			grid-template-columns: 1fr;
		}

		.featured .post-image {
			aspect-ratio: 16 / 9;
		}
	}

	@media (max-width: 1020px) {
		.blog-layout {
			grid-template-columns: 1fr;
		}

		.posts-content,
		.blog-layout :global(.blog-sidebar) {
			grid-column: 1;
		}
	}

	@media (max-width: 680px) {
		.page-hero {
			padding: 2rem 0;
		}

		.posts-section {
			padding-top: 18px;
		}

		.filter-status {
			align-items: flex-start;
			flex-direction: column;
		}

		.posts-grid {
			grid-template-columns: 1fr;
			gap: 10px;
		}

		.post-card.featured {
			grid-column: auto;
		}

		.post-card > a,
		.post-card.featured > a {
			grid-template-columns: 116px minmax(0, 1fr);
		}

		.post-image,
		.featured .post-image {
			height: 100%;
			min-height: 132px;
			aspect-ratio: auto;
		}

		.post-content {
			min-height: 132px;
			padding: 12px;
		}

		.post-content p {
			display: none;
		}

		.post-content h2,
		.featured .post-content h2 {
			font-size: 0.88rem;
		}
	}

	@media (max-width: 420px) {
		.post-card > a,
		.post-card.featured > a {
			grid-template-columns: 96px minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card,
		.post-image img {
			transition: none;
		}
	}
</style>
