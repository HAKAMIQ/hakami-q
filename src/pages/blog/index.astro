const normalize = (value: string) =>
	value
		.normalize('NFKC')
		.replace(/\s+/g, ' ')
		.trim()
		.toLowerCase();

const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

const containsTerm = (text: string, term: string) => {
	const normalizedTerm = normalize(term);
	if (!normalizedTerm) return false;

	if (/^[a-z0-9][a-z0-9+.#-]{0,5}$/i.test(normalizedTerm)) {
		return new RegExp(
			`(^|[^a-z0-9])${escapeRegExp(normalizedTerm)}($|[^a-z0-9])`,
			'i',
		).test(text);
	}

	return text.includes(normalizedTerm);
};

const getPostCategories = (post: (typeof posts)[number]) => {
	const normalizedLabels = post.data.labels.map(normalize);
	const searchableText = normalize(
		[post.data.title, post.data.description, ...post.data.labels].join(' '),
	);
	const matchedCategories = new Set<string>();

	for (const category of categoryDefinitions) {
		const matchesLabel = (category.labels ?? []).some((label) =>
			normalizedLabels.includes(normalize(label)),
		);
		const matchesKeyword = (category.keywords ?? []).some((keyword) =>
			containsTerm(searchableText, keyword),
		);

		if (!matchesLabel && !matchesKeyword) continue;

		matchedCategories.add(category.slug);
		for (const parent of category.parents ?? []) matchedCategories.add(parent);
	}

	return Array.from(matchedCategories);
};

const categoryNames = Object.fromEntries(
	categoryDefinitions.map((category) => [category.slug, category.name]),
);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('ar-SA', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}).format(date);
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={`المقالات | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="page-hero">
				<div class="site-container">
					<span>مكتبة HAKAMIQ</span>
					<h1>المقالات والشروحات</h1>
					<p>
						جميع شروحات المحاكيات وإعداد الألعاب وحلول المشاكل مرتبة من الأحدث إلى الأقدم
					</p>
					<strong id="post-count" data-total={posts.length}>{posts.length} مقال</strong>
				</div>
			</section>

			<section class="posts-section">
				<div class="site-container">
					<div
						id="category-data"
						data-categories={JSON.stringify(categoryNames)}
						hidden
					></div>

					<div class="filter-status" id="filter-status" hidden>
						<p>
							القسم الحالي
							<strong id="filter-name"></strong>
						</p>
						<a href="/blog">عرض جميع المقالات</a>
					</div>

					<p class="no-results" id="no-results" hidden>
						لا توجد مقالات مطابقة لهذا القسم حاليا
					</p>

					<div class="posts-grid" id="posts-grid">
						{
							posts.map((post, index) => (
								<article
									class:list={['post-card', { featured: index === 0 }]}
									data-categories={getPostCategories(post).join(' ')}
								>
									<a href={`/blog/${post.id}/`}>
										<div class="post-image">
											{post.data.heroImageUrl ? (
												<img
													src={post.data.heroImageUrl}
													alt={post.data.title}
													loading={index === 0 ? 'eager' : 'lazy'}
													fetchpriority={index === 0 ? 'high' : 'auto'}
													referrerpolicy="no-referrer"
												/>
											) : (
												<div class="image-placeholder">HAKAMIQ</div>
											)}
										</div>

										<div class="post-content">
											{post.data.labels.length > 0 && (
												<span class="post-label">{post.data.labels[0]}</span>
											)}
											<h2>{post.data.title}</h2>
											<p>{post.data.description}</p>
											<time datetime={post.data.pubDate.toISOString()}>
												{formatDate(post.data.pubDate)}
											</time>
										</div>
									</a>
								</article>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<script>
	const categoryData = document.querySelector<HTMLElement>('#category-data');
	const categoryNames = JSON.parse(
		categoryData?.dataset.categories ?? '{}',
	) as Record<string, string>;

	const selectedCategory = new URLSearchParams(window.location.search)
		.get('category')
		?.trim()
		.toLowerCase();

	if (selectedCategory && categoryNames[selectedCategory]) {
		const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));
		const filterStatus = document.querySelector<HTMLElement>('#filter-status');
		const filterName = document.querySelector<HTMLElement>('#filter-name');
		const postCount = document.querySelector<HTMLElement>('#post-count');
		const noResults = document.querySelector<HTMLElement>('#no-results');

		let visibleCount = 0;
		let firstVisibleCard: HTMLElement | undefined;

		for (const card of cards) {
			card.classList.remove('featured');

			const categories = (card.dataset.categories ?? '').split(' ').filter(Boolean);
			const shouldShow = categories.includes(selectedCategory);

			card.hidden = !shouldShow;

			if (shouldShow) {
				visibleCount += 1;
				firstVisibleCard ??= card;
			}
		}

		firstVisibleCard?.classList.add('featured');

		if (filterStatus) filterStatus.hidden = false;
		if (filterName) filterName.textContent = categoryNames[selectedCategory];
		if (postCount) postCount.textContent = `${visibleCount} مقال`;
		if (noResults) noResults.hidden = visibleCount !== 0;
	}
</script>

<style>
	.page-hero {
