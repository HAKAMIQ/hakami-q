		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--hq-border);
		border-radius: 13px;
		background: var(--hq-card);
	}

	.filter-status[hidden] {
		display: none;
	}

	.filter-status p {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--hq-muted);
		font-size: 0.88rem;
	}

	.filter-status strong {
		color: #ff747a;
	}

	.filter-status a {
		padding: 0.45rem 0.7rem;
		border-radius: 9px;
		background: rgba(229, 21, 21, 0.12);
		color: #ff747a;
		font-size: 0.8rem;
		font-weight: 800;
		text-decoration: none;
	}

	.no-results {
		padding: 2rem;
		border: 1px dashed var(--hq-border);
		border-radius: var(--hq-radius-md);
		color: var(--hq-muted);
		text-align: center;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.post-card {
		overflow: hidden;
		border: 1px solid var(--hq-border);
		border-radius: var(--hq-radius-md);
		background: var(--hq-card);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.post-card[hidden] {
		display: none;
	}

	.post-card:hover {
		border-color: rgba(229, 21, 21, 0.48);
		transform: translateY(-4px);
	}

	.post-card.featured {
		grid-column: span 2;
	}

	.post-card > a {
		display: grid;
		height: 100%;
		text-decoration: none;
	}

	.post-image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #0d1014;
	}

	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.post-card:hover img {
		transform: scale(1.035);
	}

	.image-placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		place-items: center;
		background:
			linear-gradient(135deg, rgba(229, 21, 21, 0.19), transparent),
			#181c22;
		color: rgba(255, 255, 255, 0.28);
		font-size: 1.4rem;
		font-weight: 900;
	}

	.post-content {
		display: flex;
		min-height: 230px;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.1rem;
	}

	.post-label {
		margin-bottom: 0.6rem;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		background: rgba(229, 21, 21, 0.12);
		color: #ff7279;
		font-size: 0.7rem;
		font-weight: 800;
	}

	.post-content h2 {
		display: -webkit-box;
		overflow: hidden;
		font-size: 1.12rem;
		line-height: 1.55;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.featured .post-content h2 {
		font-size: clamp(1.25rem, 2.3vw, 1.75rem);
	}

	.post-content p {
		display: -webkit-box;
		overflow: hidden;
		margin-top: 0.65rem;
		color: var(--hq-muted);
		font-size: 0.86rem;
		line-height: 1.75;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.post-content time {
		margin-top: auto;
		padding-top: 1rem;
		color: var(--hq-muted);
		font-size: 0.74rem;
	}

	@media (max-width: 1050px) {
		.posts-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 680px) {
		.page-hero {
			padding: 2.5rem 0;
		}

		.filter-status {
			align-items: flex-start;
			flex-direction: column;
		}

		.posts-grid {
			grid-template-columns: 1fr;
			gap: 0.9rem;
		}

		.post-card.featured {
			grid-column: auto;
		}

		.post-card > a {
			grid-template-columns: 132px minmax(0, 1fr);
		}

		.post-image {
			height: 100%;
			min-height: 140px;
			aspect-ratio: auto;
		}

		.post-content {
			min-height: 140px;
			padding: 0.85rem;
