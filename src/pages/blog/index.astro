---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BlogSidebar from '../../components/fluent/BlogSidebar.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SkipLink from '../../components/SkipLink.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { categoryNames, formatArabicDate, getPostCategories } from '../../data/blog-taxonomy';

const DEFAULT_PAGE_SIZE = 12;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postItems = posts.map((post) => ({
	post,
	categories: getPostCategories(post),
}));

const postData = postItems.map(({ post, categories }) => ({
	title: post.data.title,
	description: post.data.description,
	href: `/blog/${post.id}/`,
	heroImageUrl: post.data.heroImageUrl ?? '',
	label: post.data.labels[0] ?? '',
	categories,
	dateIso: post.data.pubDate.toISOString(),
	dateText: formatArabicDate(post.data.pubDate),
}));

const initialItems = postItems.slice(0, DEFAULT_PAGE_SIZE);
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={`المقالات | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<SkipLink />
		<Header />

		<main id="main-content" tabindex="-1">
			<section class="page-hero">
				<div class="site-container hero-inner">
					<nav class="fui-breadcrumb" aria-label="مسار التنقل">
						<ol>
							<li><a href="/">الرئيسية</a></li>
							<li aria-current="page">المقالات</li>
						</ol>
					</nav>

					<div class="hero-copy">
						<span class="page-eyebrow">مكتبة HAKAMIQ</span>
						<h1>المقالات والشروحات</h1>
						<p>شروحات المحاكيات وإعداد الألعاب وحلول المشاكل مرتبة من الأحدث إلى الأقدم.</p>
						<strong class="fui-badge fui-badge--brand post-count" id="post-count" data-total={posts.length} aria-live="polite">{posts.length} مقال</strong>
					</div>
				</div>
			</section>

			<section class="posts-section" aria-label="قائمة المقالات">
				<div id="category-data" data-categories={JSON.stringify(categoryNames)} hidden></div>
				<script id="blog-post-data" type="application/json" set:html={JSON.stringify(postData).replace(/</g, '\\u003c')}></script>

				<div class="site-container blog-layout">
					<BlogSidebar posts={posts} />

					<div class="posts-content">
						<div class="filter-status fui-card" id="filter-status" role="status" aria-live="polite" hidden>
							<p><span>القسم الحالي</span><strong id="filter-name"></strong></p>
							<a class="fui-link" href="/blog">عرض جميع المقالات</a>
						</div>

						<div class="listing-toolbar fui-card" aria-label="خيارات عرض المقالات">
							<p id="listing-range" class="listing-range" aria-live="polite">عرض 1–{Math.min(DEFAULT_PAGE_SIZE, posts.length)} من {posts.length}</p>
							<div class="page-size-field">
								<label for="posts-per-page">عدد المقالات في الصفحة</label>
								<select id="posts-per-page" class="fui-select" aria-describedby="page-size-help">
									<option value="12" selected>12</option>
									<option value="24">24</option>
									<option value="36">36</option>
								</select>
								<span class="sr-only" id="page-size-help">يتم حفظ اختيارك على هذا الجهاز</span>
							</div>
						</div>

						<p class="no-results fui-card" id="no-results" role="status" aria-live="polite" hidden>
							لا توجد مقالات مطابقة لهذا القسم حاليًا.
						</p>

						<div class="posts-grid" id="posts-grid">
							{initialItems.map(({ post }) => (
								<article class="post-card fui-card fui-card--interactive">
									<a href={`/blog/${post.id}/`} aria-label={post.data.title}>
										<div class="post-image">
											{post.data.heroImageUrl ? (
												<img src={post.data.heroImageUrl} alt={post.data.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
											) : (
												<div class="image-placeholder">HAKAMIQ</div>
											)}
										</div>

										<div class="post-content">
											{post.data.labels.length > 0 && <span class="post-label fui-badge fui-badge--brand">{post.data.labels[0]}</span>}
											<h2>{post.data.title}</h2>
											<p>{post.data.description}</p>
											<time datetime={post.data.pubDate.toISOString()}>{formatArabicDate(post.data.pubDate)}</time>
										</div>
									</a>
								</article>
							))}
						</div>

						<nav class="posts-pagination" id="posts-pagination" aria-label="صفحات المقالات"></nav>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<script>
	type BlogListItem = {
		title: string;
		description: string;
		href: string;
		heroImageUrl: string;
		label: string;
		categories: string[];
		dateIso: string;
		dateText: string;
	};

	const initializeBlogPagination = () => {
		const grid = document.querySelector<HTMLElement>('#posts-grid');
		const dataElement = document.querySelector<HTMLScriptElement>('#blog-post-data');
		const categoryData = document.querySelector<HTMLElement>('#category-data');
		const postCount = document.querySelector<HTMLElement>('#post-count');
		const filterStatus = document.querySelector<HTMLElement>('#filter-status');
		const filterName = document.querySelector<HTMLElement>('#filter-name');
		const noResults = document.querySelector<HTMLElement>('#no-results');
		const range = document.querySelector<HTMLElement>('#listing-range');
		const pageSizeSelect = document.querySelector<HTMLSelectElement>('#posts-per-page');
		const pagination = document.querySelector<HTMLElement>('#posts-pagination');
		if (!grid || !dataElement || !categoryData || !postCount || !noResults || !range || !pageSizeSelect || !pagination) return;
		if (grid.dataset.paginationInitialized === 'true') return;
		grid.dataset.paginationInitialized = 'true';

		let items: BlogListItem[] = [];
		try { items = JSON.parse(dataElement.textContent || '[]'); } catch { items = []; }
		const names = JSON.parse(categoryData.dataset.categories ?? '{}') as Record<string, string>;
		const params = new URLSearchParams(window.location.search);
		const selectedCategory = params.get('category')?.trim().toLowerCase() ?? '';
		const allowedSizes = new Set([12, 24, 36]);
		const requestedSize = Number.parseInt(params.get('perPage') ?? '', 10);
		let storedSize = 12;
		try {
			const value = Number.parseInt(localStorage.getItem('hakamiq-posts-per-page') ?? '', 10);
			if (allowedSizes.has(value)) storedSize = value;
		} catch {}
		let pageSize = allowedSizes.has(requestedSize) ? requestedSize : storedSize;
		let currentPage = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);
		pageSizeSelect.value = String(pageSize);

		if (selectedCategory && names[selectedCategory]) {
			if (filterStatus) filterStatus.hidden = false;
			if (filterName) filterName.textContent = names[selectedCategory];
		}

		const createCard = (item: BlogListItem) => {
			const article = document.createElement('article');
			article.className = 'post-card fui-card fui-card--interactive';

			const link = document.createElement('a');
			link.href = item.href;
			link.setAttribute('aria-label', item.title);

			const imageWrap = document.createElement('div');
			imageWrap.className = 'post-image';
			if (item.heroImageUrl) {
				const image = document.createElement('img');
				image.src = item.heroImageUrl;
				image.alt = item.title;
				image.loading = 'lazy';
				image.decoding = 'async';
				image.referrerPolicy = 'no-referrer';
				imageWrap.append(image);
			} else {
				const placeholder = document.createElement('div');
				placeholder.className = 'image-placeholder';
				placeholder.textContent = 'HAKAMIQ';
				imageWrap.append(placeholder);
			}

			const content = document.createElement('div');
			content.className = 'post-content';
			if (item.label) {
				const label = document.createElement('span');
				label.className = 'post-label fui-badge fui-badge--brand';
				label.textContent = item.label;
				content.append(label);
			}
			const title = document.createElement('h2');
			title.textContent = item.title;
			content.append(title);
			if (item.description) {
				const description = document.createElement('p');
				description.textContent = item.description;
				content.append(description);
			}
			const time = document.createElement('time');
			time.dateTime = item.dateIso;
			time.textContent = item.dateText;
			content.append(time);

			link.append(imageWrap, content);
			article.append(link);
			return article;
		};

		const buildUrl = (page: number) => {
			const next = new URLSearchParams();
			if (selectedCategory && names[selectedCategory]) next.set('category', selectedCategory);
			if (page > 1) next.set('page', String(page));
			if (pageSize !== 12) next.set('perPage', String(pageSize));
			const query = next.toString();
			return query ? `/blog?${query}` : '/blog';
		};

		const appendPageLink = (label: string, page: number, current = false, ariaLabel?: string) => {
			const link = document.createElement('a');
			link.className = 'page-link';
			link.href = buildUrl(page);
			link.textContent = label;
			if (ariaLabel) link.setAttribute('aria-label', ariaLabel);
			if (current) link.setAttribute('aria-current', 'page');
			pagination.append(link);
		};

		const renderPagination = (totalPages: number) => {
			pagination.replaceChildren();
			pagination.hidden = totalPages <= 1;
			if (totalPages <= 1) return;

			if (currentPage > 1) appendPageLink('السابق', currentPage - 1, false, 'الصفحة السابقة');
			const pages = new Set<number>([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);
			const visiblePages = [...pages].filter((page) => page >= 1 && page <= totalPages).sort((a, b) => a - b);
			let previous = 0;
			for (const page of visiblePages) {
				if (previous && page - previous > 1) {
					const ellipsis = document.createElement('span');
					ellipsis.className = 'page-ellipsis';
					ellipsis.textContent = '…';
					ellipsis.setAttribute('aria-hidden', 'true');
					pagination.append(ellipsis);
				}
				appendPageLink(String(page), page, page === currentPage, `الصفحة ${page}`);
				previous = page;
			}
			if (currentPage < totalPages) appendPageLink('التالي', currentPage + 1, false, 'الصفحة التالية');
		};

		const render = () => {
			const filtered = selectedCategory && names[selectedCategory]
				? items.filter((item) => item.categories.includes(selectedCategory))
				: items;
			const total = filtered.length;
			const totalPages = Math.max(1, Math.ceil(total / pageSize));
			currentPage = Math.min(currentPage, totalPages);
			const start = (currentPage - 1) * pageSize;
			const visible = filtered.slice(start, start + pageSize);

			grid.replaceChildren(...visible.map(createCard));
			postCount.textContent = `${total} مقال`;
			noResults.hidden = total !== 0;
			if (total === 0) range.textContent = 'لا توجد مقالات للعرض';
			else range.textContent = `عرض ${start + 1}–${Math.min(start + visible.length, total)} من ${total}`;
			renderPagination(totalPages);

			const requestedPage = Number.parseInt(params.get('page') ?? '1', 10) || 1;
			if (requestedPage !== currentPage) history.replaceState(null, '', buildUrl(currentPage));
		};

		pageSizeSelect.addEventListener('change', () => {
			const nextSize = Number.parseInt(pageSizeSelect.value, 10);
			if (!allowedSizes.has(nextSize)) return;
			pageSize = nextSize;
			currentPage = 1;
			try { localStorage.setItem('hakamiq-posts-per-page', String(pageSize)); } catch {}
			window.location.href = buildUrl(1);
		});

		render();
	};

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeBlogPagination, { once: true });
	else initializeBlogPagination();
	document.addEventListener('astro:page-load', initializeBlogPagination);
</script>

<style is:global>
	.page-hero {
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		background: var(--color-neutral-background-3);
	}

	.hero-inner { padding-block: var(--spacing-240) var(--spacing-320); }
	.hero-copy { max-width: 760px; margin-top: var(--spacing-160); }

	.page-eyebrow {
		display: block;
		margin-bottom: var(--spacing-40);
		color: var(--color-brand-foreground);
		font-size: var(--font-size-caption-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-caption-1);
	}

	.hero-copy h1 { font-size: var(--font-size-title-1); line-height: var(--line-height-title-1); }
	.hero-copy p { margin-top: var(--spacing-80); color: var(--color-neutral-foreground-3); font-size: var(--font-size-body-1); line-height: var(--line-height-body-1); }
	.post-count { margin-top: var(--spacing-120); }
	.posts-section { padding-block: var(--spacing-240) var(--spacing-80); }

	.blog-layout {
		display: grid;
		grid-template-columns: 288px minmax(0, 1fr);
		gap: var(--spacing-240);
		align-items: start;
	}

	.posts-content { min-width: 0; grid-column: 2; }
	.blog-layout .sidebar-region { min-width: 0; grid-column: 1; }

	.filter-status,
	.listing-toolbar {
		display: flex;
		min-height: 44px;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-120);
		margin-bottom: var(--spacing-120);
		padding: var(--spacing-80) var(--spacing-120);
	}

	.filter-status[hidden],
	.no-results[hidden],
	.posts-pagination[hidden] { display: none; }

	.filter-status p { display: flex; align-items: center; gap: var(--spacing-80); color: var(--color-neutral-foreground-3); font-size: var(--font-size-body-1); line-height: var(--line-height-body-1); }
	.filter-status strong { color: var(--color-neutral-foreground-1); font-weight: var(--font-weight-semibold); }
	.listing-range { color: var(--color-neutral-foreground-3); font-size: var(--font-size-body-1); line-height: var(--line-height-body-1); }

	.page-size-field { display: flex; align-items: center; gap: var(--spacing-80); }
	.page-size-field label { color: var(--color-neutral-foreground-2); font-size: var(--font-size-body-1); font-weight: var(--font-weight-semibold); }
	.page-size-field select { min-width: 76px; min-height: 36px; padding-inline: var(--spacing-80); border: var(--stroke-thin) solid var(--color-neutral-stroke-1); border-radius: var(--radius-medium); background: var(--color-neutral-background-1); color: var(--color-neutral-foreground-1); }

	.no-results {
		margin-bottom: var(--spacing-160);
		padding: var(--spacing-240);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-body-1);
		line-height: var(--line-height-body-1);
		text-align: center;
	}

	.posts-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--spacing-160); }
	.post-card { min-width: 0; overflow: hidden; }

	.post-card > a {
		display: flex;
		height: 100%;
		min-width: 0;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
	}

	.post-image { aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-neutral-background-3); }
	.post-image img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--duration-slow) var(--curve-decelerate-mid); }
	.post-card:hover .post-image img { transform: scale(1.02); }

	.image-placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		place-items: center;
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-4);
		font-size: var(--font-size-subtitle-2);
		font-weight: var(--font-weight-semibold);
	}

	.post-content {
		display: flex;
		min-height: 164px;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		padding: var(--spacing-160);
	}

	.post-label { margin-bottom: var(--spacing-80); }

	.post-content h2 {
		display: -webkit-box;
		overflow: hidden;
		font-size: var(--font-size-subtitle-2);
		line-height: var(--line-height-subtitle-2);
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.post-content p {
		display: -webkit-box;
		overflow: hidden;
		margin-top: var(--spacing-80);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-body-1);
		line-height: var(--line-height-body-1);
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.post-content time {
		margin-top: auto;
		padding-top: var(--spacing-120);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
		line-height: var(--line-height-caption-1);
	}

	.posts-pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-60);
		margin-top: var(--spacing-240);
		padding-block: var(--spacing-80);
		flex-wrap: wrap;
	}

	.posts-pagination .page-link {
		display: inline-flex;
		min-width: 36px;
		min-height: 36px;
		align-items: center;
		justify-content: center;
		padding-inline: var(--spacing-100);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-medium);
		background: var(--color-subtle-background);
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-body-1);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
	}

	.posts-pagination .page-link:hover,
	.posts-pagination .page-link:focus-visible {
		border-color: var(--color-neutral-stroke-1-hover);
		background: var(--color-subtle-background-hover);
		color: var(--color-neutral-foreground-1);
	}

	.posts-pagination .page-link[aria-current='page'] {
		border-color: var(--color-brand-stroke-1);
		background: var(--color-brand-background-2);
		color: var(--color-brand-foreground-strong);
	}

	.posts-pagination .page-ellipsis { padding-inline: var(--spacing-40); color: var(--color-neutral-foreground-4); }

	@media (max-width: 1180px) {
		.blog-layout { grid-template-columns: 272px minmax(0, 1fr); gap: var(--spacing-160); }
	}

	@media (max-width: 1023px) {
		.blog-layout { grid-template-columns: 1fr; }
		.posts-content,
		.blog-layout .sidebar-region { grid-column: 1; }
		.blog-layout .sidebar-region { grid-row: 1; }
		.posts-content { grid-row: 2; }
	}

	@media (max-width: 639px) {
		.hero-inner { padding-block: var(--spacing-160) var(--spacing-240); }
		.hero-copy { margin-top: var(--spacing-120); }
		.hero-copy h1 { font-size: var(--font-size-title-2); line-height: var(--line-height-title-2); }
		.posts-section { padding-top: var(--spacing-160); }
		.filter-status,
		.listing-toolbar { align-items: flex-start; flex-direction: column; }
		.page-size-field { width: 100%; justify-content: space-between; }
		.posts-grid { grid-template-columns: 1fr; gap: var(--spacing-100); }
		.post-card > a { display: grid; grid-template-columns: 112px minmax(0, 1fr); }
		.post-image { height: 100%; min-height: 132px; aspect-ratio: auto; }
		.post-content { min-height: 132px; padding: var(--spacing-120); }
		.post-content p { display: none; }
		.post-content h2 { font-size: var(--font-size-body-1); line-height: var(--line-height-body-1); }
		.posts-pagination .page-link { min-width: 40px; min-height: 40px; }
	}

	@media (max-width: 420px) {
		.post-card > a { grid-template-columns: 96px minmax(0, 1fr); }
	}
</style>
