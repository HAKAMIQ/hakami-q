---
import { type CollectionEntry, getCollection } from 'astro:content';
import ArticleDiscovery from '../../components/ArticleDiscovery.astro';
import ArticleSeo from '../../components/ArticleSeo.astro';
import BlogPost from '../../layouts/BlogPost.astro';
import '../../styles/article-content-compat.css';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const rawBody = post.body ?? '';
const ARTICLE_STYLE_SCOPE_MARKER = '/* HAKAMIQ_ARTICLE_SCOPE */';

function decodeEntities(value: string) {
	return value
		.replace(/&nbsp;/gi, ' ')
		.replace(/&amp;/gi, '&')
		.replace(/&lt;/gi, '<')
		.replace(/&gt;/gi, '>')
		.replace(/&quot;/gi, '"')
		.replace(/&#39;|&apos;/gi, "'")
		.replace(/&#(\d+);/g, (_, code) => String.fromCodePoint(Number(code)))
		.replace(/&#x([\da-f]+);/gi, (_, code) => String.fromCodePoint(Number.parseInt(code, 16)));
}

function escapeAttribute(value: string) {
	return value
		.replace(/&/g, '&amp;')
		.replace(/"/g, '&quot;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;');
}

function comparableHeading(value: string) {
	return decodeEntities(value.replace(/<[^>]+>/g, ' '))
		.normalize('NFKC')
		.replace(/[\u064B-\u065F\u0670]/g, '')
		.replace(/[أإآ]/g, 'ا')
		.replace(/ى/g, 'ي')
		.replace(/[^\p{L}\p{N}]+/gu, ' ')
		.trim()
		.toLocaleLowerCase('ar');
}

function removeDuplicateArticleHeading(html: string, title: string) {
	const expected = comparableHeading(title);
	let removed = false;

	let result = html.replace(
		/<h([1-3])\b[^>]*>([\s\S]*?)<\/h\1>/gi,
		(full, _level, inner) => {
			if (!removed && comparableHeading(inner) === expected) {
				removed = true;
				return '';
			}
			return full;
		},
	);

	if (!removed) {
		result = result.replace(/^\s{0,3}(#{1,3})\s+(.+?)\s*#*\s*$/m, (full, _marks, heading) => {
			if (comparableHeading(heading) === expected) {
				removed = true;
				return '';
			}
			return full;
		});
	}

	return result;
}

function scopeLegacyStyleBlocks(html: string) {
	return html.replace(/<style\b([^>]*)>([\s\S]*?)<\/style>/gi, (full, attributes = '', css = '') => {
		const source = String(css);
		if (source.includes('HAKAMIQ_ARTICLE_SCOPE')) return full;

		// Imported themes may use :root variables and broad selectors such as p,
		// h2 or code. Keep those rules useful inside the article without allowing
		// them to restyle the site header, navigation or footer. Legacy !important
		// flags are intentionally softened so the site compatibility contract can
		// guarantee contrast and media sizing.
		const scopedCss = source
			.replace(/\s*!important\b/gi, '')
			.replace(/:root\b/gi, ':scope');

		return `<style${attributes}>\n${ARTICLE_STYLE_SCOPE_MARKER}\n@scope (.article-content) {\n${scopedCss.trim()}\n}\n</style>`;
	});
}

function softenInlineLegacyPriorities(html: string) {
	return html.replace(/\bstyle\s*=\s*(["'])([\s\S]*?)\1/gi, (_full, quote, declaration) => {
		const softened = String(declaration).replace(/\s*!important\b/gi, '');
		return `style=${quote}${softened}${quote}`;
	});
}

function normalizeLegacyArticleMarkup(html: string, articleTitle: string) {
	let result = html.replace(/^\s*---\s*$/gm, '<hr />');

	// The page template owns the page landmark and H1. Preserve legacy content
	// while preventing nested <main> landmarks or secondary page-level H1s.
	result = result
		.replace(/<main\b([^>]*)>/gi, '<div$1>')
		.replace(/<\/main>/gi, '</div>')
		.replace(/<h1\b([^>]*)>/gi, '<h2$1>')
		.replace(/<\/h1>/gi, '</h2>');

	result = result.replace(/<img\b[^>]*>/gi, (tag) => {
		let normalized = tag.replace(
			/(\bsrc\s*=\s*["'])(https:\/\/blogger\.googleusercontent\.com\/[^"']+)(["'])/i,
			(_match, prefix, url, suffix) => {
				const upgraded = String(url).replace(
					/\/s(?:32|72|96|144|160|200|220|240|320|400|480|512|600|640)(-[^/]+)?\//i,
					(_segment, modifier = '') => `/s1280${modifier}/`,
				);
				return `${prefix}${upgraded}${suffix}`;
			},
		);

		if (!/\balt\s*=/i.test(normalized)) {
			const titleAttribute = normalized.match(/\btitle\s*=\s*["']([^"']+)["']/i)?.[1];
			const fallback = titleAttribute
				? decodeEntities(titleAttribute)
				: `صورة توضيحية ضمن مقال ${articleTitle}`;
			normalized = normalized.replace(/^<img\b/i, `<img alt="${escapeAttribute(fallback)}"`);
		}
		if (!/\bloading\s*=/i.test(normalized)) normalized = normalized.replace(/^<img\b/i, '<img loading="lazy"');
		if (!/\bdecoding\s*=/i.test(normalized)) normalized = normalized.replace(/^<img\b/i, '<img decoding="async"');
		return normalized;
	});

	result = result.replace(/<iframe\b[^>]*>/gi, (tag) => {
		if (/\bloading\s*=/i.test(tag)) return tag;
		return tag.replace(/^<iframe\b/i, '<iframe loading="lazy"');
	});

	result = result.replace(/<a\b[^>]*\btarget\s*=\s*["']_blank["'][^>]*>/gi, (tag) => {
		const relMatch = tag.match(/\brel\s*=\s*(["'])([^"']*)\1/i);
		if (!relMatch) return tag.replace(/^<a\b/i, '<a rel="noopener noreferrer"');
		const tokens = new Set(relMatch[2].split(/\s+/).filter(Boolean).map((token) => token.toLowerCase()));
		tokens.add('noopener');
		tokens.add('noreferrer');
		return tag.replace(relMatch[0], `rel=${relMatch[1]}${[...tokens].join(' ')}${relMatch[1]}`);
	});

	result = scopeLegacyStyleBlocks(result);
	result = softenInlineLegacyPriorities(result);

	return result;
}

const renderedBody = normalizeLegacyArticleMarkup(
	removeDuplicateArticleHeading(rawBody, post.data.title),
	post.data.title,
);
---

<BlogPost {...post.data}>
	<ArticleSeo {...post.data} />
	<div class="article-compat-root" data-hq-article-compat="v1">
		<Fragment set:html={renderedBody} />
	</div>
	<ArticleDiscovery post={post} posts={allPosts} />
</BlogPost>
