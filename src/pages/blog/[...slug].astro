---
import { type CollectionEntry, getCollection } from 'astro:content';
import ArticleDiscovery from '../../components/ArticleDiscovery.astro';
import ArticleSeo from '../../components/ArticleSeo.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import { categoryDefinitions, getPostCategories } from '../../data/blog-taxonomy';
import BlogPost from '../../layouts/BlogPost.astro';
import '../../styles/article-content-compat.css';
import '../../styles/article-polish.css';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;
type TocItem = { id: string; text: string; level: 2 | 3 };

const post = Astro.props;
(Astro.locals as { seoImage?: CollectionEntry<'blog'>['data']['heroImage'] | string }).seoImage =
	post.data.heroImageUrl ?? post.data.heroImage;
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const rawBody = post.body ?? '';
const ARTICLE_STYLE_SCOPE_MARKER = '/* HAKAMIQ_ARTICLE_SCOPE */';
const broadCategorySlugs = new Set([
	'nintendo',
	'nintendo-handhelds',
	'playstation',
	'playstation-handhelds',
	'xbox',
	'sega',
	'other-consoles',
	'multi-system',
]);
const postCategorySlugs = getPostCategories(post);
const primaryCategory =
	categoryDefinitions.find(
		(category) => postCategorySlugs.includes(category.slug) && !broadCategorySlugs.has(category.slug),
	) ??
	categoryDefinitions.find((category) => postCategorySlugs.includes(category.slug)) ??
	null;

function decodeEntities(value: string) {
	return value
		.replace(/&nbsp;/gi, ' ')
		.replace(/&amp;/gi, '&')
		.replace(/&lt;/gi, '<')
		.replace(/&gt;/gi, '>')
		.replace(/&quot;/gi, '"')
		.replace(/&#39;|&apos;/gi, "'")
		.replace(/&#(\d+);/g, (_, code) => String.fromCodePoint(Number(code)))
		.replace(/&#x([\da-f]+);/gi, (_, code) => String.fromCodePoint(Number.parseInt(code, 16)));
}

function escapeAttribute(value: string) {
	return value
		.replace(/&/g, '&amp;')
		.replace(/"/g, '&quot;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;');
}

function plainText(value: string) {
	return decodeEntities(value.replace(/<[^>]+>/g, ' '))
		.replace(/\s+/g, ' ')
		.trim();
}

function comparableHeading(value: string) {
	return plainText(value)
		.normalize('NFKC')
		.replace(/[\u064B-\u065F\u0670]/g, '')
		.replace(/[أإآ]/g, 'ا')
		.replace(/ى/g, 'ي')
		.replace(/[^\p{L}\p{N}]+/gu, ' ')
		.trim()
		.toLocaleLowerCase('ar');
}

function headingSlug(value: string, fallbackIndex: number) {
	const slug = plainText(value)
		.normalize('NFKC')
		.toLocaleLowerCase('ar')
		.replace(/[\u064B-\u065F\u0670]/g, '')
		.replace(/[^\p{L}\p{N}]+/gu, '-')
		.replace(/^-+|-+$/g, '')
		.slice(0, 96);
	return slug || `section-${fallbackIndex}`;
}

function removeDuplicateArticleHeading(html: string, title: string) {
	const expected = comparableHeading(title);
	let removed = false;

	let result = html.replace(
		/<h([1-3])\b[^>]*>([\s\S]*?)<\/h\1>/gi,
		(full, _level, inner) => {
			if (!removed && comparableHeading(inner) === expected) {
				removed = true;
				return '';
			}
			return full;
		},
	);

	if (!removed) {
		result = result.replace(/^\s{0,3}(#{1,3})\s+(.+?)\s*#*\s*$/m, (full, _marks, heading) => {
			if (comparableHeading(heading) === expected) {
				removed = true;
				return '';
			}
			return full;
		});
	}

	return result;
}

function scopeLegacyStyleBlocks(html: string) {
	return html.replace(/<style\b([^>]*)>([\s\S]*?)<\/style>/gi, (full, attributes = '', css = '') => {
		const source = String(css);
		if (source.includes('HAKAMIQ_ARTICLE_SCOPE')) return full;

		const scopedCss = source
			.replace(/\s*!important\b/gi, '')
			.replace(/:root\b/gi, ':scope');

		return `<style${attributes}>\n${ARTICLE_STYLE_SCOPE_MARKER}\n@scope (.article-content) {\n${scopedCss.trim()}\n}\n</style>`;
	});
}

function softenInlineLegacyPriorities(html: string) {
	return html.replace(/\bstyle\s*=\s*(["'])([\s\S]*?)\1/gi, (_full, quote, declaration) => {
		const softened = String(declaration).replace(/\s*!important\b/gi, '');
		return `style=${quote}${softened}${quote}`;
	});
}

function ensureHeadingIds(html: string) {
	const usedIds = new Set<string>();
	let headingIndex = 0;

	return html.replace(/<h([2-4])\b([^>]*)>([\s\S]*?)<\/h\1>/gi, (full, rawLevel, rawAttributes, inner) => {
		const text = plainText(inner);
		if (!text) return full;

		headingIndex += 1;
		let attributes = String(rawAttributes ?? '');
		const idMatch = attributes.match(/\bid\s*=\s*(["'])([^"']+)\1/i);
		let id = idMatch?.[2] || headingSlug(text, headingIndex);
		const baseId = id;
		let suffix = 2;
		while (usedIds.has(id)) id = `${baseId}-${suffix++}`;
		usedIds.add(id);

		if (idMatch) {
			attributes = attributes.replace(idMatch[0], `id="${escapeAttribute(id)}"`);
		} else {
			attributes += ` id="${escapeAttribute(id)}"`;
		}

		return `<h${rawLevel}${attributes}>${inner}</h${rawLevel}>`;
	});
}

function extractTocItems(html: string): TocItem[] {
	return [...html.matchAll(/<h([23])\b[^>]*\bid=["']([^"']+)["'][^>]*>([\s\S]*?)<\/h\1>/gi)]
		.map((match) => ({
			id: decodeEntities(match[2]),
			text: plainText(match[3]),
			level: Number(match[1]) as 2 | 3,
		}))
		.filter((item) => item.text.length > 0);
}

function normalizeLegacyArticleMarkup(html: string, articleTitle: string) {
	let result = html
		.replace(/^\s*---\s*$/gm, '<hr />')
		.replace(/<p\b[^>]*>(?:\s|&nbsp;|<br\s*\/?\s*>)*<\/p>/gi, '')
		.replace(/(?:<br\s*\/?\s*>\s*){4,}/gi, '<br /><br />');

	// The page template owns the page landmark and H1. Preserve the article's
	// inner structure while removing invalid nested page-level semantics.
	result = result
		.replace(/<main\b([^>]*)>/gi, '<div$1>')
		.replace(/<\/main>/gi, '</div>')
		.replace(/<h1\b([^>]*)>/gi, '<h2$1>')
		.replace(/<\/h1>/gi, '</h2>');

	let imageIndex = 0;
	result = result.replace(/<img\b[^>]*>/gi, (tag) => {
		const currentImageIndex = imageIndex++;
		let normalized = tag.replace(
			/(\bsrc\s*=\s*["'])(https:\/\/blogger\.googleusercontent\.com\/[^"']+)(["'])/i,
			(_match, prefix, url, suffix) => {
				const upgraded = String(url).replace(
					/\/s(?:32|72|96|144|160|200|220|240|320|400|480|512|600|640)(-[^/]+)?\//i,
					(_segment, modifier = '') => `/s1280${modifier}/`,
				);
				return `${prefix}${upgraded}${suffix}`;
			},
		);

		const altMatch = normalized.match(/\balt\s*=\s*(["'])([^"']*)\1/i);
		if (!altMatch || !plainText(altMatch[2])) {
			const titleAttribute = normalized.match(/\btitle\s*=\s*["']([^"']+)["']/i)?.[1];
			const fallback = titleAttribute && plainText(titleAttribute)
				? plainText(titleAttribute)
				: `صورة من مقال ${articleTitle}`;
			if (altMatch) {
				normalized = normalized.replace(altMatch[0], `alt="${escapeAttribute(fallback)}"`);
			} else {
				normalized = normalized.replace(/^<img\b/i, `<img alt="${escapeAttribute(fallback)}"`);
			}
		}

		// Keep the first article image eligible for early loading; defer the rest.
		if (currentImageIndex > 0 && !/\bloading\s*=/i.test(normalized)) {
			normalized = normalized.replace(/^<img\b/i, '<img loading="lazy"');
		}
		if (!/\bdecoding\s*=/i.test(normalized)) normalized = normalized.replace(/^<img\b/i, '<img decoding="async"');
		return normalized;
	});

	result = result.replace(/<iframe\b[^>]*>/gi, (tag) => {
		let normalized = tag;
		if (!/\bloading\s*=/i.test(normalized)) normalized = normalized.replace(/^<iframe\b/i, '<iframe loading="lazy"');
		if (!/\btitle\s*=/i.test(normalized)) {
			const src = normalized.match(/\bsrc\s*=\s*["']([^"']+)["']/i)?.[1] ?? '';
			const label = /youtube(?:-nocookie)?\.com|youtu\.be/i.test(src)
				? `فيديو ضمن مقال ${articleTitle}`
				: `محتوى مضمن ضمن مقال ${articleTitle}`;
			normalized = normalized.replace(/^<iframe\b/i, `<iframe title="${escapeAttribute(label)}"`);
		}
		return normalized;
	});

	result = result.replace(/<a\b[^>]*\btarget\s*=\s*["']_blank["'][^>]*>/gi, (tag) => {
		const relMatch = tag.match(/\brel\s*=\s*(["'])([^"']*)\1/i);
		if (!relMatch) return tag.replace(/^<a\b/i, '<a rel="noopener noreferrer"');
		const tokens = new Set(relMatch[2].split(/\s+/).filter(Boolean).map((token) => token.toLowerCase()));
		tokens.add('noopener');
		tokens.add('noreferrer');
		return tag.replace(relMatch[0], `rel=${relMatch[1]}${[...tokens].join(' ')}${relMatch[1]}`);
	});

	result = scopeLegacyStyleBlocks(result);
	result = softenInlineLegacyPriorities(result);
	result = ensureHeadingIds(result);

	return result;
}

const renderedBody = normalizeLegacyArticleMarkup(
	removeDuplicateArticleHeading(rawBody, post.data.title),
	post.data.title,
);
const tocItems = extractTocItems(renderedBody);
---

<BlogPost {...post.data}>
	<ArticleSeo {...post.data} primaryCategory={primaryCategory} />
	<ArticleToc items={tocItems} />
	<div class="article-compat-root" data-hq-article-compat="v1">
		<Fragment set:html={renderedBody} />
	</div>
	<ArticleDiscovery post={post} posts={allPosts} />
</BlogPost>
