---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import SkipLink from '../../../components/SkipLink.astro';
import { SITE_TITLE } from '../../../consts';
import {
	categoryDefinitions,
	formatArabicDate,
	getPostCategories,
	type CategoryDefinition,
} from '../../../data/blog-taxonomy';

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	return categoryDefinitions.flatMap((category) => {
		const hasPosts = posts.some((post) => getPostCategories(post).includes(category.slug));
		return hasPosts
			? [{ params: { slug: category.slug }, props: { category } }]
			: [];
	});
}

interface Props {
	category: CategoryDefinition;
}

const { category } = Astro.props;
const posts = (await getCollection('blog'))
	.filter((post) => getPostCategories(post).includes(category.slug))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const description = `شروحات وأدلة ومقالات HAKAMIQ حول ${category.name}، مع أحدث مواضيع المحاكيات والإعدادات والتحديثات المرتبطة بهذا القسم.`;
const siteURL = Astro.site ?? Astro.url;
const canonicalURL = new URL(`/blog/category/${category.slug}/`, siteURL).href;
const categorySchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `${category.name} | ${SITE_TITLE}`,
	description,
	url: canonicalURL,
	inLanguage: 'ar',
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: posts.length,
		itemListElement: posts.map((post, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: post.data.title,
			url: new URL(`/blog/${post.id}/`, siteURL).href,
		})),
	},
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'الرئيسية', item: new URL('/', siteURL).href },
		{ '@type': 'ListItem', position: 2, name: 'المقالات', item: new URL('/blog/', siteURL).href },
		{ '@type': 'ListItem', position: 3, name: category.name, item: canonicalURL },
	],
};
const serializeJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={`${category.name} | ${SITE_TITLE}`} description={description} />
		<script type="application/ld+json" set:html={serializeJsonLd(categorySchema)}></script>
		<script type="application/ld+json" set:html={serializeJsonLd(breadcrumbSchema)}></script>
	</head>

	<body>
		<SkipLink />
		<Header />

		<main id="main-content" tabindex="-1" class="category-main">
			<div class="category-shell">
				<nav class="category-breadcrumb" aria-label="مسار الصفحة">
					<a href="/">الرئيسية</a>
					<span aria-hidden="true">/</span>
					<a href="/blog/">المقالات</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{category.name}</span>
				</nav>

				<header class="category-header">
					<div>
						<span class="category-eyebrow">قسم المقالات</span>
						<h1>{category.name}</h1>
						<p>{description}</p>
					</div>
					<strong class="category-count">{posts.length} مقال</strong>
				</header>

				<section aria-labelledby="category-posts-title">
					<div class="category-section-heading">
						<h2 id="category-posts-title">مقالات {category.name}</h2>
						<a href="/blog/">عرض جميع المقالات</a>
					</div>

					<div class="category-grid">
						{posts.map((post) => (
							<article class="category-card">
								<a href={`/blog/${post.id}/`}>
									<span class="category-card__date">{formatArabicDate(post.data.pubDate)}</span>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<span class="category-card__action">قراءة المقال</span>
								</a>
							</article>
						))}
					</div>
				</section>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.category-main {
		padding-block: clamp(var(--spacing-200), 3vw, var(--spacing-360));
	}

	.category-shell {
		width: min(100% - 32px, 1280px);
		margin-inline: auto;
	}

	.category-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-80);
		margin-bottom: var(--spacing-160);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
	}

	.category-breadcrumb a,
	.category-section-heading a {
		color: var(--color-brand-foreground-link);
		text-decoration: none;
	}

	.category-breadcrumb a:hover,
	.category-breadcrumb a:focus-visible,
	.category-section-heading a:hover,
	.category-section-heading a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.category-header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--spacing-240);
		margin-bottom: clamp(var(--spacing-280), 4vw, var(--spacing-480));
		padding: clamp(var(--spacing-200), 3vw, var(--spacing-320));
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-2);
	}

	.category-eyebrow,
	.category-card__date {
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
	}

	.category-header h1 {
		margin: var(--spacing-60) 0 var(--spacing-100);
		color: var(--color-neutral-foreground-1);
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.2;
		text-wrap: balance;
	}

	.category-header p {
		max-width: 760px;
		margin: 0;
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-body-1);
		line-height: 1.8;
	}

	.category-count {
		flex: 0 0 auto;
		padding: var(--spacing-80) var(--spacing-120);
		border-radius: var(--radius-circular);
		background: var(--color-neutral-background-1);
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-body-1);
	}

	.category-section-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-160);
		margin-bottom: var(--spacing-160);
	}

	.category-section-heading h2 {
		margin: 0;
		font-size: var(--font-size-title-2);
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-160);
	}

	.category-card {
		min-width: 0;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-2);
		overflow: hidden;
	}

	.category-card > a {
		display: flex;
		min-height: 100%;
		flex-direction: column;
		padding: var(--spacing-180);
		color: inherit;
		text-decoration: none;
	}

	.category-card:hover,
	.category-card:focus-within {
		border-color: var(--color-neutral-stroke-1);
		background: var(--color-neutral-background-2-hover);
	}

	.category-card h3 {
		margin: var(--spacing-80) 0 var(--spacing-100);
		color: var(--color-neutral-foreground-1);
		font-size: var(--font-size-subtitle-1);
		line-height: 1.55;
		text-wrap: balance;
	}

	.category-card p {
		margin: 0 0 var(--spacing-160);
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-body-1);
		line-height: 1.75;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

	.category-card__action {
		margin-top: auto;
		color: var(--color-brand-foreground-link);
		font-size: var(--font-size-body-1);
		font-weight: var(--font-weight-semibold);
	}

	@media (max-width: 980px) {
		.category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (max-width: 640px) {
		.category-header,
		.category-section-heading {
			align-items: start;
			flex-direction: column;
		}

		.category-grid { grid-template-columns: 1fr; }
	}
</style>
