---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import SkipLink from '../../../components/SkipLink.astro';
import { SITE_TITLE } from '../../../consts';
import {
	categoryDefinitions,
	getPostCategories,
	type CategoryDefinition,
} from '../../../data/blog-taxonomy';

const DEFAULT_PAGE_SIZE = 5;

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	return categoryDefinitions.flatMap((category) => {
		const hasPosts = posts.some((post) => getPostCategories(post).includes(category.slug));
		return hasPosts ? [{ params: { slug: category.slug }, props: { category } }] : [];
	});
}

interface Props {
	category: CategoryDefinition;
}

const { category } = Astro.props;
const posts = (await getCollection('blog'))
	.filter((post) => getPostCategories(post).includes(category.slug))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const cardPosts = posts.map((post) => ({
	id: post.id,
	title: post.data.title,
	description: post.data.description,
	image: post.data.heroImageUrl ?? post.data.heroImage?.src ?? '',
	category: category.name,
}));
const initialPosts = cardPosts.slice(0, DEFAULT_PAGE_SIZE);
const initialTotalPages = Math.max(1, Math.ceil(cardPosts.length / DEFAULT_PAGE_SIZE));
const serializedPosts = JSON.stringify(cardPosts).replace(/</g, '\\u003c');

const description = `شروحات وأدلة ومقالات HAKAMIQ حول ${category.name}، مع أحدث مواضيع المحاكيات والإعدادات والتحديثات المرتبطة بهذا القسم.`;
const siteURL = Astro.site ?? Astro.url;
const canonicalURL = new URL(`/blog/category/${category.slug}/`, siteURL).href;
const categorySchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `${category.name} | ${SITE_TITLE}`,
	description,
	url: canonicalURL,
	inLanguage: 'ar',
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: posts.length,
		itemListElement: posts.map((post, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: post.data.title,
			url: new URL(`/blog/${post.id}/`, siteURL).href,
		})),
	},
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'الرئيسية', item: new URL('/', siteURL).href },
		{ '@type': 'ListItem', position: 2, name: category.name, item: canonicalURL },
	],
};
const serializeJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={`${category.name} | ${SITE_TITLE}`} description={description} />
		<script type="application/ld+json" set:html={serializeJsonLd(categorySchema)}></script>
		<script type="application/ld+json" set:html={serializeJsonLd(breadcrumbSchema)}></script>
	</head>

	<body>
		<SkipLink />
		<Header />

		<main id="main-content" tabindex="-1" class="category-main">
			<div class="category-shell">
				<nav class="category-breadcrumb" aria-label="مسار الصفحة">
					<a href="/">الرئيسية</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{category.name}</span>
				</nav>

				<section aria-label={`مقالات ${category.name}`} data-category-list>
					<div class="category-list-toolbar">
						<div class="category-page-size">
							<label for="category-page-size">عدد المقالات في الصفحة</label>
							<select id="category-page-size" aria-label="عدد المقالات في الصفحة">
								<option value="5" selected>5</option>
								<option value="7">7</option>
								<option value="10">10</option>
								<option value="20">20</option>
								<option value="30">30</option>
								<option value="50">50</option>
								<option value="100">100</option>
							</select>
						</div>
						<a class="category-all-posts" href="/blog/">جميع المقالات</a>
					</div>

					<div class="category-grid" id="category-grid">
						{initialPosts.map((post, index) => (
							<article class="category-card">
								<a href={`/blog/${post.id}/`} aria-label={`قراءة مقال: ${post.title}`}>
									<div class="category-card__media">
										{post.image ? (
											<img
												src={post.image}
												alt={post.title}
												loading={index === 0 ? 'eager' : 'lazy'}
												decoding="async"
												fetchpriority={index === 0 ? 'high' : undefined}
												referrerpolicy="no-referrer"
											/>
										) : (
											<div class="category-card__placeholder" aria-hidden="true">HAKAMIQ</div>
										)}
										<span class="category-card__scrim" aria-hidden="true"></span>
										<span class="category-card__label">{post.category}</span>
										<div class="category-card__title"><h3>{post.title}</h3></div>
									</div>
									<div class="category-card__body"><p>{post.description}</p></div>
								</a>
							</article>
						))}
					</div>

					<nav id="category-pagination" class="category-pagination" aria-label="صفحات القسم" hidden={initialTotalPages <= 1}></nav>
				</section>
			</div>
		</main>

		<script is:inline id="category-post-data" type="application/json" set:html={serializedPosts}></script>
		<Footer />

		<script>
			const DEFAULT_SIZE = 5;
			const ALLOWED_SIZES = [5, 7, 10, 20, 30, 50, 100];
			const dataElement = document.querySelector('#category-post-data');
			const grid = document.querySelector('#category-grid');
			const pagination = document.querySelector('#category-pagination');
			const sizeInput = document.querySelector('#category-page-size');

			let items = [];
			try { items = JSON.parse(dataElement?.textContent || '[]'); } catch { items = []; }

			function normalizeSize(value) {
				const parsed = Number.parseInt(String(value || ''), 10);
				return ALLOWED_SIZES.includes(parsed) ? parsed : DEFAULT_SIZE;
			}

			function makePlaceholder() {
				const placeholder = document.createElement('div');
				placeholder.className = 'category-card__placeholder';
				placeholder.setAttribute('aria-hidden', 'true');
				placeholder.textContent = 'HAKAMIQ';
				return placeholder;
			}

			function makeCard(post) {
				const article = document.createElement('article');
				article.className = 'category-card';
				const link = document.createElement('a');
				link.href = `/blog/${post.id}/`;
				link.setAttribute('aria-label', `قراءة مقال: ${post.title}`);

				const media = document.createElement('div');
				media.className = 'category-card__media';
				if (post.image) {
					const image = document.createElement('img');
					image.src = post.image;
					image.alt = post.title;
					image.loading = 'lazy';
					image.decoding = 'async';
					image.referrerPolicy = 'no-referrer';
					image.addEventListener('error', () => image.replaceWith(makePlaceholder()), { once: true });
					media.append(image);
				} else {
					media.append(makePlaceholder());
				}

				const scrim = document.createElement('span');
				scrim.className = 'category-card__scrim';
				scrim.setAttribute('aria-hidden', 'true');
				const label = document.createElement('span');
				label.className = 'category-card__label';
				label.textContent = post.category || 'مقالات';
				const titleWrap = document.createElement('div');
				titleWrap.className = 'category-card__title';
				const title = document.createElement('h3');
				title.textContent = post.title;
				titleWrap.append(title);
				media.append(scrim, label, titleWrap);

				const body = document.createElement('div');
				body.className = 'category-card__body';
				const description = document.createElement('p');
				description.textContent = post.description;
				body.append(description);
				link.append(media, body);
				article.append(link);
				return article;
			}

			function paginationTokens(current, total) {
				if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);
				const pages = new Set([1, total, current - 1, current, current + 1]);
				const sorted = [...pages].filter((page) => page >= 1 && page <= total).sort((a, b) => a - b);
				const tokens = [];
				for (let index = 0; index < sorted.length; index += 1) {
					if (index > 0 && sorted[index] - sorted[index - 1] > 1) tokens.push('ellipsis');
					tokens.push(sorted[index]);
				}
				return tokens;
			}

			function renderPagination(page, size, totalPages) {
				if (!(pagination instanceof HTMLElement)) return;
				pagination.replaceChildren();
				pagination.hidden = totalPages <= 1;
				if (totalPages <= 1) return;

				const addButton = (label, targetPage, current = false) => {
					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'category-page-link';
					button.textContent = label;
					button.dataset.page = String(targetPage);
					if (current) button.setAttribute('aria-current', 'page');
					pagination.append(button);
				};

				if (page > 1) addButton('السابق', page - 1);
				for (const token of paginationTokens(page, totalPages)) {
					if (token === 'ellipsis') {
						const ellipsis = document.createElement('span');
						ellipsis.className = 'category-page-ellipsis';
						ellipsis.textContent = '…';
						pagination.append(ellipsis);
					} else {
						addButton(String(token), token, token === page);
					}
				}
				if (page < totalPages) addButton('التالي', page + 1);
			}

			function attachInitialImageFallbacks() {
				for (const image of document.querySelectorAll('.category-card__media img')) {
					image.addEventListener('error', () => image.replaceWith(makePlaceholder()), { once: true });
				}
			}

			function render(page, size) {
				if (!(grid instanceof HTMLElement)) return;
				const safeSize = normalizeSize(size);
				const totalPages = Math.max(1, Math.ceil(items.length / safeSize));
				const safePage = Math.min(totalPages, Math.max(1, page));
				const start = (safePage - 1) * safeSize;
				const end = Math.min(start + safeSize, items.length);
				grid.replaceChildren(...items.slice(start, end).map(makeCard));
				renderPagination(safePage, safeSize, totalPages);
			}

			attachInitialImageFallbacks();
			renderPagination(1, DEFAULT_SIZE, Math.max(1, Math.ceil(items.length / DEFAULT_SIZE)));

			sizeInput?.addEventListener('change', () => {
				const size = normalizeSize(sizeInput instanceof HTMLSelectElement ? sizeInput.value : DEFAULT_SIZE);
				render(1, size);
			});

			pagination?.addEventListener('click', (event) => {
				const button = event.target instanceof Element ? event.target.closest('[data-page]') : null;
				if (!(button instanceof HTMLButtonElement)) return;
				const size = normalizeSize(sizeInput instanceof HTMLSelectElement ? sizeInput.value : DEFAULT_SIZE);
				const page = Number.parseInt(button.dataset.page || '1', 10);
				render(page, size);
				grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		</script>
	</body>
</html>

<style>
	.category-main {
		padding-block: clamp(var(--spacing-160), 2.5vw, var(--spacing-280));
	}

	.category-shell {
		width: min(100% - 32px, 1280px);
		margin-inline: auto;
	}

	.category-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-80);
		margin-bottom: var(--spacing-160);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-caption-1);
	}

	.category-breadcrumb a,
	.category-all-posts {
		color: var(--color-brand-foreground-link);
		text-decoration: none;
	}

	.category-breadcrumb a:hover,
	.category-breadcrumb a:focus-visible,
	.category-all-posts:hover,
	.category-all-posts:focus-visible {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.category-list-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-120);
		margin-bottom: var(--spacing-160);
		padding: var(--spacing-100) var(--spacing-120);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-radius: var(--radius-medium);
		background: var(--color-neutral-background-2);
	}

	.category-page-size {
		display: flex;
		align-items: center;
		gap: var(--spacing-80);
		font-size: var(--font-size-body-1);
	}

	.category-page-size select {
		min-width: 84px;
		min-height: 38px;
		padding-inline: var(--spacing-100);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-medium);
		background: var(--color-neutral-background-1);
		color: var(--color-neutral-foreground-1);
		font: inherit;
		cursor: pointer;
	}

	.category-page-size select:focus,
	.category-page-size select:focus-visible {
		outline: none;
		box-shadow: none;
		border-color: var(--color-brand-stroke-1);
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-160);
		align-items: stretch;
	}

	.category-card {
		min-width: 0;
		overflow: hidden;
	}

	.category-card > a {
		display: flex;
		height: 100%;
		min-height: 100%;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
	}

	.category-card__media {
		position: relative;
		isolation: isolate;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.category-card__media img,
	.category-card__placeholder {
		display: block;
		width: 100%;
		height: 100%;
	}

	.category-card__media img {
		object-fit: cover;
		object-position: center;
	}

	.category-card__placeholder {
		display: grid;
		place-items: center;
	}

	.category-card__scrim {
		position: absolute;
		z-index: 1;
		inset: 0;
		pointer-events: none;
	}

	.category-card__label {
		position: absolute;
		z-index: 2;
	}

	.category-card__title {
		position: absolute;
		z-index: 2;
	}

	.category-card__body {
		display: flex;
		flex: 1;
	}

	.category-pagination {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-60);
		margin-top: var(--spacing-240);
		padding-block: var(--spacing-80);
	}

	.category-page-link {
		display: inline-flex;
		min-width: 38px;
		min-height: 38px;
		align-items: center;
		justify-content: center;
		padding-inline: var(--spacing-100);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-medium);
		background: var(--color-subtle-background);
		color: var(--color-neutral-foreground-2);
		font: inherit;
		font-size: var(--font-size-body-1);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
		cursor: pointer;
	}

	.category-page-link:hover,
	.category-page-link:focus-visible {
		border-color: var(--color-neutral-stroke-1-hover);
		background: var(--color-subtle-background-hover);
		color: var(--color-neutral-foreground-1);
	}

	.category-page-link[aria-current='page'] {
		border-color: var(--color-brand-stroke-1);
		background: var(--color-brand-background-2);
		color: var(--color-brand-foreground-strong);
	}

	.category-page-ellipsis {
		padding-inline: var(--spacing-40);
		color: var(--color-neutral-foreground-4);
	}

	@media (max-width: 1080px) {
		.category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (max-width: 700px) {
		.category-list-toolbar {
			align-items: flex-start;
			flex-direction: column;
		}

		.category-page-size {
			width: 100%;
			flex-wrap: wrap;
		}

		.category-grid { grid-template-columns: 1fr; }
		.category-page-link { min-width: 42px; min-height: 42px; }
	}
</style>
