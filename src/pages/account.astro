---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';
import '../styles/account-system.css';
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title="حسابي | HAKAMIQ" description="إدارة حساب HAKAMIQ." />
		<meta name="robots" content="noindex,nofollow" />
	</head>
	<body>
		<SkipLink />
		<Header />
		<main id="main-content" tabindex="-1" class="account-main">
			<div class="account-shell">
				<header class="account-heading">
					<p class="account-kicker">HAKAMIQ ACCOUNT</p>
					<h1>حسابي</h1>
					<p id="account-intro">جاري التحقق من الجلسة…</p>
				</header>

				<section id="account-card" class="account-card account-hidden" aria-labelledby="account-title">
					<h2 id="account-title">بيانات الحساب</h2>
					<dl class="account-summary">
						<div><dt>اسم المستخدم</dt><dd id="account-username">—</dd></div>
						<div><dt>البريد الإلكتروني</dt><dd id="account-email">—</dd></div>
						<div><dt>الصلاحية</dt><dd id="account-role">—</dd></div>
						<div><dt>الحالة</dt><dd id="account-status">—</dd></div>
					</dl>
					<div class="account-actions">
						<a id="moderation-link" class="account-button account-hidden" href="/admin/users">إدارة المستخدمين</a>
						<a id="publisher-link" class="account-button account-button--primary account-hidden" href="/admin">إدارة المقالات</a>
						<button id="logout-button" class="account-button account-button--danger" type="button">تسجيل الخروج</button>
					</div>
					<p id="feedback" class="account-feedback account-hidden" role="status"></p>
				</section>

				<section id="security-card" class="account-card account-hidden" aria-labelledby="security-title">
					<h2 id="security-title">أمان الحساب الإداري</h2>
					<p id="mfa-state">جاري التحقق من إعدادات الحماية…</p>

					<div id="mfa-start-panel" class="account-form account-hidden">
						<p class="account-help">الوصول إلى الإدارة يتطلب تطبيق مصادقة. أعد إدخال كلمة مرور حسابك قبل بدء الإعداد.</p>
						<div class="account-field">
							<label for="mfa-current-password">كلمة المرور الحالية</label>
							<input id="mfa-current-password" class="account-input" type="password" maxlength="128" autocomplete="current-password" />
						</div>
						<div class="account-actions">
							<button id="mfa-start-button" class="account-button account-button--primary" type="button">بدء تفعيل التحقق بخطوتين</button>
						</div>
					</div>

					<div id="mfa-setup-panel" class="account-form account-hidden">
						<p>أضف الحساب إلى Google Authenticator أو Microsoft Authenticator أو أي تطبيق TOTP متوافق.</p>
						<div class="account-field">
							<span class="account-field-label">المفتاح اليدوي</span>
							<code id="mfa-secret" class="account-secret" dir="ltr"></code>
						</div>
						<div class="account-actions">
							<a id="mfa-open-app" class="account-button" href="#">فتح في تطبيق المصادقة</a>
						</div>
						<div class="account-field">
							<label for="mfa-confirm-code">رمز التطبيق</label>
							<input id="mfa-confirm-code" class="account-input" type="text" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000" />
						</div>
						<div class="account-actions">
							<button id="mfa-confirm-button" class="account-button account-button--primary" type="button">تأكيد وتفعيل</button>
						</div>
					</div>

					<div id="mfa-enabled-panel" class="account-form account-hidden">
						<p id="mfa-enabled-text">التحقق بخطوتين مفعّل.</p>
						<div class="account-field">
							<label for="mfa-regenerate-code">لإنشاء رموز استرداد جديدة، أدخل رمز التطبيق الحالي أو رمز استرداد صالح</label>
							<input id="mfa-regenerate-code" class="account-input" type="text" maxlength="20" autocomplete="one-time-code" />
						</div>
						<div class="account-actions">
							<button id="mfa-regenerate-button" class="account-button" type="button">إنشاء رموز استرداد جديدة</button>
						</div>
					</div>

					<div id="recovery-panel" class="account-recovery account-hidden" aria-live="polite">
						<h3>رموز الاسترداد</h3>
						<p><strong>احفظ هذه الرموز الآن.</strong> كل رمز يعمل مرة واحدة، ولن نعرض هذه المجموعة مرة أخرى بعد مغادرة الصفحة.</p>
						<div id="recovery-codes" class="account-recovery-codes" dir="ltr"></div>
						<div id="mfa-reauth-actions" class="account-actions account-hidden">
							<a class="account-button account-button--primary" href="/login?next=/account">تسجيل الدخول من جديد</a>
						</div>
					</div>
					<p id="mfa-feedback" class="account-feedback account-hidden" role="status"></p>
				</section>

				<section id="guest-card" class="account-card account-hidden">
					<h2>يلزم تسجيل الدخول</h2>
					<p>لا توجد جلسة حساب نشطة.</p>
					<div class="account-actions">
						<a class="account-button account-button--primary" href="/login?next=/account">تسجيل الدخول</a>
						<a class="account-button" href="/register">إنشاء حساب</a>
					</div>
				</section>
			</div>
		</main>
		<Footer />

		<script>
			const intro = document.querySelector<HTMLElement>('#account-intro');
			const card = document.querySelector<HTMLElement>('#account-card');
			const guest = document.querySelector<HTMLElement>('#guest-card');
			const username = document.querySelector<HTMLElement>('#account-username');
			const email = document.querySelector<HTMLElement>('#account-email');
			const role = document.querySelector<HTMLElement>('#account-role');
			const status = document.querySelector<HTMLElement>('#account-status');
			const moderation = document.querySelector<HTMLElement>('#moderation-link');
			const publisher = document.querySelector<HTMLElement>('#publisher-link');
			const logout = document.querySelector<HTMLButtonElement>('#logout-button');
			const feedback = document.querySelector<HTMLElement>('#feedback');
			const securityCard = document.querySelector<HTMLElement>('#security-card');
			const mfaState = document.querySelector<HTMLElement>('#mfa-state');
			const mfaStartPanel = document.querySelector<HTMLElement>('#mfa-start-panel');
			const mfaSetupPanel = document.querySelector<HTMLElement>('#mfa-setup-panel');
			const mfaEnabledPanel = document.querySelector<HTMLElement>('#mfa-enabled-panel');
			const mfaCurrentPassword = document.querySelector<HTMLInputElement>('#mfa-current-password');
			const mfaStartButton = document.querySelector<HTMLButtonElement>('#mfa-start-button');
			const mfaSecret = document.querySelector<HTMLElement>('#mfa-secret');
			const mfaOpenApp = document.querySelector<HTMLAnchorElement>('#mfa-open-app');
			const mfaConfirmCode = document.querySelector<HTMLInputElement>('#mfa-confirm-code');
			const mfaConfirmButton = document.querySelector<HTMLButtonElement>('#mfa-confirm-button');
			const mfaEnabledText = document.querySelector<HTMLElement>('#mfa-enabled-text');
			const mfaRegenerateCode = document.querySelector<HTMLInputElement>('#mfa-regenerate-code');
			const mfaRegenerateButton = document.querySelector<HTMLButtonElement>('#mfa-regenerate-button');
			const recoveryPanel = document.querySelector<HTMLElement>('#recovery-panel');
			const recoveryCodes = document.querySelector<HTMLElement>('#recovery-codes');
			const reauthActions = document.querySelector<HTMLElement>('#mfa-reauth-actions');
			const mfaFeedback = document.querySelector<HTMLElement>('#mfa-feedback');

			const roleLabel: Record<string, string> = { user: 'مستخدم', moderator: 'مشرف', admin: 'مدير' };
			const statusLabel: Record<string, string> = { active: 'نشط', suspended: 'موقوف' };
			let currentRole = '';

			function message(element: HTMLElement | null, text: string, kind = '') {
				if (!element) return;
				element.textContent = text;
				element.dataset.kind = kind;
				element.classList.toggle('account-hidden', !text);
			}

			function showFeedback(text: string, kind = '') {
				message(feedback, text, kind);
			}

			async function api(path: string, options: RequestInit = {}) {
				const response = await fetch(path, {
					credentials: 'same-origin',
					headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
					...options,
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(payload.error || 'تعذر تنفيذ الطلب.');
				return payload;
			}

			function showRecoveryCodes(codes: unknown, reauthRequired = false) {
				if (!recoveryCodes || !recoveryPanel) return;
				recoveryCodes.replaceChildren();
				for (const code of Array.isArray(codes) ? codes : []) {
					const item = document.createElement('code');
					item.textContent = String(code);
					recoveryCodes.append(item);
				}
				recoveryPanel.classList.remove('account-hidden');
				reauthActions?.classList.toggle('account-hidden', !reauthRequired);
			}

			async function loadMfa() {
				if (!['moderator', 'admin'].includes(currentRole)) return;
				securityCard?.classList.remove('account-hidden');
				try {
					const payload = await api('/api/mfa/status', { method: 'GET' });
					if (!payload.enabled) {
						if (mfaState) mfaState.textContent = 'التحقق بخطوتين غير مفعّل. لن تُفتح صلاحيات الإدارة قبل تفعيله.';
						mfaStartPanel?.classList.remove('account-hidden');
						mfaEnabledPanel?.classList.add('account-hidden');
						if (new URLSearchParams(window.location.search).get('security') === 'setup') securityCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
						return;
					}
					mfaStartPanel?.classList.add('account-hidden');
					mfaSetupPanel?.classList.add('account-hidden');
					mfaEnabledPanel?.classList.remove('account-hidden');
					if (mfaState) mfaState.textContent = payload.sessionVerified
						? 'التحقق بخطوتين مفعّل، والجلسة الحالية اجتازت العامل الثاني.'
						: 'التحقق بخطوتين مفعّل، لكن هذه الجلسة لم تجتز العامل الثاني.';
					if (mfaEnabledText) mfaEnabledText.textContent = `رموز الاسترداد المتبقية: ${Number(payload.recoveryCodesRemaining || 0)}`;
					if (payload.sessionVerified) {
						moderation?.classList.remove('account-hidden');
						if (currentRole === 'admin') publisher?.classList.remove('account-hidden');
					}
				} catch (error) {
					if (mfaState) mfaState.textContent = error instanceof Error ? error.message : 'تعذر تحميل إعدادات التحقق بخطوتين.';
				}
			}

			async function loadSession() {
				try {
					const response = await fetch('/api/auth/session', { credentials: 'same-origin' });
					const payload = await response.json().catch(() => ({}));
					if (!response.ok) throw new Error(payload.error || 'تعذر التحقق من الحساب.');
					if (!payload.authenticated) {
						if (intro) intro.textContent = 'لم تسجل الدخول بعد.';
						guest?.classList.remove('account-hidden');
						return;
					}
					const user = payload.user || {};
					currentRole = String(user.role || '');
					if (intro) intro.textContent = `مرحبًا ${user.username || ''}`;
					if (username) username.textContent = user.username || '—';
					if (email) email.textContent = user.email || '—';
					if (role) role.textContent = roleLabel[user.role] || user.role || '—';
					if (status) status.textContent = statusLabel[user.status] || user.status || '—';
					card?.classList.remove('account-hidden');
					if (currentRole === 'user') return;
					await loadMfa();
				} catch (error) {
					if (intro) intro.textContent = 'تعذر تحميل الحساب.';
					guest?.classList.remove('account-hidden');
					console.error(error);
				}
			}

			mfaStartButton?.addEventListener('click', async () => {
				if (!mfaCurrentPassword || !mfaStartButton) return;
				const password = mfaCurrentPassword.value;
				if (!password) {
					message(mfaFeedback, 'أدخل كلمة مرور حسابك الحالية.', 'error');
					return;
				}
				mfaStartButton.disabled = true;
				message(mfaFeedback, 'جاري بدء الإعداد…');
				try {
					const payload = await api('/api/mfa/setup-start', {
						method: 'POST',
						body: JSON.stringify({ password }),
					});
					mfaCurrentPassword.value = '';
					if (mfaSecret) mfaSecret.textContent = String(payload.secret || '');
					if (mfaOpenApp) mfaOpenApp.href = String(payload.otpauthUri || '#');
					mfaStartPanel?.classList.add('account-hidden');
					mfaSetupPanel?.classList.remove('account-hidden');
					if (mfaState) mfaState.textContent = 'أضف المفتاح إلى تطبيق المصادقة ثم أكد أول رمز.';
					message(mfaFeedback, '');
					mfaConfirmCode?.focus();
				} catch (error) {
					mfaCurrentPassword.value = '';
					message(mfaFeedback, error instanceof Error ? error.message : 'تعذر بدء الإعداد.', 'error');
				} finally {
					mfaStartButton.disabled = false;
				}
			});

			mfaConfirmButton?.addEventListener('click', async () => {
				if (!mfaConfirmCode || !mfaConfirmButton) return;
				const code = mfaConfirmCode.value.trim();
				if (!/^\d{6}$/.test(code)) {
					message(mfaFeedback, 'أدخل رمز التطبيق المكوّن من 6 أرقام.', 'error');
					return;
				}
				mfaConfirmButton.disabled = true;
				message(mfaFeedback, 'جاري تفعيل التحقق بخطوتين…');
				try {
					const payload = await api('/api/mfa/setup-confirm', {
						method: 'POST',
						body: JSON.stringify({ code }),
					});
					mfaConfirmCode.value = '';
					mfaSetupPanel?.classList.add('account-hidden');
					mfaStartPanel?.classList.add('account-hidden');
					if (mfaState) mfaState.textContent = 'تم تفعيل التحقق بخطوتين. احفظ رموز الاسترداد ثم سجل الدخول من جديد.';
					showRecoveryCodes(payload.recoveryCodes, true);
					message(mfaFeedback, 'تم تفعيل الحماية بنجاح.', 'success');
					moderation?.classList.add('account-hidden');
					publisher?.classList.add('account-hidden');
				} catch (error) {
					mfaConfirmCode.value = '';
					message(mfaFeedback, error instanceof Error ? error.message : 'تعذر تفعيل التحقق بخطوتين.', 'error');
					mfaConfirmCode.focus();
				} finally {
					mfaConfirmButton.disabled = false;
				}
			});

			mfaRegenerateButton?.addEventListener('click', async () => {
				if (!mfaRegenerateCode || !mfaRegenerateButton) return;
				const code = mfaRegenerateCode.value.trim();
				if (!code) {
					message(mfaFeedback, 'أدخل رمز التحقق الحالي.', 'error');
					return;
				}
				mfaRegenerateButton.disabled = true;
				message(mfaFeedback, 'جاري إنشاء رموز جديدة…');
				try {
					const payload = await api('/api/mfa/recovery-regenerate', {
						method: 'POST',
						body: JSON.stringify({ code }),
					});
					mfaRegenerateCode.value = '';
					showRecoveryCodes(payload.recoveryCodes, false);
					if (mfaEnabledText) mfaEnabledText.textContent = `رموز الاسترداد المتبقية: ${Array.isArray(payload.recoveryCodes) ? payload.recoveryCodes.length : 0}`;
					message(mfaFeedback, 'تم إلغاء الرموز القديمة وإنشاء مجموعة جديدة.', 'success');
				} catch (error) {
					mfaRegenerateCode.value = '';
					message(mfaFeedback, error instanceof Error ? error.message : 'تعذر إنشاء رموز جديدة.', 'error');
				} finally {
					mfaRegenerateButton.disabled = false;
				}
			});

			logout?.addEventListener('click', async () => {
				logout.disabled = true;
				showFeedback('');
				try {
					const response = await fetch('/api/auth/logout', {
						method: 'POST',
						credentials: 'same-origin',
						headers: { 'Content-Type': 'application/json' },
						body: '{}',
					});
					if (!response.ok) throw new Error('تعذر تسجيل الخروج.');
					window.location.href = '/login';
				} catch (error) {
					showFeedback(error instanceof Error ? error.message : 'تعذر تسجيل الخروج.', 'error');
					logout.disabled = false;
				}
			});

			loadSession();
		</script>
	</body>
</html>
