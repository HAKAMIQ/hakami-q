---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';
import '../styles/account-system.css';
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title="دخول الإدارة | HAKAMIQ" description="تسجيل الدخول إلى لوحة إدارة HAKAMIQ." />
		<meta name="robots" content="noindex,nofollow,noarchive" />
	</head>
	<body>
		<SkipLink />
		<Header />
		<main id="main-content" tabindex="-1" class="account-main">
			<div class="account-shell">
				<header class="account-heading">
					<p class="account-kicker">HAKAMIQ ADMIN</p>
					<h1>دخول الإدارة</h1>
					<p>هذه الصفحة مخصصة لإدارة HAKAMIQ فقط.</p>
				</header>
				<section class="account-card" aria-labelledby="login-title">
					<h2 id="login-title">حساب المدير</h2>
					<form id="login-form" class="account-form">
						<div class="account-field"><label for="identifier">اسم المستخدم أو البريد الإلكتروني</label><input id="identifier" class="account-input" type="text" maxlength="254" autocomplete="username" required /></div>
						<div class="account-field"><label for="password">كلمة المرور</label><input id="password" class="account-input" type="password" maxlength="128" autocomplete="current-password" required /></div>
						<div id="turnstile-slot" class="account-turnstile" aria-label="التحقق الأمني"></div>
						<div class="account-actions"><button id="submit-button" class="account-button account-button--primary" type="submit" disabled>دخول</button></div>
						<p id="feedback" class="account-feedback account-hidden" role="status"></p>
					</form>
					<form id="mfa-form" class="account-form account-hidden" autocomplete="one-time-code">
						<p class="account-help">أدخل رمز تطبيق المصادقة المكوّن من 6 أرقام أو أحد رموز الاسترداد.</p>
						<div class="account-field"><label for="mfa-code">رمز التحقق</label><input id="mfa-code" class="account-input" type="text" maxlength="20" autocomplete="one-time-code" required /></div>
						<div class="account-actions"><button id="mfa-submit" class="account-button account-button--primary" type="submit">تحقق ودخول</button><button id="mfa-cancel" class="account-button" type="button">رجوع</button></div>
						<p id="mfa-feedback" class="account-feedback account-hidden" role="status"></p>
					</form>
				</section>
			</div>
		</main>
		<Footer />
		<script>
			const form = document.querySelector<HTMLFormElement>('#login-form');
			const identifier = document.querySelector<HTMLInputElement>('#identifier');
			const password = document.querySelector<HTMLInputElement>('#password');
			const feedback = document.querySelector<HTMLElement>('#feedback');
			const submit = document.querySelector<HTMLButtonElement>('#submit-button');
			const turnstileSlot = document.querySelector<HTMLElement>('#turnstile-slot');
			const mfaForm = document.querySelector<HTMLFormElement>('#mfa-form');
			const mfaCode = document.querySelector<HTMLInputElement>('#mfa-code');
			const mfaSubmit = document.querySelector<HTMLButtonElement>('#mfa-submit');
			const mfaCancel = document.querySelector<HTMLButtonElement>('#mfa-cancel');
			const mfaFeedback = document.querySelector<HTMLElement>('#mfa-feedback');
			let mfaToken = '';

			function showOn(element: HTMLElement | null, message: string, kind = '') { if (!element) return; element.textContent = message; element.dataset.kind = kind; element.classList.toggle('account-hidden', !message); }
			function show(message: string, kind = '') { showOn(feedback, message, kind); }
			function safeNextPath() {
				const requested = new URLSearchParams(window.location.search).get('next');
				if (!requested) return '/admin';
				try {
					const target = new URL(requested, window.location.origin);
					if (target.origin !== window.location.origin || !target.pathname.startsWith('/admin')) return '/admin';
					return `${target.pathname}${target.search}${target.hash}`;
				} catch { return '/admin'; }
			}
			function resetTurnstile() { (window as typeof window & { turnstile?: { reset: () => void } }).turnstile?.reset(); }
			function enterMfaStep(token: string) { mfaToken = token; if (password) password.value = ''; form?.classList.add('account-hidden'); mfaForm?.classList.remove('account-hidden'); show(''); showOn(mfaFeedback, 'أدخل رمز التحقق لإكمال دخول الإدارة.'); mfaCode?.focus(); }
			function leaveMfaStep() { mfaToken = ''; if (mfaCode) mfaCode.value = ''; mfaForm?.classList.add('account-hidden'); form?.classList.remove('account-hidden'); showOn(mfaFeedback, ''); resetTurnstile(); password?.focus(); }

			async function initializeTurnstile() {
				try {
					const response = await fetch('/api/auth/config', { credentials: 'same-origin' });
					const payload = await response.json().catch(() => ({}));
					if (!response.ok || !payload.turnstileSitekey || !turnstileSlot) throw new Error('التحقق الأمني غير مهيأ بعد.');
					turnstileSlot.classList.add('cf-turnstile'); turnstileSlot.dataset.sitekey = payload.turnstileSitekey; turnstileSlot.dataset.action = 'login';
					const script = document.createElement('script'); script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js'; script.async = true; script.defer = true;
					script.addEventListener('load', () => { if (submit) submit.disabled = false; }, { once: true });
					script.addEventListener('error', () => show('تعذر تحميل التحقق الأمني.', 'error'), { once: true }); document.head.append(script);
				} catch (error) { show(error instanceof Error ? error.message : 'تعذر تهيئة التحقق الأمني.', 'error'); }
			}

			form?.addEventListener('submit', async (event) => {
				event.preventDefault(); if (!identifier || !password || !submit || !form) return; show('');
				const token = form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]')?.value || '';
				if (!token) { show('أكمل التحقق الأمني ثم أعد المحاولة.', 'error'); return; }
				submit.disabled = true;
				try {
					const response = await fetch('/api/auth/login', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ identifier: identifier.value, password: password.value, turnstileToken: token }) });
					const payload = await response.json().catch(() => ({}));
					if (!response.ok) throw new Error(payload.error || 'تعذر دخول الإدارة.');
					if (response.status === 202 && payload.mfaRequired && payload.mfaToken) { enterMfaStep(String(payload.mfaToken)); return; }
					window.location.assign(payload.user?.role === 'admin' ? (payload.user && safeNextPath()) : '/admin');
				} catch (error) { show(error instanceof Error ? error.message : 'تعذر دخول الإدارة.', 'error'); resetTurnstile(); }
				finally { submit.disabled = false; }
			});

			mfaForm?.addEventListener('submit', async (event) => {
				event.preventDefault(); if (!mfaToken || !mfaCode || !mfaSubmit) return; const code = mfaCode.value.trim(); if (!code) return;
				mfaSubmit.disabled = true;
				try {
					const response = await fetch('/api/mfa/verify-login', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mfaToken, code }) });
					const payload = await response.json().catch(() => ({})); if (!response.ok) throw new Error(payload.error || 'تعذر التحقق من الرمز.');
					mfaToken = ''; window.location.assign(safeNextPath());
				} catch (error) { showOn(mfaFeedback, error instanceof Error ? error.message : 'تعذر التحقق من الرمز.', 'error'); if (mfaCode) { mfaCode.value = ''; mfaCode.focus(); } }
				finally { mfaSubmit.disabled = false; }
			});
			mfaCancel?.addEventListener('click', leaveMfaStep);
			initializeTurnstile();
		</script>
	</body>
</html>
