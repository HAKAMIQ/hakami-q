---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const genericLabels = new Set([
	'articles',
	'article',
	'gaming articles',
	'gaming article',
	'مقالات',
	'المقالات',
	'ألعاب',
	'العاب',
]);

const broadLabels = new Set([
	'nintendo',
	'playstation',
	'xbox',
	'sega',
	'pc',
]);

const getDisplayCategory = (labels: string[] = []) => {
	const candidates = labels.filter((label) => !genericLabels.has(label.trim().toLocaleLowerCase('en')));
	return candidates.find((label) => !broadLabels.has(label.trim().toLocaleLowerCase('en'))) ?? candidates[0] ?? null;
};

const featuredPosts = posts.slice(0, 2);
const picks = posts.slice(2, 6);
const latestRows = posts.slice(6, 10);
const searchItems = posts.map((post) => ({
	title: post.data.title,
	description: post.data.description ?? '',
	labels: post.data.labels ?? [],
	href: `/blog/${post.id}/`,
}));
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<SkipLink />
		<Header />

		<main id="main-content" class="home-page" tabindex="-1">
			<section class="home-news-section" aria-labelledby="latest-posts-title">
				<div class="site-container home-shell">
					<header class="home-heading">
						<div class="home-heading-copy">
							<p class="section-kicker">أحدث التحديثات والإصدارات</p>
							<h1 id="latest-posts-title">أحدث المقالات</h1>
						</div>

						<div class="home-heading-tools">
							<div class="home-search" data-home-search>
								<div class="home-search-field">
									<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="5.5"></circle><path d="m13 13 4 4"></path></svg>
									<input
										id="home-search-input"
										type="search"
										placeholder="ابحث في المقالات"
										autocomplete="off"
										spellcheck="false"
										aria-label="بحث في المقالات"
										aria-controls="home-search-results"
										aria-describedby="home-search-help"
										aria-expanded="false"
									/>
									<button class="home-search-clear" type="button" aria-label="مسح البحث" title="مسح البحث" hidden>
										<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg>
									</button>
								</div>
								<p class="sr-only" id="home-search-help">اكتب حرفين على الأقل للبحث في العناوين والتصنيفات والملخصات</p>
								<div class="home-search-results" id="home-search-results" aria-label="نتائج البحث" hidden></div>
								<p class="sr-only" id="home-search-status" role="status" aria-live="polite" aria-atomic="true"></p>
							</div>

							<a class="all-posts-top" href="/blog">
								<span>عرض الكل</span>
								<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15 10H5m4-4-4 4 4 4"></path></svg>
							</a>
						</div>
					</header>

					<div class="home-editorial-grid">
						<aside class="home-picks" aria-labelledby="picks-title">
							<div class="picks-heading">
								<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 2 2.3 4.7 5.2.8-3.8 3.7.9 5.2-4.6-2.4-4.6 2.4.9-5.2-3.8-3.7 5.2-.8L10 2Z"></path></svg>
								<h2 id="picks-title">مختارات</h2>
							</div>

							<div class="picks-list">
								{picks.map((post) => {
									const category = getDisplayCategory(post.data.labels);
									return (
										<article class="pick-card">
											<a href={`/blog/${post.id}/`} aria-label={`قراءة مقال: ${post.data.title}`}>
												<div class="pick-media-frame">
													<div class="pick-media-viewport">
														{post.data.heroImageUrl ? (
															<img src={post.data.heroImageUrl} alt={post.data.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
														) : (
															<div class="home-image-placeholder small" aria-hidden="true">H</div>
														)}
													</div>
												</div>
												<div class="pick-copy">
													{category && <span class="story-category compact">{category}</span>}
													<h3>{post.data.title}</h3>
												</div>
											</a>
										</article>
									);
								})}
							</div>
						</aside>

						<div class="home-primary-column">
							<div class="featured-grid">
								{featuredPosts.map((post, index) => {
									const category = getDisplayCategory(post.data.labels);
									return (
										<article class:list={['feature-card', index === 0 && 'feature-card--primary']}>
											<a href={`/blog/${post.id}/`} aria-label={`قراءة مقال: ${post.data.title}`}>
												<div class="feature-media-frame">
													<div class="feature-media-viewport">
														{post.data.heroImageUrl ? (
															<img
																src={post.data.heroImageUrl}
																alt={post.data.title}
																loading={index === 0 ? 'eager' : 'lazy'}
																decoding="async"
																fetchpriority={index === 0 ? 'high' : undefined}
																referrerpolicy="no-referrer"
															/>
														) : (
															<div class="home-image-placeholder" aria-hidden="true">H</div>
														)}
													</div>
													<span class="feature-ribbon">{index === 0 ? 'الأحدث' : 'مميز'}</span>
												</div>

												<div class="feature-copy">
													{category && <span class="story-category">{category}</span>}
													<h2>{post.data.title}</h2>
													{post.data.description && <p>{post.data.description}</p>}
													<span class="feature-read-more" aria-hidden="true">قراءة المقال</span>
												</div>
											</a>
										</article>
									);
								})}
							</div>

							<div class="latest-rows" aria-label="مقالات حديثة">
								{latestRows.map((post) => {
									const category = getDisplayCategory(post.data.labels);
									return (
										<article class="article-row">
											<a href={`/blog/${post.id}/`} aria-label={`قراءة مقال: ${post.data.title}`}>
												<div class="row-media-frame">
													<div class="row-media-viewport">
														{post.data.heroImageUrl ? (
															<img src={post.data.heroImageUrl} alt={post.data.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
														) : (
															<div class="home-image-placeholder small" aria-hidden="true">H</div>
														)}
													</div>
												</div>

												<div class="row-copy">
													{category && <span class="story-category compact">{category}</span>}
													<h3>{post.data.title}</h3>
													{post.data.description && <p>{post.data.description}</p>}
												</div>
											</a>
										</article>
									);
								})}
							</div>

							<div class="all-posts-action">
								<a class="all-posts-button" href="/blog">
									<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3.5h10v13H5zM8 7h4M8 10h4M8 13h4"></path></svg>
									<span>عرض كل المقالات</span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<script id="home-search-data" type="application/json" set:html={JSON.stringify(searchItems).replace(/</g, '\\u003c')}></script>
		<script>
			type HomeItem = { title: string; description: string; labels: string[]; href: string };

			const readHomeItems = () => {
				const dataElement = document.getElementById('home-search-data');
				if (!dataElement) return [] as HomeItem[];
				try { return JSON.parse(dataElement.textContent || '[]') as HomeItem[]; } catch { return [] as HomeItem[]; }
			};

			const initializeHomeSearch = () => {
				const root = document.querySelector<HTMLElement>('[data-home-search]');
				if (!root || root.dataset.initialized === 'true') return;
				root.dataset.initialized = 'true';
				const input = root.querySelector<HTMLInputElement>('#home-search-input');
				const results = root.querySelector<HTMLElement>('#home-search-results');
				const clearButton = root.querySelector<HTMLButtonElement>('.home-search-clear');
				const status = root.querySelector<HTMLElement>('#home-search-status');
				if (!input || !results || !clearButton || !status) return;
				const items = readHomeItems();
				const normalize = (value: string) => value
					.toLocaleLowerCase('ar').normalize('NFKD')
					.replace(/[\u064B-\u065F\u0670]/g, '').replace(/[أإآ]/g, 'ا')
					.replace(/ى/g, 'ي').replace(/ة/g, 'ه').replace(/\s+/g, ' ').trim();
				const closeResults = (clearStatus = false) => {
					results.hidden = true;
					results.replaceChildren();
					input.setAttribute('aria-expanded', 'false');
					if (clearStatus) status.textContent = '';
				};
				const render = () => {
					const query = normalize(input.value);
					clearButton.hidden = query.length === 0;
					if (query.length < 2) { closeResults(true); return; }
					const terms = query.split(' ').filter(Boolean);
					const matches = items.map((item) => {
						const title = normalize(item.title);
						const description = normalize(item.description);
						const labels = normalize(item.labels.join(' '));
						const haystack = `${title} ${labels} ${description}`;
						if (!terms.every((term) => haystack.includes(term))) return null;
						let score = 0;
						if (title === query) score += 100;
						if (title.startsWith(query)) score += 50;
						if (title.includes(query)) score += 30;
						if (labels.includes(query)) score += 15;
						return { item, score };
					}).filter((entry): entry is { item: HomeItem; score: number } => entry !== null)
						.sort((a, b) => b.score - a.score).slice(0, 8);

					results.replaceChildren();
					if (matches.length === 0) {
						const empty = document.createElement('p');
						empty.className = 'home-search-empty';
						empty.textContent = 'لا توجد نتائج مطابقة. جرّب اسم المحاكي أو الجهاز.';
						results.append(empty);
						status.textContent = 'لا توجد نتائج مطابقة';
					} else {
						for (const { item } of matches) {
							const link = document.createElement('a');
							link.href = item.href;
							link.className = 'home-search-result';
							const title = document.createElement('strong');
							title.textContent = item.title;
							link.append(title);
							if (item.labels.length > 0) {
								const meta = document.createElement('span');
								meta.textContent = item.labels.slice(0, 2).join(' · ');
								link.append(meta);
							}
							results.append(link);
						}
						status.textContent = `${matches.length} ${matches.length === 1 ? 'نتيجة' : 'نتائج'}`;
					}
					results.hidden = false;
					input.setAttribute('aria-expanded', 'true');
				};

				input.addEventListener('input', render);
				input.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') {
						input.value = '';
						clearButton.hidden = true;
						closeResults(true);
						input.blur();
					}
					if (event.key === 'Enter') {
						const first = results.querySelector<HTMLAnchorElement>('.home-search-result');
						if (first) window.location.href = first.href;
					}
				});
				clearButton.addEventListener('click', () => {
					input.value = '';
					clearButton.hidden = true;
					closeResults(true);
					input.focus();
				});
				document.addEventListener('pointerdown', (event) => {
					if (event.target instanceof Node && !root.contains(event.target)) closeResults();
				});
			};

			const initializeHome = () => initializeHomeSearch();
			if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeHome, { once: true });
			else initializeHome();
			document.addEventListener('astro:page-load', initializeHome);
		</script>
	</body>
</html>

<style>
	.home-page {
		background:
			radial-gradient(circle at 18% 15%, color-mix(in srgb, var(--color-brand-background) 8%, transparent), transparent 30%),
			var(--color-neutral-background-4);
	}

	.home-news-section { padding-block: var(--spacing-240) var(--spacing-400); }
	.home-shell { width: min(calc(100% - (var(--page-gutter) * 2)), 1380px); }

	.home-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--spacing-200);
		margin-bottom: var(--spacing-200);
	}

	.section-kicker {
		margin-bottom: var(--spacing-40);
		color: var(--color-brand-foreground-strong);
		font-size: var(--font-size-caption-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-caption-1);
	}

	.home-heading h1 {
		font-size: var(--font-size-title-1);
		line-height: var(--line-height-title-1);
	}

	.home-heading-tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--spacing-100);
		min-width: 0;
	}

	.home-search { position: relative; z-index: 30; width: min(340px, 36vw); }
	.home-search-field {
		display: flex;
		min-height: 40px;
		align-items: center;
		gap: var(--spacing-60);
		padding-inline: var(--spacing-100);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-2);
		box-shadow: var(--shadow-2);
		transition: border-color var(--duration-faster) var(--curve-easy-ease), box-shadow var(--duration-faster) var(--curve-easy-ease);
	}
	.home-search:focus-within .home-search-field { border-color: var(--color-brand-stroke-1); box-shadow: var(--focus-ring); }
	.home-search-field > svg { width: 17px; height: 17px; flex: 0 0 auto; fill: none; stroke: var(--color-neutral-foreground-3); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }
	.home-search-field input { width: 100%; min-width: 0; height: 38px; padding: 0; border: 0; outline: 0; background: transparent; color: var(--color-neutral-foreground-1); font-size: var(--font-size-body-1); }
	.home-search-field input::placeholder { color: var(--color-neutral-foreground-4); }
	.home-search-field input::-webkit-search-cancel-button { display: none; }
	.home-search-clear { display: grid; width: 30px; height: 30px; flex: 0 0 auto; place-items: center; padding: 0; border: 0; border-radius: var(--radius-medium); background: transparent; color: var(--color-neutral-foreground-3); cursor: pointer; }
	.home-search-clear[hidden] { display: none; }
	.home-search-clear:hover { background: var(--color-subtle-background-hover); color: var(--color-neutral-foreground-1); }
	.home-search-clear svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.6; }
	.home-search-results { position: absolute; inset-inline: 0; top: calc(100% + var(--spacing-60)); overflow: hidden; padding: var(--spacing-60); border: var(--stroke-thin) solid var(--color-neutral-stroke-1); border-radius: var(--radius-large); background: var(--color-neutral-background-1); box-shadow: var(--shadow-16); }
	.home-search-results[hidden] { display: none; }
	:global(.home-search-result) { display: flex; min-height: 50px; flex-direction: column; justify-content: center; gap: 2px; padding: var(--spacing-80) var(--spacing-100); border-radius: var(--radius-medium); color: var(--color-neutral-foreground-1); text-decoration: none; }
	:global(.home-search-result:hover), :global(.home-search-result:focus-visible) { background: var(--color-subtle-background-hover); }
	:global(.home-search-result strong) { display: -webkit-box; overflow: hidden; font-size: var(--font-size-body-1); font-weight: var(--font-weight-semibold); line-height: var(--line-height-body-1); -webkit-box-orient: vertical; -webkit-line-clamp: 1; }
	:global(.home-search-result span) { color: var(--color-neutral-foreground-3); font-size: var(--font-size-caption-1); line-height: var(--line-height-caption-1); }
	:global(.home-search-empty) { margin: 0; padding: var(--spacing-160); color: var(--color-neutral-foreground-3); text-align: center; }

	.all-posts-top {
		display: inline-flex;
		min-height: 40px;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-60);
		padding-inline: var(--spacing-120);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-large);
		background: var(--color-subtle-background);
		color: var(--color-neutral-foreground-1);
		font-size: var(--font-size-body-1);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
	}
	.all-posts-top:hover, .all-posts-top:focus-visible { border-color: var(--color-brand-stroke-1); background: var(--color-subtle-background-hover); }
	.all-posts-top svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }

	.home-editorial-grid {
		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		gap: var(--spacing-160);
		align-items: start;
	}

	.home-primary-column { min-width: 0; grid-column: 2; }
	.home-picks {
		grid-column: 1;
		min-width: 0;
		padding: var(--spacing-120);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-xlarge);
		background: color-mix(in srgb, var(--color-neutral-background-2) 92%, transparent);
		box-shadow: var(--shadow-4);
	}

	.picks-heading { display: flex; align-items: center; gap: var(--spacing-60); margin-bottom: var(--spacing-100); color: var(--color-brand-foreground-strong); }
	.picks-heading svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
	.picks-heading h2 { font-size: var(--font-size-subtitle-2); line-height: var(--line-height-subtitle-2); }
	.picks-list { display: grid; gap: var(--spacing-80); }

	.pick-card { min-width: 0; }
	.pick-card a {
		display: grid;
		grid-template-columns: 104px minmax(0, 1fr);
		align-items: center;
		gap: var(--spacing-80);
		padding: var(--spacing-60);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-3);
		color: inherit;
		text-decoration: none;
		transition: border-color var(--duration-faster) var(--curve-easy-ease), background var(--duration-faster) var(--curve-easy-ease), box-shadow var(--duration-normal) var(--curve-decelerate-mid);
	}
	.pick-card a:hover, .pick-card a:focus-visible { border-color: var(--color-brand-stroke-1); background: var(--color-neutral-background-2); box-shadow: var(--shadow-4); }
	.pick-copy { min-width: 0; }
	.pick-copy h3 { display: -webkit-box; overflow: hidden; margin-top: var(--spacing-40); font-size: var(--font-size-body-1); font-weight: var(--font-weight-semibold); line-height: var(--line-height-body-1); -webkit-box-orient: vertical; -webkit-line-clamp: 3; }

	.pick-media-frame,
	.feature-media-frame,
	.row-media-frame {
		position: relative;
		overflow: hidden;
		padding: 4px;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-1);
		box-shadow: inset 0 0 0 var(--stroke-thin) var(--color-neutral-stroke-alpha), var(--shadow-2);
	}

	.pick-media-viewport,
	.feature-media-viewport,
	.row-media-viewport {
		overflow: hidden;
		width: 100%;
		height: 100%;
		border-radius: calc(var(--radius-large) - 3px);
		background: var(--color-neutral-background-5);
	}

	.pick-media-frame { width: 104px; height: 76px; }
	.pick-media-viewport img,
	.feature-media-viewport img,
	.row-media-viewport img { width: 100%; height: 100%; object-fit: cover; object-position: center; }

	.featured-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--spacing-120); }
	.feature-card {
		min-width: 0;
		overflow: hidden;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-xlarge);
		background: var(--color-neutral-background-2);
		box-shadow: var(--shadow-4);
		transition: border-color var(--duration-faster) var(--curve-easy-ease), box-shadow var(--duration-normal) var(--curve-decelerate-mid), background var(--duration-faster) var(--curve-easy-ease);
	}
	.feature-card--primary { border-color: color-mix(in srgb, var(--color-brand-stroke-1) 70%, var(--color-neutral-stroke-2)); }
	.feature-card:hover, .feature-card:focus-within { border-color: var(--color-brand-stroke-1); background: var(--color-neutral-card-background-hover); box-shadow: var(--shadow-16); }
	.feature-card > a { display: block; color: inherit; text-decoration: none; }
	.feature-media-frame { margin: var(--spacing-80) var(--spacing-80) 0; aspect-ratio: 16 / 9; }
	.feature-media-viewport img { transition: transform var(--duration-slow) var(--curve-decelerate-mid); }
	.feature-card:hover .feature-media-viewport img { transform: scale(1.015); }
	.feature-ribbon {
		position: absolute;
		inset-block-start: var(--spacing-100);
		inset-inline-start: var(--spacing-100);
		display: inline-flex;
		min-height: 28px;
		align-items: center;
		padding-inline: var(--spacing-100);
		border: var(--stroke-thin) solid color-mix(in srgb, var(--color-brand-stroke-1) 72%, transparent);
		border-radius: var(--radius-circular);
		background: color-mix(in srgb, var(--color-brand-background) 84%, var(--color-neutral-background-1));
		color: var(--color-neutral-foreground-on-brand);
		font-size: var(--font-size-caption-1);
		font-weight: var(--font-weight-semibold);
		box-shadow: var(--shadow-4);
