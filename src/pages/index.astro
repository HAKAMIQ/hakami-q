---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const genericLabels = new Set([
	'articles',
	'article',
	'gaming articles',
	'gaming article',
	'مقالات',
	'المقالات',
	'ألعاب',
	'العاب',
]);

const broadLabels = new Set([
	'nintendo',
	'playstation',
	'xbox',
	'sega',
	'pc',
]);

const getDisplayCategory = (labels: string[] = []) => {
	const candidates = labels.filter((label) => !genericLabels.has(label.trim().toLocaleLowerCase('en')));
	return candidates.find((label) => !broadLabels.has(label.trim().toLocaleLowerCase('en'))) ?? candidates[0] ?? null;
};

const featuredPost = posts[0];
const featuredCategory = featuredPost ? getDisplayCategory(featuredPost.data.labels) : null;
const latestPosts = posts.slice(1, 7);
const searchItems = posts.map((post) => ({
	title: post.data.title,
	description: post.data.description ?? '',
	labels: post.data.labels ?? [],
	href: `/blog/${post.id}/`,
}));

const browseTerms = ['PlayStation', 'Nintendo', 'Xbox', 'SEGA', 'PC'];
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<SkipLink />
		<Header />

		<main id="main-content" class="home-page" tabindex="-1">
			<section class="home-search-section" aria-labelledby="home-search-title">
				<div class="site-container home-search-container">
					<div class="home-search-copy">
						<h1 id="home-search-title">بحث في المقالات</h1>
						<p>ابحث باسم المحاكي أو الجهاز للوصول إلى الشرح مباشرة.</p>
					</div>

					<div class="home-search" data-home-search>
						<div class="home-search-field">
							<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="5.5"></circle><path d="m13 13 4 4"></path></svg>
							<input
								id="home-search-input"
								type="search"
								placeholder="مثال: PCSX2 أو RPCS3 أو Nintendo Switch"
								autocomplete="off"
								spellcheck="false"
								aria-label="بحث في المقالات"
								aria-controls="home-search-results"
								aria-describedby="home-search-help"
								aria-expanded="false"
							/>
							<button class="home-search-clear" type="button" aria-label="مسح البحث" title="مسح البحث" hidden>
								<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg>
							</button>
						</div>
						<p class="sr-only" id="home-search-help">اكتب حرفين على الأقل للبحث في العناوين والتصنيفات والملخصات</p>
						<div class="home-search-results" id="home-search-results" aria-label="نتائج البحث" hidden></div>
						<p class="sr-only" id="home-search-status" role="status" aria-live="polite" aria-atomic="true"></p>
					</div>
				</div>
			</section>

			{featuredPost && (
				<section class="home-featured-section" aria-labelledby="featured-title">
					<div class="site-container home-editorial-container">
						<p class="section-kicker">أحدث مقال</p>
						<article class="lead-story">
							<a class="lead-story-link" href={`/blog/${featuredPost.id}/`} aria-label={`قراءة مقال: ${featuredPost.data.title}`}>
								<div class="lead-story-media">
									{featuredPost.data.heroImageUrl ? (
										<img
											src={featuredPost.data.heroImageUrl}
											alt={featuredPost.data.title}
											loading="eager"
											decoding="async"
											fetchpriority="high"
											referrerpolicy="no-referrer"
										/>
									) : (
										<div class="home-image-placeholder" aria-hidden="true">H</div>
									)}
								</div>

								<div class="lead-story-copy">
									{featuredCategory && <span class="story-category">{featuredCategory}</span>}
									<h2 id="featured-title">{featuredPost.data.title}</h2>
									{featuredPost.data.description && <p>{featuredPost.data.description}</p>}
									<span class="story-action" aria-hidden="true">
										قراءة المقال
										<svg viewBox="0 0 20 20"><path d="M15 10H5m4-4-4 4 4 4"></path></svg>
									</span>
								</div>
							</a>
						</article>
					</div>
				</section>
			)}

			<section class="home-latest-section" aria-labelledby="latest-posts-title">
				<div class="site-container home-editorial-container">
					<header class="home-section-heading">
						<div>
							<p class="section-kicker">جديد المكتبة</p>
							<h2 id="latest-posts-title">أحدث المقالات</h2>
						</div>
					</header>

					<ul class="editorial-list" aria-label="أحدث المقالات">
						{latestPosts.map((post) => {
							const category = getDisplayCategory(post.data.labels);
							return (
								<li>
									<article class="editorial-story">
										<a href={`/blog/${post.id}/`} aria-label={`قراءة مقال: ${post.data.title}`}>
											<div class="editorial-thumb">
												{post.data.heroImageUrl ? (
													<img src={post.data.heroImageUrl} alt={post.data.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
												) : (
													<div class="home-image-placeholder small" aria-hidden="true">H</div>
												)}
											</div>
											<div class="editorial-copy">
												{category && <span class="story-category">{category}</span>}
												<h3>{post.data.title}</h3>
												{post.data.description && <p>{post.data.description}</p>}
											</div>
											<svg class="row-arrow" viewBox="0 0 20 20" aria-hidden="true"><path d="M15 10H5m4-4-4 4 4 4"></path></svg>
										</a>
									</article>
								</li>
							);
						})}
					</ul>

					<div class="all-posts-action">
						<a class="fui-button fui-button--secondary" href="/blog">
							<span>عرض كل المقالات</span>
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15 10H5m4-4-4 4 4 4"></path></svg>
						</a>
					</div>
				</div>
			</section>

			<section class="home-platforms-section" aria-labelledby="platforms-title">
				<div class="site-container home-editorial-container">
					<div class="platforms-panel">
						<div class="platforms-copy">
							<p class="section-kicker">استكشاف</p>
							<h2 id="platforms-title">استكشف حسب المنصة</h2>
							<p>اختر منصة للبحث مباشرة في المقالات المرتبطة بها.</p>
						</div>
						<nav class="platform-links" aria-label="استكشف المقالات حسب المنصة">
							{browseTerms.map((term) => (
								<button type="button" data-search-term={term}>{term}</button>
							))}
						</nav>
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<script id="home-search-data" type="application/json" set:html={JSON.stringify(searchItems).replace(/</g, '\\u003c')}></script>
		<script>
			type HomeItem = { title: string; description: string; labels: string[]; href: string };

			const readHomeItems = () => {
				const dataElement = document.getElementById('home-search-data');
				if (!dataElement) return [] as HomeItem[];
				try { return JSON.parse(dataElement.textContent || '[]') as HomeItem[]; } catch { return [] as HomeItem[]; }
			};

			const initializeHomeSearch = () => {
				const root = document.querySelector<HTMLElement>('[data-home-search]');
				if (!root || root.dataset.initialized === 'true') return;
				root.dataset.initialized = 'true';
				const input = root.querySelector<HTMLInputElement>('#home-search-input');
				const results = root.querySelector<HTMLElement>('#home-search-results');
				const clearButton = root.querySelector<HTMLButtonElement>('.home-search-clear');
				const status = root.querySelector<HTMLElement>('#home-search-status');
				const browseButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-search-term]'));
				if (!input || !results || !clearButton || !status) return;
				const items = readHomeItems();
				const normalize = (value: string) => value
					.toLocaleLowerCase('ar').normalize('NFKD')
					.replace(/[\u064B-\u065F\u0670]/g, '').replace(/[أإآ]/g, 'ا')
					.replace(/ى/g, 'ي').replace(/ة/g, 'ه').replace(/\s+/g, ' ').trim();
				const closeResults = (clearStatus = false) => {
					results.hidden = true;
					results.replaceChildren();
					input.setAttribute('aria-expanded', 'false');
					if (clearStatus) status.textContent = '';
				};
				const render = () => {
					const query = normalize(input.value);
					clearButton.hidden = query.length === 0;
					if (query.length < 2) { closeResults(true); return; }
					const terms = query.split(' ').filter(Boolean);
					const matches = items.map((item) => {
						const title = normalize(item.title);
						const description = normalize(item.description);
						const labels = normalize(item.labels.join(' '));
						const haystack = `${title} ${labels} ${description}`;
						if (!terms.every((term) => haystack.includes(term))) return null;
						let score = 0;
						if (title === query) score += 100;
						if (title.startsWith(query)) score += 50;
						if (title.includes(query)) score += 30;
						if (labels.includes(query)) score += 15;
						return { item, score };
					}).filter((entry): entry is { item: HomeItem; score: number } => entry !== null)
						.sort((a, b) => b.score - a.score).slice(0, 8);
					results.replaceChildren();
					if (matches.length === 0) {
						const empty = document.createElement('p');
						empty.className = 'home-search-empty';
						empty.textContent = 'لا توجد نتائج مطابقة. جرّب اسم المحاكي أو الجهاز.';
						results.append(empty);
						status.textContent = 'لا توجد نتائج مطابقة';
					} else {
						for (const { item } of matches) {
							const link = document.createElement('a');
							link.href = item.href;
							link.className = 'home-search-result';
							const title = document.createElement('strong');
							title.textContent = item.title;
							link.append(title);
							if (item.labels.length > 0) {
								const meta = document.createElement('span');
								meta.textContent = item.labels.slice(0, 2).join(' · ');
								link.append(meta);
							}
							results.append(link);
						}
						status.textContent = `${matches.length} ${matches.length === 1 ? 'نتيجة' : 'نتائج'}`;
					}
					results.hidden = false;
					input.setAttribute('aria-expanded', 'true');
				};
				input.addEventListener('input', render);
				input.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') {
						input.value = '';
						clearButton.hidden = true;
						closeResults(true);
						input.blur();
					}
					if (event.key === 'Enter') {
						const first = results.querySelector<HTMLAnchorElement>('.home-search-result');
						if (first) window.location.href = first.href;
					}
				});
				clearButton.addEventListener('click', () => {
					input.value = '';
					clearButton.hidden = true;
					closeResults(true);
					input.focus();
				});
				for (const button of browseButtons) {
					button.addEventListener('click', () => {
						input.value = button.dataset.searchTerm ?? '';
						render();
						root.scrollIntoView({ behavior: 'smooth', block: 'center' });
						input.focus({ preventScroll: true });
					});
				}
				document.addEventListener('pointerdown', (event) => {
					if (event.target instanceof Node && !root.contains(event.target) && !(event.target instanceof Element && event.target.closest('[data-search-term]'))) closeResults();
				});
			};

			const initializeHome = () => initializeHomeSearch();
			if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeHome, { once: true });
			else initializeHome();
			document.addEventListener('astro:page-load', initializeHome);
		</script>
	</body>
</html>

<style is:global>
	.home-page {
		background: var(--color-neutral-background-4);
	}

	.home-search-section {
		padding-block: var(--spacing-240) var(--spacing-280);
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		background: var(--color-neutral-background-3);
	}

	.home-search-container {
		display: grid;
		grid-template-columns: minmax(220px, 0.7fr) minmax(360px, 1.3fr);
		align-items: center;
		gap: clamp(var(--spacing-200), 4vw, var(--spacing-400));
		max-width: 1080px;
	}

	.home-search-copy h1 {
		font-size: var(--font-size-title-2);
		line-height: var(--line-height-title-2);
	}

	.home-search-copy p {
		max-width: 440px;
		margin-top: var(--spacing-60);
		color: var(--color-neutral-foreground-3);
		font-size: var(--font-size-body-1);
		line-height: var(--line-height-body-1);
	}

	.home-search {
		position: relative;
		z-index: 20;
	}

	.home-search-field {
		display: flex;
		min-height: 48px;
		align-items: center;
		gap: var(--spacing-80);
		padding-inline: var(--spacing-120);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-medium);
		background: var(--color-neutral-background-1);
		box-shadow: var(--shadow-2);
		transition: border-color var(--duration-faster) var(--curve-easy-ease), box-shadow var(--duration-faster) var(--curve-easy-ease), background var(--duration-faster) var(--curve-easy-ease);
	}

	.home-search-field:focus-within {
		border-color: var(--color-brand-stroke-1);
		box-shadow: var(--focus-ring);
	}

	.home-search-field > svg {
		width: 18px;
		height: 18px;
		flex: 0 0 auto;
		fill: none;
		stroke: var(--color-neutral-foreground-3);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.home-search-field input {
		width: 100%;
		min-width: 0;
		height: 46px;
		padding: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--color-neutral-foreground-1);
		font-size: var(--font-size-body-1);
	}

	.home-search-field input::placeholder { color: var(--color-neutral-foreground-4); }
	.home-search-field input::-webkit-search-cancel-button { display: none; }

	.home-search-clear {
		display: grid;
		width: 32px;
		height: 32px;
		flex: 0 0 auto;
		place-items: center;
		padding: 0;
		border: 0;
		border-radius: var(--radius-medium);
		background: transparent;
		color: var(--color-neutral-foreground-3);
		cursor: pointer;
	}

	.home-search-clear[hidden] { display: none; }
	.home-search-clear:hover { background: var(--color-subtle-background-hover); color: var(--color-neutral-foreground-1); }
	.home-search-clear svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.6; }

	.home-search-results {
		position: absolute;
		inset-inline: 0;
		top: calc(100% + var(--spacing-60));
		overflow: hidden;
		padding: var(--spacing-60);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-1);
		box-shadow: var(--shadow-16);
	}

	.home-search-results[hidden] { display: none; }
	.home-search-result { display: flex; min-height: 52px; flex-direction: column; justify-content: center; gap: 2px; padding: var(--spacing-80) var(--spacing-100); border-radius: var(--radius-medium); color: var(--color-neutral-foreground-1); text-decoration: none; }
	.home-search-result:hover, .home-search-result:focus-visible { background: var(--color-subtle-background-hover); }
	.home-search-result strong { display: -webkit-box; overflow: hidden; font-size: var(--font-size-body-1); font-weight: var(--font-weight-semibold); line-height: var(--line-height-body-1); -webkit-box-orient: vertical; -webkit-line-clamp: 1; }
	.home-search-result span { color: var(--color-neutral-foreground-3); font-size: var(--font-size-caption-1); line-height: var(--line-height-caption-1); }
	.home-search-empty { margin: 0; padding: var(--spacing-160); color: var(--color-neutral-foreground-3); font-size: var(--font-size-body-1); text-align: center; }

	.home-editorial-container {
		width: min(calc(100% - (var(--page-gutter) * 2)), 1080px);
	}

	.home-featured-section {
		padding-block: var(--spacing-320) var(--spacing-360);
	}

	.section-kicker {
		margin-bottom: var(--spacing-60);
		color: var(--color-brand-foreground-strong);
		font-size: var(--font-size-caption-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-caption-1);
	}

	.lead-story {
		margin-top: var(--spacing-100);
		border-block: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
	}

	.lead-story-link {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
		align-items: stretch;
		color: inherit;
		direction: ltr;
		text-decoration: none;
	}

	.lead-story-media {
		min-height: 260px;
		max-height: 340px;
		overflow: hidden;
		background: var(--color-neutral-background-3);
	}

	.lead-story-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--motion-duration-page) var(--curve-decelerate-mid);
	}

	.lead-story-copy {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		padding: clamp(var(--spacing-180), 3vw, var(--spacing-320));
		direction: rtl;
		text-align: start;
	}

	.story-category {
		display: inline-flex;
		max-width: 100%;
		align-items: center;
		gap: var(--spacing-60);
		overflow: hidden;
		color: var(--color-brand-foreground-strong);
		font-size: var(--font-size-caption-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-caption-1);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.story-category::before {
		width: 5px;
		height: 5px;
		flex: 0 0 auto;
		border-radius: var(--radius-circular);
		background: var(--color-brand-background);
		content: '';
	}

	.lead-story-copy h2 {
		display: -webkit-box;
		overflow: hidden;
		margin-top: var(--spacing-80);
		font-size: var(--font-size-title-3);
		line-height: var(--line-height-title-3);
		text-wrap: balance;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.lead-story-copy > p {
		display: -webkit-box;
		overflow: hidden;
		margin-top: var(--spacing-100);
		color: var(--color-neutral-foreground-2);
		font-size: var(--font-size-body-1);
		line-height: var(--line-height-body-1);
		text-wrap: pretty;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.story-action {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-60);
		margin-top: var(--spacing-160);
		color: var(--color-brand-foreground-link);
		font-size: var(--font-size-body-1);
		font-weight: var(--font-weight-semibold);
	}

	.story-action svg,
	.all-posts-action svg,
	.row-arrow {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
	}

	.lead-story-link:hover .lead-story-media img { transform: scale(1.012); }
	.lead-story-link:hover .story-action { color: var(--color-brand-foreground-link-hover); }
	.lead-story-link:focus-visible { outline: 2px solid var(--color-brand-stroke-1); outline-offset: 4px; }

	.home-image-placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		min-height: 180px;
		place-items: center;
		background: var(--color-neutral-background-3);
		color: var(--color-neutral-foreground-4);
		font-size: var(--font-size-title-3);
		font-weight: var(--font-weight-semibold);
	}

	.home-image-placeholder.small { min-height: 0; font-size: var(--font-size-subtitle-2); }

	.home-latest-section {
		padding-block: var(--spacing-280) var(--spacing-360);
		border-top: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		background: var(--color-neutral-background-2);
	}

	.home-section-heading {
		margin-bottom: var(--spacing-160);
	}

	.home-section-heading h2,
	.platforms-copy h2 {
		font-size: var(--font-size-title-3);
		line-height: var(--line-height-title-3);
	}

	.editorial-list {
		padding: 0;
		border-top: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
		list-style: none;
	}

	.editorial-list > li {
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-alpha);
	}

	.editorial-story > a {
		display: grid;
		grid-template-columns: 184px minmax(0, 1fr) 24px;
		align-items: center;
		gap: var(--spacing-160);
		padding-block: var(--spacing-140);
		color: inherit;
		text-decoration: none;
		transition: background var(--duration-faster) var(--curve-easy-ease);
	}

	.editorial-story > a:hover {
		background: var(--color-subtle-background-hover);
	}

	.editorial-story > a:focus-visible {
		outline: 2px solid var(--color-brand-stroke-1);
		outline-offset: 2px;
	}

	.editorial-thumb {
		width: 184px;
		aspect-ratio: 16 / 9;
