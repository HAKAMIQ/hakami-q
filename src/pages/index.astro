---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const genericLabels = new Set([
	'articles',
	'article',
	'gaming articles',
	'gaming article',
	'مقالات',
	'المقالات',
	'ألعاب',
	'العاب',
]);

const broadLabels = new Set([
	'nintendo',
	'playstation',
	'xbox',
	'sega',
	'pc',
]);

const getDisplayCategory = (labels: string[] = []) => {
	const candidates = labels.filter((label) => !genericLabels.has(label.trim().toLocaleLowerCase('en')));
	return candidates.find((label) => !broadLabels.has(label.trim().toLocaleLowerCase('en'))) ?? candidates[0] ?? null;
};

const featuredPosts = posts.slice(0, 2);
const picks = posts.slice(2, 6);
const latestRows = posts.slice(6, 10);
const libraryPosts = posts.slice(10, 14);
const explorePosts = posts.slice(14, 18);

const searchItems = posts.map((post) => ({
	title: post.data.title,
	description: post.data.description ?? '',
	labels: post.data.labels ?? [],
	href: `/blog/${post.id}/`,
}));
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<SkipLink />
		<Header />

		<main id="main-content" class="home-page" tabindex="-1">
			<h1 class="sr-only">HAKAMIQ</h1>

			<section class="home-news-section" aria-label="واجهة المقالات">
				<div class="site-container home-shell">
					<div class="home-editorial-grid">
						<section class="top-stories" aria-labelledby="top-stories-title">
							<div class="section-heading section-heading--compact top-stories-heading">
								<h2 id="top-stories-title">المقالات الرئيسية</h2>

								<div class="home-toolbar">
									<div class="home-search" data-home-search>
										<div class="home-search-field">
											<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="5.5"></circle><path d="m13 13 4 4"></path></svg>
											<input
												id="home-search-input"
												type="search"
												placeholder="ابحث في المقالات"
												autocomplete="off"
												spellcheck="false"
												aria-label="بحث في المقالات"
												aria-controls="home-search-results"
												aria-describedby="home-search-help"
												aria-expanded="false"
											/>
											<button class="home-search-clear" type="button" aria-label="مسح البحث" title="مسح البحث" hidden>
												<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg>
											</button>
										</div>
										<p class="sr-only" id="home-search-help">اكتب حرفين على الأقل للبحث في العناوين والتصنيفات والملخصات</p>
										<div class="home-search-results" id="home-search-results" aria-label="نتائج البحث" hidden></div>
										<p class="sr-only" id="home-search-status" role="status" aria-live="polite" aria-atomic="true"></p>
									</div>

									<a class="all-posts-top" href="/blog">
										<span>كل المقالات</span>
										<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15 10H5m4-4-4 4 4 4"></path></svg>
									</a>
								</div>
							</div>

							<div class="featured-grid">
								{featuredPosts.map((post, index) => {
									const category = getDisplayCategory(post.data.labels);
									return (
										<article class:list={['feature-card', index === 0 && 'feature-card--primary']}>
											<a href={`/blog/${post.id}/`} aria-label={`قراءة مقال: ${post.data.title}`}>
												<div class="feature-media-frame">
													<div class="feature-media-viewport">
														{post.data.heroImageUrl ? (
															<img
																src={post.data.heroImageUrl}
																alt={post.data.title}
																loading={index === 0 ? 'eager' : 'lazy'}
																decoding="async"
																fetchpriority={index === 0 ? 'high' : undefined}
																referrerpolicy="no-referrer"
															/>
														) : (
															<div class="home-image-placeholder" aria-hidden="true">H</div>
														)}
														<span class="feature-image-scrim" aria-hidden="true"></span>
														{category && <span class="story-category feature-category">{category}</span>}
														<h3 class="feature-image-title">{post.data.title}</h3>
													</div>
												</div>

												<div class="feature-copy">
													{post.data.description && <p>{post.data.description}</p>}
												</div>
											</a>
										</article>
									);
								})}
							</div>
						</section>

						<aside class="home-picks" aria-labelledby="picks-title">
							<div class="picks-heading">
								<span class="section-label">مقالات عشوائية</span>
								<h2 id="picks-title">مختارات HAKAMIQ</h2>
							</div>

							<div class="picks-list">
								{picks.map((post, index) => {
									const category = getDisplayCategory(post.data.labels);
									return (
										<article class="pick-card">
											<a href={`/blog/${post.id}/`} aria-label={`قراءة مقال: ${post.data.title}`}>
												<span class="pick-rank" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
												<div class="pick-copy">
													{category && <span class="story-category compact">{category}</span>}
													<h3>{post.data.title}</h3>
												</div>
												<div class="pick-media-frame">
													<div class="pick-media-viewport">
														{post.data.heroImageUrl ? (
															<img src={post.data.heroImageUrl} alt={post.data.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
														) : (
															<div class="home-image-placeholder small" aria-hidden="true">H</div>
														)}
													</div>
												</div>
											</a>
										</article>
									);
								})}
							</div>
						</aside>
					</div>

					<section class="latest-section" aria-label="أحدث المقالات">
						<div class="latest-rows" aria-label="مقالات حديثة">
							{latestRows.map((post) => {
								const category = getDisplayCategory(post.data.labels);
								return (
									<article class="article-row">
										<a href={`/blog/${post.id}/`} aria-label={`قراءة مقال: ${post.data.title}`}>
											<div class="row-media-frame">
												<div class="row-media-viewport">
													{post.data.heroImageUrl ? (
														<img src={post.data.heroImageUrl} alt={post.data.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
													) : (
														<div class="home-image-placeholder small" aria-hidden="true">H</div>
													)}
												</div>
											</div>
											<div class="row-copy">
												{category && <span class="story-category compact">{category}</span>}
												<h3>{post.data.title}</h3>
												{post.data.description && <p>{post.data.description}</p>}
											</div>
										</a>
									</article>
								);
							})}
						</div>
					</section>

					{libraryPosts.length > 0 && (
						<section class="library-section" aria-labelledby="library-title">
							<div class="section-heading">
								<div>
									<span class="section-label">قراءة أعمق</span>
									<h2 id="library-title">من مكتبة HAKAMIQ</h2>
								</div>
							</div>
							<div class="library-grid">
								{libraryPosts.map((post) => {
									const category = getDisplayCategory(post.data.labels);
									return (
										<article class="library-card">
											<a href={`/blog/${post.id}/`} aria-label={`قراءة مقال: ${post.data.title}`}>
												<div class="library-media">
													{post.data.heroImageUrl ? (
														<img src={post.data.heroImageUrl} alt={post.data.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
													) : (
														<div class="home-image-placeholder small" aria-hidden="true">H</div>
													)}
												</div>
												<div class="library-copy">
													{category && <span class="story-category compact">{category}</span>}
													<h3>{post.data.title}</h3>
												</div>
											</a>
										</article>
									);
								})}
							</div>
						</section>
					)}

					{explorePosts.length > 0 && (
						<section class="explore-section" aria-labelledby="explore-title">
							<div class="section-heading">
								<h2 id="explore-title">استكشف المزيد</h2>
							</div>
							<div class="explore-grid">
								{explorePosts.map((post) => (
									<a href={`/blog/${post.id}/`} class="explore-link">
										<span>{post.data.title}</span>
									</a>
								))}
							</div>
						</section>
					)}

					<div class="all-posts-action">
						<a class="all-posts-button" href="/blog">
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3.5h10v13H5zM8 7h4M8 10h4M8 13h4"></path></svg>
							<span>عرض كل المقالات</span>
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<script id="home-search-data" type="application/json" set:html={JSON.stringify(searchItems).replace(/</g, '\\u003c')}></script>
		<script>
			type HomeItem = { title: string; description: string; labels: string[]; href: string };

			const readHomeItems = () => {
				const dataElement = document.getElementById('home-search-data');
				if (!dataElement) return [] as HomeItem[];
				try { return JSON.parse(dataElement.textContent || '[]') as HomeItem[]; } catch { return [] as HomeItem[]; }
			};

			const initializeHomeSearch = () => {
				const root = document.querySelector<HTMLElement>('[data-home-search]');
				if (!root || root.dataset.initialized === 'true') return;
				root.dataset.initialized = 'true';
				const input = root.querySelector<HTMLInputElement>('#home-search-input');
				const results = root.querySelector<HTMLElement>('#home-search-results');
				const clearButton = root.querySelector<HTMLButtonElement>('.home-search-clear');
				const status = root.querySelector<HTMLElement>('#home-search-status');
				if (!input || !results || !clearButton || !status) return;

				const items = readHomeItems();
				const normalize = (value: string) => value
					.toLocaleLowerCase('ar')
					.normalize('NFKD')
					.replace(/[\u064B-\u065F\u0670]/g, '')
					.replace(/[أإآ]/g, 'ا')
					.replace(/ى/g, 'ي')
					.replace(/ة/g, 'ه')
					.replace(/\s+/g, ' ')
					.trim();

				const closeResults = (clearStatus = false) => {
					results.hidden = true;
					results.replaceChildren();
					input.setAttribute('aria-expanded', 'false');
					if (clearStatus) status.textContent = '';
				};

				const render = () => {
					const query = normalize(input.value);
					clearButton.hidden = query.length === 0;
					if (query.length < 2) {
						closeResults(true);
						return;
					}

					const matches = items
						.map((item) => ({ item, haystack: normalize([item.title, item.description, ...item.labels].join(' ')) }))
						.filter(({ haystack }) => haystack.includes(query))
						.slice(0, 8);

					results.replaceChildren();
					if (matches.length === 0) {
						const empty = document.createElement('p');
						empty.className = 'home-search-empty';
						empty.textContent = 'لا توجد نتائج مطابقة.';
						results.append(empty);
						status.textContent = 'لا توجد نتائج مطابقة';
					} else {
						for (const { item } of matches) {
							const link = document.createElement('a');
							link.href = item.href;
							link.className = 'home-search-result';

							const title = document.createElement('strong');
							title.textContent = item.title;
							link.append(title);

							if (item.labels.length > 0) {
								const meta = document.createElement('span');
								meta.textContent = item.labels.slice(0, 2).join(' · ');
								link.append(meta);
							}
							results.append(link);
						}
						status.textContent = `${matches.length} ${matches.length === 1 ? 'نتيجة' : 'نتائج'}`;
					}

					results.hidden = false;
					input.setAttribute('aria-expanded', 'true');
				};

				input.addEventListener('input', render);
				input.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') {
						input.value = '';
						clearButton.hidden = true;
						closeResults(true);
						input.blur();
					}
					if (event.key === 'Enter') {
						const first = results.querySelector<HTMLAnchorElement>('.home-search-result');
						if (first) window.location.href = first.href;
					}
				});

				clearButton.addEventListener('click', () => {
					input.value = '';
					clearButton.hidden = true;
					closeResults(true);
					input.focus();
				});

				document.addEventListener('pointerdown', (event) => {
					if (event.target instanceof Node && !root.contains(event.target)) closeResults();
				});
			};

			const initializeHome = () => initializeHomeSearch();
			if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeHome, { once: true });
			else initializeHome();
			document.addEventListener('astro:page-load', initializeHome);
		</script>
	</body>
</html>

<style>
	.home-page { background: var(--color-neutral-background-4); }
	.home-news-section { padding-block: var(--spacing-160) var(--spacing-400); }
	.home-shell { width: min(calc(100% - (var(--page-gutter) * 2)), 1380px); }

	.home-toolbar {
		display: flex;
		min-width: 0;
		flex: 1;
		align-items: center;
		justify-content: flex-end;
		gap: var(--spacing-80);
	}

	.home-search { position: relative; z-index: 30; width: min(320px, 34vw); }
	.home-search-field {
		display: flex;
		min-height: 40px;
		align-items: center;
		gap: var(--spacing-60);
		padding-inline: var(--spacing-100);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-2);
		box-shadow: var(--shadow-2);
		transition: border-color var(--duration-faster) var(--curve-easy-ease), box-shadow var(--duration-faster) var(--curve-easy-ease);
	}
	.home-search:focus-within .home-search-field { border-color: var(--color-brand-stroke-1); box-shadow: var(--focus-ring); }
	.home-search-field > svg { width: 17px; height: 17px; flex: 0 0 auto; fill: none; stroke: var(--color-neutral-foreground-3); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }
	.home-search-field input { width: 100%; min-width: 0; height: 38px; padding: 0; border: 0; outline: 0; background: transparent; color: var(--color-neutral-foreground-1); font-size: var(--font-size-body-1); }
	.home-search-field input::placeholder { color: var(--color-neutral-foreground-4); }
	.home-search-field input::-webkit-search-cancel-button { display: none; }
	.home-search-clear { display: grid; width: 30px; height: 30px; flex: 0 0 auto; place-items: center; padding: 0; border: 0; border-radius: var(--radius-medium); background: transparent; color: var(--color-neutral-foreground-3); cursor: pointer; }
	.home-search-clear[hidden] { display: none; }
	.home-search-clear:hover { background: var(--color-subtle-background-hover); color: var(--color-neutral-foreground-1); }
	.home-search-clear svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.6; }
	.home-search-results { position: absolute; inset-inline: 0; top: calc(100% + var(--spacing-60)); overflow: hidden; padding: var(--spacing-60); border: var(--stroke-thin) solid var(--color-neutral-stroke-1); border-radius: var(--radius-large); background: var(--color-neutral-background-1); box-shadow: var(--shadow-16); }
	.home-search-results[hidden] { display: none; }
	:global(.home-search-result) { display: flex; min-height: 50px; flex-direction: column; justify-content: center; gap: 2px; padding: var(--spacing-80) var(--spacing-100); border-radius: var(--radius-medium); color: var(--color-neutral-foreground-1); text-decoration: none; }
	:global(.home-search-result:hover), :global(.home-search-result:focus-visible) { background: var(--color-subtle-background-hover); }
	:global(.home-search-result strong) { overflow: hidden; font-size: var(--font-size-body-1); font-weight: var(--font-weight-semibold); line-height: var(--line-height-body-1); text-overflow: ellipsis; white-space: nowrap; }
	:global(.home-search-result span) { color: var(--color-neutral-foreground-3); font-size: var(--font-size-caption-1); }
	:global(.home-search-empty) { margin: 0; padding: var(--spacing-160); color: var(--color-neutral-foreground-3); text-align: center; }

	.all-posts-top,
	.all-posts-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-60);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-2);
		color: var(--color-neutral-foreground-1);
		font-size: var(--font-size-body-1);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
	}
	.all-posts-top { min-height: 40px; flex: 0 0 auto; padding-inline: var(--spacing-120); }
	.all-posts-button { min-width: 230px; min-height: 44px; padding-inline: var(--spacing-160); }
	.all-posts-top:hover,
	.all-posts-top:focus-visible,
	.all-posts-button:hover,
	.all-posts-button:focus-visible { border-color: var(--color-brand-stroke-1); background: var(--color-neutral-background-1); }
	.all-posts-top svg,
	.all-posts-button svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }

	.home-editorial-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: var(--spacing-160);
		align-items: stretch;
	}

	.top-stories,
	.home-picks {
		display: flex;
		min-width: 0;
		flex-direction: column;
	}

	.section-heading,
	.picks-heading {
		display: flex;
		min-height: 62px;
		align-items: end;
		justify-content: space-between;
		gap: var(--spacing-120);
		margin-bottom: var(--spacing-100);
		padding-bottom: var(--spacing-80);
		border-bottom: var(--stroke-thin) solid var(--color-neutral-stroke-2);
	}
	.top-stories-heading { min-height: 58px; align-items: center; }
	.top-stories-heading > h2 { flex: 0 0 auto; }
	.section-heading h2,
	.picks-heading h2 { margin: 0; font-size: var(--font-size-title-3); line-height: var(--line-height-title-3); }
	.section-label { display: block; margin-bottom: var(--spacing-20); color: var(--color-brand-foreground-strong); font-size: var(--font-size-caption-1); font-weight: var(--font-weight-semibold); }

	.featured-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.55fr) minmax(290px, .95fr);
		gap: var(--spacing-120);
		flex: 1;
		align-items: stretch;
	}
	.feature-card {
		min-width: 0;
		overflow: hidden;
		border: var(--stroke-thin) solid var(--color-neutral-stroke-2);
		border-radius: var(--radius-xlarge);
		background: var(--color-neutral-background-2);
		box-shadow: var(--shadow-4);
	}
	.feature-card > a { display: flex; height: 100%; min-height: 0; flex-direction: column; color: inherit; text-decoration: none; }
	.feature-media-frame,
	.pick-media-frame,
	.row-media-frame {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-large);
		background: var(--color-neutral-background-5);
	}
	.feature-media-frame { min-height: 220px; flex: 1; margin: var(--spacing-80) var(--spacing-80) 0; }
	.feature-media-viewport,
	.pick-media-viewport,
	.row-media-viewport { width: 100%; height: 100%; overflow: hidden; }
	.feature-media-viewport { position: relative; }
	.feature-media-viewport img,
	.pick-media-viewport img,
	.row-media-viewport img,
	.library-media img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
	.feature-image-scrim {
		position: absolute;
		z-index: 1;
		inset: 0;
		background: linear-gradient(
			to top,
			color-mix(in srgb, var(--color-neutral-background-5) 86%, transparent) 0%,
			color-mix(in srgb, var(--color-neutral-background-5) 42%, transparent) 46%,
			transparent 76%
		);
		pointer-events: none;
	}
	.feature-category {
		position: absolute;
		z-index: 2;
		inset-block-start: var(--spacing-100);
		inset-inline-end: var(--spacing-100);
		box-shadow: var(--shadow-2);
	}
	.feature-image-title {
		position: absolute;
		z-index: 2;
		inset-inline: var(--spacing-120);
		inset-block-end: var(--spacing-120);
		display: -webkit-box;
		overflow: hidden;
		margin: 0;
		color: var(--color-neutral-foreground-1);
		font-size: var(--font-size-subtitle-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-subtitle-1);
		text-align: start;
		text-shadow:
			0 1px 2px color-mix(in srgb, var(--color-neutral-background-5) 72%, transparent),
			0 2px 6px color-mix(in srgb, var(--color-neutral-background-5) 62%, transparent);
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}
	.feature-card--primary .feature-image-title { font-size: var(--font-size-title-3); line-height: var(--line-height-title-3); }
