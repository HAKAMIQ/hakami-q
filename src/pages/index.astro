---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const latestPosts = posts.slice(1, 7);

const categories = [
	{
		name: 'PlayStation',
		description: 'PS1 وPS2 وPS3 وPS4 وPSP وVita',
		icon: 'PS',
	},
	{
		name: 'Nintendo',
		description: 'Switch وWii U وWii وGameCube و3DS',
		icon: 'N',
	},
	{
		name: 'Xbox',
		description: 'Xbox وXbox 360 ومحاكيات Xemu وXenia',
		icon: 'X',
	},
	{
		name: 'SEGA',
		description: 'Dreamcast وSaturn وGenesis وأجهزة SEGA',
		icon: 'S',
	},
	{
		name: 'PC Emulation',
		description: 'الأدوات والإعدادات وحلول تشغيل المحاكيات',
		icon: 'PC',
	},
];

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('ar-SA', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}).format(date);
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero-section">
				<div class="site-container hero-content">
					<h1>دليل HAKAMIQ للمحاكيات والألعاب</h1>
					<p>
						شروحات عربية عملية لإعداد المحاكيات وتشغيل الألعاب وحل المشاكل على الكمبيوتر
						وأجهزة الألعاب القديمة
					</p>

					<div class="hero-actions">
						<a class="primary-button" href="/blog">تصفح المقالات</a>
						<a class="secondary-button" href="/emulators">دليل المحاكيات</a>
					</div>
				</div>
			</section>

			<section class="content-section">
				<div class="site-container">
					<div class="section-heading">
						<h2>أحدث المقالات</h2>
						<a href="/blog">عرض جميع المقالات</a>
					</div>

					{
						featuredPost && (
							<div class="latest-layout">
								<article class="featured-card">
									<a href={`/blog/${featuredPost.id}/`}>
										<div class="featured-image">
											{featuredPost.data.heroImageUrl ? (
												<img
													src={featuredPost.data.heroImageUrl}
													alt={featuredPost.data.title}
													loading="eager"
													fetchpriority="high"
													referrerpolicy="no-referrer"
												/>
											) : (
												<div class="image-placeholder">HAKAMIQ</div>
											)}
										</div>

										<div class="featured-content">
											<h3>{featuredPost.data.title}</h3>
											<p>{featuredPost.data.description}</p>
											<time datetime={featuredPost.data.pubDate.toISOString()}>
												{formatDate(featuredPost.data.pubDate)}
											</time>
										</div>
									</a>
								</article>

								<div class="latest-list">
									{latestPosts.map((post) => (
										<article class="post-card">
											<a href={`/blog/${post.id}/`}>
												<div class="post-thumb">
													{post.data.heroImageUrl ? (
														<img
															src={post.data.heroImageUrl}
															alt={post.data.title}
															loading="lazy"
															referrerpolicy="no-referrer"
														/>
													) : (
														<div class="image-placeholder small">H</div>
													)}
												</div>

												<div class="post-card-content">
													<h3>{post.data.title}</h3>
													<time datetime={post.data.pubDate.toISOString()}>
														{formatDate(post.data.pubDate)}
													</time>
												</div>
											</a>
										</article>
									))}
								</div>
							</div>
						)
					}
				</div>
			</section>

			<section class="categories-section">
				<div class="site-container">
					<div class="section-heading">
						<h2>الأقسام الرئيسية</h2>
					</div>

					<div class="category-grid">
						{
							categories.map((category) => (
								<a class="category-card" href="/blog">
									<span class="category-icon">{category.icon}</span>
									<span class="category-copy">
										<strong>{category.name}</strong>
										<small>{category.description}</small>
									</span>
									<span class="category-arrow" aria-hidden="true">←</span>
								</a>
							))
						}
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero-section {
		position: relative;
		overflow: hidden;
		padding: clamp(3.5rem, 7vw, 6.5rem) 0;
		border-bottom: 1px solid var(--hq-border);
		background:
			radial-gradient(circle at 82% 22%, rgba(229, 21, 21, 0.17), transparent 34%),
			linear-gradient(180deg, #171a20, #111418);
	}

	.hero-section::after {
		position: absolute;
		inset: auto -10rem -16rem auto;
		width: 34rem;
		height: 34rem;
		border: 1px solid rgba(229, 21, 21, 0.13);
		border-radius: 50%;
		content: '';
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 1180px;
	}

	h1 {
		max-width: 900px;
		font-size: clamp(2.35rem, 5.4vw, 4.7rem);
		line-height: 1.22;
		letter-spacing: -0.035em;
	}

	.hero-content > p {
		max-width: 760px;
		margin-top: 1.25rem;
		color: var(--hq-muted);
		font-size: clamp(1rem, 1.7vw, 1.16rem);
		line-height: 1.95;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.hero-actions a {
		display: inline-flex;
		min-height: 46px;
		align-items: center;
		justify-content: center;
		padding: 0.72rem 1.2rem;
		border-radius: 12px;
		font-weight: 800;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.hero-actions a:hover {
		transform: translateY(-2px);
	}

	.primary-button {
		background: linear-gradient(135deg, #ff2d36, var(--hq-red-dark));
		box-shadow: 0 13px 28px rgba(229, 21, 21, 0.24);
		color: white;
	}

	.secondary-button {
		border: 1px solid var(--hq-border);
		background: rgba(255, 255, 255, 0.035);
		color: var(--hq-text);
	}

	.secondary-button:hover {
		border-color: rgba(229, 21, 21, 0.6);
		background: rgba(229, 21, 21, 0.08);
	}

	.content-section,
	.categories-section {
		padding-top: 4rem;
	}

	.section-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.4rem;
	}

	.section-heading h2 {
		font-size: clamp(1.75rem, 3vw, 2.35rem);
	}

	.section-heading > a {
		color: var(--hq-muted);
		font-size: 0.88rem;
		text-decoration: none;
	}

	.section-heading > a:hover {
		color: var(--hq-text);
	}

	.latest-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(340px, 0.85fr);
		gap: 1.25rem;
	}

	.featured-card,
	.post-card,
	.category-card {
		border: 1px solid var(--hq-border);
		background: var(--hq-card);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
	}

	.featured-card {
		overflow: hidden;
		border-radius: var(--hq-radius-lg);
	}

	.featured-card > a {
		display: grid;
		height: 100%;
		text-decoration: none;
	}

	.featured-image {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #0d1014;
	}

	.featured-image img,
	.post-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.featured-card:hover img,
	.post-card:hover img {
		transform: scale(1.035);
	}

	.image-placeholder {
		display: grid;
		width: 100%;
		height: 100%;
		place-items: center;
		background:
			linear-gradient(135deg, rgba(229, 21, 21, 0.2), transparent),
			#181c22;
		color: rgba(255, 255, 255, 0.3);
		font-size: 2rem;
		font-weight: 900;
	}

	.image-placeholder.small {
		font-size: 1.3rem;
	}

	.featured-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.5rem;
	}

	.featured-content h3 {
		font-size: clamp(1.35rem, 2.4vw, 2rem);
	}

	.featured-content p {
		display: -webkit-box;
		overflow: hidden;
		margin-top: 0.75rem;
		color: var(--hq-muted);
		font-size: 0.92rem;
		line-height: 1.8;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.featured-content time,
	.post-card-content time {
		margin-top: 1rem;
		color: var(--hq-muted);
		font-size: 0.76rem;
	}

	.latest-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.post-card {
		overflow: hidden;
		border-radius: var(--hq-radius-md);
		transition:
			transform 0.2s ease,
			border-color 0.2s ease;
	}

	.post-card:hover,
	.category-card:hover {
		border-color: rgba(229, 21, 21, 0.5);
		transform: translateY(-3px);
	}

	.post-card > a {
		display: block;
		height: 100%;
		text-decoration: none;
	}

	.post-thumb {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #0d1014;
	}

	.post-card-content {
		display: flex;
		min-height: 126px;
		flex-direction: column;
		align-items: flex-start;
		padding: 0.9rem;
	}

	.post-card-content h3 {
		display: -webkit-box;
		overflow: hidden;
		font-size: 0.96rem;
		line-height: 1.55;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.post-card-content time {
		margin-top: auto;
		padding-top: 0.65rem;
	}

	.categories-section {
		padding-bottom: 1rem;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 1rem;
	}

	.category-card {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.8rem;
		min-height: 112px;
		padding: 1rem;
		border-radius: var(--hq-radius-md);
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease;
	}

	.category-icon {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border-radius: 13px;
		background: rgba(229, 21, 21, 0.13);
		color: #ff646b;
		font-size: 0.8rem;
		font-weight: 900;
	}

	.category-copy {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
	}

	.category-copy strong {
		color: var(--hq-text);
		font-size: 0.92rem;
	}

	.category-copy small {
		color: var(--hq-muted);
		font-size: 0.7rem;
		line-height: 1.5;
	}

	.category-arrow {
		color: var(--hq-muted);
	}

	@media (max-width: 1150px) {
		.category-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 980px) {
		.latest-layout {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 700px) {
		.hero-section {
			padding: 3.25rem 0;
		}

		.latest-list,
		.category-grid {
			grid-template-columns: 1fr;
		}

		.section-heading {
			align-items: flex-start;
		}

		.section-heading > a {
			margin-top: 0.4rem;
		}

		.featured-content {
			padding: 1.15rem;
		}

		.post-card > a {
			display: grid;
			grid-template-columns: 125px minmax(0, 1fr);
		}

		.post-thumb {
			height: 100%;
		aspect-ratio: auto;
		}

		.post-card-content {
			min-height: 112px;
		}
	}

	@media (max-width: 440px) {
		.hero-actions a {
			width: 100%;
		}

		.section-heading {
			flex-direction: column;
		}

		.post-card > a {
			grid-template-columns: 105px minmax(0, 1fr);
		}
	}
</style>
