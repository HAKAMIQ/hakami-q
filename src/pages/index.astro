@"
---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<h1>HAKAMIQ</h1>
				<p>
					دليل وشروحات المحاكيات والألعاب على الكمبيوتر وأجهزة الألعاب القديمة.
				</p>
			</section>

			<section>
				<h2>أحدث المقالات</h2>
				<p>
					شروحات المحاكيات، إعداد الألعاب، حلول المشاكل، وأدلة التشغيل.
				</p>

				<a href="/blog">
					تصفح المقالات
				</a>
			</section>

			<section>
				<h2>الأقسام</h2>

				<ul>
					<li>PlayStation</li>
					<li>Nintendo</li>
					<li>Xbox</li>
					<li>SEGA</li>
					<li>PC Emulation</li>
				</ul>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 900px;
		margin: auto;
		padding: 2rem;
	}

	.hero {
		text-align: center;
		padding: 4rem 1rem;
	}

	h1 {
		font-size: 3rem;
	}

	section {
		margin-bottom: 3rem;
	}

	a {
		display: inline-block;
		margin-top: 1rem;
	}
</style>
"@ | Set-Content -Encoding UTF8 .\src\pages\index.astro