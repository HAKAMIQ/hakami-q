---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const genericLabels = new Set([
	'articles',
	'article',
	'gaming articles',
	'gaming article',
	'مقالات',
	'المقالات',
	'ألعاب',
	'العاب',
]);

const broadLabels = new Set([
	'nintendo',
	'playstation',
	'xbox',
	'sega',
	'pc',
]);

const getDisplayCategory = (labels: string[] = []) => {
	const candidates = labels.filter((label) => !genericLabels.has(label.trim().toLocaleLowerCase('en')));
	return candidates.find((label) => !broadLabels.has(label.trim().toLocaleLowerCase('en'))) ?? candidates[0] ?? null;
};

const featuredPost = posts[0];
const featuredCategory = featuredPost ? getDisplayCategory(featuredPost.data.labels) : null;
const latestPosts = posts.slice(1, 7);
const searchItems = posts.map((post) => ({
	title: post.data.title,
	description: post.data.description ?? '',
	labels: post.data.labels ?? [],
	href: `/blog/${post.id}/`,
}));

const browseTerms = ['PlayStation', 'Nintendo', 'Xbox', 'SEGA', 'PC'];
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="home-search-section" aria-labelledby="home-search-title">
				<div class="site-container">
					<div class="home-search-wrap">
						<h1 class="home-search-title" id="home-search-title">بحث في المقالات</h1>

						<div class="home-search" data-home-search>
							<div class="home-search-field">
								<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="5.5"></circle><path d="m13 13 4 4"></path></svg>
								<input
									id="home-search-input"
									type="search"
									placeholder="ابحث عن PCSX2 أو RPCS3 أو Nintendo Switch..."
									autocomplete="off"
									spellcheck="false"
									aria-label="بحث في المقالات"
									aria-controls="home-search-results"
									aria-expanded="false"
								/>
								<button class="home-search-clear" type="button" aria-label="مسح البحث" title="مسح البحث" hidden>
									<svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg>
								</button>
							</div>
							<div class="home-search-results" id="home-search-results" role="listbox" aria-label="نتائج البحث" hidden></div>
						</div>

						<nav class="browse-shortcuts" aria-label="تصفح سريع حسب المنصة">
							{browseTerms.map((term) => (
								<button type="button" data-search-term={term}>{term}</button>
							))}
						</nav>
					</div>
				</div>
			</section>

			<section class="content-section" aria-labelledby="latest-posts-title">
				<div class="site-container home-content-container">
					<header class="section-heading">
						<h2 id="latest-posts-title">أحدث المقالات</h2>
						<a class="fui-link section-action" href="/blog">
							<span>عرض جميع المقالات</span>
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15 10H5m4-4-4 4 4 4"></path></svg>
						</a>
					</header>

					{featuredPost && (
						<div class="articles-layout">
							<article class="featured-card fui-card fui-card--interactive">
								<a href={`/blog/${featuredPost.id}/`} aria-label={featuredPost.data.title}>
									<div class="featured-image">
										{featuredPost.data.heroImageUrl ? (
											<img src={featuredPost.data.heroImageUrl} alt={featuredPost.data.title} loading="eager" fetchpriority="high" referrerpolicy="no-referrer" />
										) : (
											<div class="image-placeholder">H</div>
										)}
									</div>
									<div class="featured-content">
										{featuredCategory && <span class="article-category">{featuredCategory}</span>}
										<h2>{featuredPost.data.title}</h2>
										<p>{featuredPost.data.description}</p>
									</div>
								</a>
							</article>

							<div class="latest-grid">
								{latestPosts.map((post) => (
									<article class="post-card fui-card fui-card--interactive">
										<a href={`/blog/${post.id}/`} aria-label={post.data.title}>
											<div class="post-thumb">
												{post.data.heroImageUrl ? (
													<img src={post.data.heroImageUrl} alt={post.data.title} loading="lazy" referrerpolicy="no-referrer" />
												) : (
													<div class="image-placeholder small">H</div>
												)}
											</div>
											<div class="post-card-content">
												{getDisplayCategory(post.data.labels) && <span class="post-card-category">{getDisplayCategory(post.data.labels)}</span>}
												<h2>{post.data.title}</h2>
												{post.data.description && <p>{post.data.description}</p>}
											</div>
										</a>
									</article>
								))}
							</div>
						</div>
					)}
				</div>
			</section>
		</main>

		<Footer />

		<script id="home-search-data" type="application/json" set:html={JSON.stringify(searchItems).replace(/</g, '\\u003c')}></script>
		<script>
			const initializeHomeSearch = () => {
				const root = document.querySelector<HTMLElement>('[data-home-search]');
				const dataElement = document.getElementById('home-search-data');
				if (!root || !dataElement || root.dataset.initialized === 'true') return;
				root.dataset.initialized = 'true';
				const input = root.querySelector<HTMLInputElement>('#home-search-input');
				const results = root.querySelector<HTMLElement>('#home-search-results');
				const clearButton = root.querySelector<HTMLButtonElement>('.home-search-clear');
				const browseButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-search-term]'));
				if (!input || !results || !clearButton) return;
				type SearchItem = { title: string; description: string; labels: string[]; href: string };
				let items: SearchItem[] = [];
				try { items = JSON.parse(dataElement.textContent || '[]'); } catch { items = []; }
				const normalize = (value: string) => value
					.toLocaleLowerCase('ar').normalize('NFKD')
					.replace(/[\u064B-\u065F\u0670]/g, '').replace(/[أإآ]/g, 'ا')
					.replace(/ى/g, 'ي').replace(/ة/g, 'ه').replace(/\s+/g, ' ').trim();
				const closeResults = () => {
					results.hidden = true;
					results.replaceChildren();
					input.setAttribute('aria-expanded', 'false');
				};
				const render = () => {
					const query = normalize(input.value);
					clearButton.hidden = query.length === 0;
					if (query.length < 2) { closeResults(); return; }
					const terms = query.split(' ').filter(Boolean);
					const matches = items.map((item) => {
						const title = normalize(item.title);
						const description = normalize(item.description);
						const labels = normalize(item.labels.join(' '));
						const haystack = `${title} ${labels} ${description}`;
						if (!terms.every((term) => haystack.includes(term))) return null;
						let score = 0;
						if (title === query) score += 100;
						if (title.startsWith(query)) score += 50;
						if (title.includes(query)) score += 30;
						if (labels.includes(query)) score += 15;
						return { item, score };
					}).filter((entry): entry is { item: SearchItem; score: number } => entry !== null)
						.sort((a, b) => b.score - a.score).slice(0, 8);
					results.replaceChildren();
					if (matches.length === 0) {
						const empty = document.createElement('p');
						empty.className = 'home-search-empty';
						empty.textContent = 'لا توجد نتائج مطابقة. جرّب اسم المحاكي أو الجهاز.';
						results.append(empty);
					} else {
						for (const { item } of matches) {
							const link = document.createElement('a');
							link.href = item.href;
							link.className = 'home-search-result';
							link.setAttribute('role', 'option');
							const title = document.createElement('strong');
							title.textContent = item.title;
							link.append(title);
							if (item.labels.length > 0) {
								const meta = document.createElement('span');
								meta.textContent = item.labels.slice(0, 2).join(' · ');
								link.append(meta);
							}
							results.append(link);
						}
					}
					results.hidden = false;
					input.setAttribute('aria-expanded', 'true');
				};
				input.addEventListener('input', render);
				input.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') {
						input.value = '';
						clearButton.hidden = true;
						closeResults();
						input.blur();
					}
					if (event.key === 'Enter') {
						const first = results.querySelector<HTMLAnchorElement>('.home-search-result');
						if (first) window.location.href = first.href;
					}
				});
				clearButton.addEventListener('click', () => {
					input.value = '';
					clearButton.hidden = true;
					closeResults();
					input.focus();
				});
				for (const button of browseButtons) {
					button.addEventListener('click', () => {
						input.value = button.dataset.searchTerm ?? '';
						render();
						input.focus();
					});
				}
				document.addEventListener('pointerdown', (event) => {
					if (event.target instanceof Node && !root.contains(event.target) && !(event.target instanceof Element && event.target.closest('[data-search-term]'))) closeResults();
				});
			};
			if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeHomeSearch, { once: true });
			else initializeHomeSearch();
			document.addEventListener('astro:page-load', initializeHomeSearch);
		</script>
	</body>
</html>

<style>
	.home-search-section { padding-block: var(--spacing-160) var(--spacing-80); }
	.home-search-wrap { width: min(100%, 860px); margin-inline: auto; }
	.home-search-title {
		margin-bottom: var(--spacing-80);
		font-size: var(--font-size-subtitle-1);
		font-weight: var(--font-weight-semibold);
		line-height: var(--line-height-subtitle-1);
		text-align: center;
	}
	.home-search { position: relative; z-index: 20; }
	.home-search-field {
		display: flex;
		min-height: 44px;
		align-items: center;
		gap: var(--spacing-80);
		padding-inline: var(--spacing-120);
		border: var(--stroke-thin) solid var(--color-neutral-stroke-1);
		border-radius: var(--radius-medium);
		background: var(--color-neutral-background-1);
		box-shadow: var(--shadow-2);
		transition: border-color var(--duration-faster) var(--curve-easy-ease), box-shadow var(--duration-faster) var(--curve-easy-ease), background var(--duration-faster) var(--curve-easy-ease);
	}
	.home-search-field > svg { width: 18px; height: 18px; flex: 0 0 auto; fill: none; stroke: var(--color-neutral-foreground-3); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; }
	.home-search-field input { width: 100%; min-width: 0; height: 42px; padding: 0; border: 0; outline: 0; background: transparent; color: var(--color-neutral-foreground-1); font-size: var(--font-size-body-1); }
	.home-search-field input::placeholder { color: var(--color-neutral-foreground-4); }
	.home-search-field input::-webkit-search-cancel-button { display: none; }
	.home-search-clear { display: grid; width: 32px; height: 32px; flex: 0 0 auto; place-items: center; padding: 0; border: 0; border-radius: var(--radius-medium); background: transparent; color: var(--color-neutral-foreground-3); cursor: pointer; }
	.home-search-clear[hidden] { display: none; }
	.home-search-clear:hover { background: var(--color-subtle-background-hover); color: var(--color-neutral-foreground-1); }
	.home-search-clear svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.6; }
	.home-search-results { position: absolute; inset-inline: 0; top: calc(100% + var(--spacing-60)); overflow: hidden; padding: var(--spacing-60); border: var(--stroke-thin) solid var(--color-neutral-stroke-1); border-radius: var(--radius-large); background: var(--color-neutral-background-1); box-shadow: var(--shadow-16); }
	.home-search-results[hidden] { display: none; }
	:global(.home-search-result) { display: flex; min-height: 52px; flex-direction: column; justify-content: center; gap: 2px; padding: var(--spacing-80) var(--spacing-100); border-radius: var(--radius-medium); color: var(--color-neutral-foreground-1); text-decoration: none; }
	:global(.home-search-result:hover), :global(.home-search-result:focus-visible) { background: var(--color-subtle-background-hover); }
	:global(.home-search-result strong) { display: -webkit-box; overflow: hidden; font-size: var(--font-size-body-1); font-weight: var(--font-weight-semibold); line-height: var(--line-height-body-1); -webkit-box-orient: vertical; -webkit-line-clamp: 1; }
	:global(.home-search-result span) { color: var(--color-neutral-foreground-3); font-size: var(--font-size-caption-1); line-height: var(--line-height-caption-1); }
	:global(.home-search-empty) { margin: 0; padding: var(--spacing-160); color: var(--color-neutral-foreground-3); font-size: var(--font-size-body-1); text-align: center; }
	.browse-shortcuts { display: flex; justify-content: center; gap: var(--spacing-60); margin-top: var(--spacing-100); flex-wrap: wrap; }
	.browse-shortcuts button { min-height: 30px; padding-inline: var(--spacing-100); border: var(--stroke-thin) solid var(--color-neutral-stroke-2); border-radius: var(--radius-circular); background: var(--color-subtle-background); color: var(--color-neutral-foreground-3); font: inherit; font-size: var(--font-size-caption-1); font-weight: var(--font-weight-semibold); cursor: pointer; transition: background var(--duration-faster) var(--curve-easy-ease), color var(--duration-faster) var(--curve-easy-ease), border-color var(--duration-faster) var(--curve-easy-ease); }
	.browse-shortcuts button:hover, .browse-shortcuts button:focus-visible { border-color: var(--color-neutral-stroke-1-hover); background: var(--color-subtle-background-hover); color: var(--color-neutral-foreground-1); }

	.content-section { padding-block: var(--spacing-120) var(--spacing-240); }
	.home-content-container { width: min(calc(100% - (var(--page-gutter) * 2)), 1160px); }
	.section-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-160); margin-bottom: var(--spacing-160); }
	.section-heading h2 { font-size: var(--font-size-title-3); line-height: var(--line-height-title-3); text-wrap: balance; }
	.section-action { flex: 0 0 auto; color: var(--color-neutral-foreground-3); }
	.section-action:hover, .section-action:focus-visible { color: var(--color-brand-foreground-strong); }
	.section-action svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
	.articles-layout { display: grid; gap: var(--spacing-160); }

	.featured-card, .post-card {
		overflow: hidden;
		border-color: var(--color-neutral-stroke-alpha);
		background: var(--color-neutral-card-background);
		transition: border-color var(--duration-faster) var(--curve-easy-ease), box-shadow var(--duration-normal) var(--curve-decelerate-mid), background var(--duration-faster) var(--curve-easy-ease);
	}
	.featured-card:hover, .post-card:hover { border-color: var(--color-neutral-stroke-2); background: var(--color-neutral-card-background-hover); box-shadow: var(--shadow-8); }
	.featured-card > a, .post-card > a { outline: none; }
	.featured-card > a:focus-visible, .post-card > a:focus-visible { outline: 2px solid var(--color-brand-stroke-1); outline-offset: -2px; }
	.featured-card > a { display: grid; grid-template-columns: minmax(0, 1.42fr) minmax(330px, 1fr); height: 236px; color: inherit; direction: ltr; text-decoration: none; }
	.featured-image, .post-thumb { min-width: 0; overflow: hidden; background: var(--color-neutral-background-3); }
	.featured-content { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; justify-content: center; padding: var(--spacing-180) var(--spacing-200); direction: rtl; text-align: right; }
	.article-category, .post-card-category { display: inline-flex; max-width: 100%; align-items: center; gap: var(--spacing-60); color: var(--color-brand-foreground-strong); font-size: var(--font-size-caption-1); font-weight: var(--font-weight-semibold); line-height: var(--line-height-caption-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.article-category::before, .post-card-category::before { width: 5px; height: 5px; flex: 0 0 auto; border-radius: var(--radius-circular); background: var(--color-brand-background); content: ''; }
	.featured-content h2 { display: -webkit-box; overflow: hidden; margin-top: var(--spacing-60); font-size: var(--font-size-subtitle-1); line-height: var(--line-height-subtitle-1); text-wrap: balance; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.featured-content p { display: -webkit-box; overflow: hidden; margin-top: var(--spacing-100); color: var(--color-neutral-foreground-2); font-size: var(--font-size-body-1); line-height: var(--line-height-body-1); text-wrap: pretty; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.featured-image img, .post-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform var(--duration-slow) var(--curve-decelerate-mid); }
	.featured-card:hover img, .post-card:hover img { transform: scale(1.01); }
	.image-placeholder { display: grid; width: 100%; height: 100%; min-height: 160px; place-items: center; background: var(--color-neutral-background-3); color: var(--color-neutral-foreground-4); font-size: var(--font-size-title-3); font-weight: var(--font-weight-semibold); }
	.image-placeholder.small { min-height: 0; font-size: var(--font-size-subtitle-2); }

	.latest-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: start;
		gap: var(--spacing-160);
	}
	.post-card { align-self: start; }
	.post-card > a { display: flex; min-width: 0; flex-direction: column; color: inherit; text-decoration: none; }
	.post-thumb { aspect-ratio: 16 / 9; }
	.post-card-content {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-60);
		padding: var(--spacing-120) var(--spacing-140) var(--spacing-140);
		direction: rtl;
		text-align: right;
	}
	.post-card-content h2 { display: -webkit-box; overflow: hidden; width: 100%; font-size: var(--font-size-body-1); font-weight: var(--font-weight-semibold); line-height: var(--line-height-body-1); text-align: right; text-wrap: pretty; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.post-card-content p { display: -webkit-box; overflow: hidden; width: 100%; margin-top: 2px; color: var(--color-neutral-foreground-3); font-size: var(--font-size-caption-1); line-height: 1.65; text-wrap: pretty; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

	@media (max-width: 1023px) {
		.home-content-container { width: min(calc(100% - (var(--page-gutter) * 2)), 960px); }
		.featured-card > a { grid-template-columns: minmax(0, 1.3fr) minmax(280px, 1fr); height: 220px; }
	}
	@media (max-width: 767px) {
		.home-search-section { padding-top: var(--spacing-120); }
		.home-search-title { font-size: var(--font-size-subtitle-2); line-height: var(--line-height-subtitle-2); }
		.content-section { padding-top: var(--spacing-100); }
		.featured-card > a { grid-template-columns: 1fr; height: auto; }
		.featured-image { aspect-ratio: 16 / 8.5; }
		.featured-content { padding: var(--spacing-140); }
		.featured-content h2 { font-size: var(--font-size-subtitle-2); line-height: var(--line-height-subtitle-2); }
		.latest-grid { grid-template-columns: 1fr; gap: var(--spacing-140); }
		.post-card > a { display: grid; grid-template-columns: minmax(180px, 42%) minmax(0, 1fr); }
		.post-thumb { height: 100%; min-height: 164px; aspect-ratio: auto; }
		.post-card-content { justify-content: center; }
	}
	@media (max-width: 639px) {
		.home-search-title { text-align: right; }
		.browse-shortcuts { justify-content: flex-start; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 2px; scrollbar-width: none; }
		.browse-shortcuts::-webkit-scrollbar { display: none; }
		.browse-shortcuts button { flex: 0 0 auto; min-height: 36px; }
		.section-heading { gap: var(--spacing-80); }
		.section-action span { display: none; }
		.section-action { width: 36px; height: 36px; justify-content: center; padding: 0; }
		.post-card > a { grid-template-columns: 124px minmax(0, 1fr); }
		.post-thumb { min-height: 116px; }
		.post-card-content { padding: var(--spacing-80) var(--spacing-100); gap: var(--spacing-40); }
		.post-card-content p { display: none; }
		.post-card-category { font-size: 11px; }
	}
	@media (max-width: 420px) { .post-card > a { grid-template-columns: 108px minmax(0, 1fr); } }
	@media (prefers-reduced-motion: reduce) {
		.featured-card, .post-card, .featured-image img, .post-thumb img { transition: none; }
		.featured-card:hover img, .post-card:hover img { transform: none; }
	}
</style>