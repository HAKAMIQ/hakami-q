---
import bloggerPages from '../data/blogger-pages.json';
import BloggerPageLayout from '../layouts/BloggerPageLayout.astro';

type BloggerPage = {
	route: string;
	title: string;
	description: string;
	lang: 'ar' | 'en';
	dir: 'rtl' | 'ltr';
	sourceUrl?: string;
	updated?: string;
	aliases?: string[];
	content: string;
};

const pages = bloggerPages as BloggerPage[];

export function getStaticPaths() {
	const paths: Array<{ params: { page: string }; props: { page: BloggerPage } }> = [];
	const used = new Set<string>();

	for (const page of pages) {
		for (const route of [page.route, ...(page.aliases || [])]) {
			const normalized = route.replace(/^\/+|\/+$/g, '');
			if (!normalized || used.has(normalized)) continue;
			used.add(normalized);
			paths.push({ params: { page: normalized }, props: { page } });
		}
	}

	return paths;
}

const { page } = Astro.props as { page: BloggerPage };
---

<BloggerPageLayout
	title={page.title}
	description={page.description}
	lang={page.lang}
	dir={page.dir}
	content={page.content}
	updated={page.updated}
	sourceUrl={page.sourceUrl}
/>
