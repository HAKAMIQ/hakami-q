---
import StaticPageLayout from '../layouts/StaticPageLayout.astro';

type PageLink = {
	label: string;
	description: string;
	href: string;
	external?: boolean;
};

type PageSection = {
	title: string;
	paragraphs?: string[];
	bullets?: string[];
	links?: PageLink[];
};

type PageData = {
	slug: string;
	title: string;
	description: string;
	lang: 'ar' | 'en';
	dir: 'rtl' | 'ltr';
	eyebrow: string;
	alternateHref: string;
	alternateLabel: string;
	sections: PageSection[];
};

