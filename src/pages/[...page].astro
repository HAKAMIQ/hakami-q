export function getStaticPaths() {
	return pages.map((page) => ({
		params: { page: page.slug },
		props: { pageData: page },
	}));
}

const { pageData } = Astro.props as { pageData: PageData };
---

<StaticPageLayout
	title={pageData.title}
	description={pageData.description}
	lang={pageData.lang}
	dir={pageData.dir}
	eyebrow={pageData.eyebrow}
	alternateHref={pageData.alternateHref}
	alternateLabel={pageData.alternateLabel}
>
	{
		pageData.sections.map((section) => (
			<section>
				<h2>{section.title}</h2>
				{section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
				{
					section.bullets && (
						<ul>
							{section.bullets.map((item) => <li>{item}</li>)}
						</ul>
					)
				}
				{
					section.links && (
						<div class="link-grid">
							{section.links.map((link) => (
								<a
									class="contact-card"
									href={link.href}
									target={link.external ? '_blank' : undefined}
									rel={link.external ? 'noopener noreferrer' : undefined}
								>
									<strong>{link.label}</strong>
									<span>{link.description}</span>
								</a>
							))}
						</div>
					)
				}
			</section>
		))
	}
</StaticPageLayout>
