---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SkipLink from '../../components/SkipLink.astro';
import '../../styles/account-system.css';
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<BaseHead title="سجل الأعضاء | HAKAMIQ" description="إدارة حسابات وصلاحيات وسجل أعضاء HAKAMIQ." />
		<meta name="robots" content="noindex,nofollow,noarchive" />
	</head>
	<body>
		<SkipLink />
		<Header />
		<main id="main-content" tabindex="-1" class="account-main">
			<div class="account-shell account-shell--wide">
				<header class="account-heading">
					<p class="account-kicker">HAKAMIQ MEMBER REGISTRY</p>
					<h1>سجل الأعضاء</h1>
					<p id="page-status">جاري التحقق من الصلاحيات…</p>
				</header>

				<section id="bootstrap-card" class="account-card account-hidden" aria-labelledby="bootstrap-title">
					<h2 id="bootstrap-title">إنشاء حساب المدير الأول</h2>
					<p>هذه الخطوة تعمل مرة واحدة فقط. سجّل الدخول أولًا من <a href="/admin">لوحة إدارة المقالات الحالية</a> في نفس المتصفح، ثم أنشئ حساب المدير.</p>
					<form id="bootstrap-form" class="account-form">
						<div class="account-grid">
							<div class="account-field">
								<label for="bootstrap-username">اسم المستخدم</label>
								<input id="bootstrap-username" class="account-input" type="text" minlength="3" maxlength="32" autocomplete="username" required />
							</div>
							<div class="account-field">
								<label for="bootstrap-email">البريد الإلكتروني</label>
								<input id="bootstrap-email" class="account-input" type="email" maxlength="254" autocomplete="email" required />
							</div>
							<div class="account-field">
								<label for="bootstrap-password">كلمة المرور</label>
								<input id="bootstrap-password" class="account-input" type="password" minlength="12" maxlength="128" autocomplete="new-password" required />
							</div>
							<div class="account-field">
								<label for="bootstrap-confirm">تأكيد كلمة المرور</label>
								<input id="bootstrap-confirm" class="account-input" type="password" minlength="12" maxlength="128" autocomplete="new-password" required />
							</div>
						</div>
						<div class="account-actions">
							<button id="bootstrap-button" class="account-button account-button--primary" type="submit">إنشاء المدير الأول</button>
						</div>
						<p id="bootstrap-feedback" class="account-feedback account-hidden" role="status"></p>
					</form>
				</section>

				<section id="access-card" class="account-card account-hidden">
					<h2>لا توجد صلاحية إدارة</h2>
					<p id="access-message">سجّل الدخول بحساب مشرف أو مدير للمتابعة.</p>
					<div class="account-actions">
						<a class="account-button account-button--primary" href="/login?next=/admin/users">تسجيل الدخول</a>
						<a id="security-link" class="account-button account-hidden" href="/account?security=setup">إعداد التحقق بخطوتين</a>
						<a class="account-button" href="/account">حسابي</a>
					</div>
				</section>

				<section id="users-card" class="account-card account-hidden" aria-labelledby="users-title">
					<div class="users-toolbar">
						<div>
							<h2 id="users-title">الحسابات</h2>
							<p id="actor-label" class="account-help"></p>
						</div>
						<button id="refresh-button" class="account-button" type="button">تحديث</button>
					</div>

					<dl id="registry-stats" class="member-stats" aria-label="إحصاءات الأعضاء">
						<div><dt>إجمالي الأعضاء</dt><dd id="stat-total">—</dd></div>
						<div><dt>نشط</dt><dd id="stat-active">—</dd></div>
						<div><dt>موقوف</dt><dd id="stat-suspended">—</dd></div>
						<div><dt>مدير</dt><dd id="stat-admins">—</dd></div>
						<div><dt>مشرف</dt><dd id="stat-moderators">—</dd></div>
						<div><dt>مقفل مؤقتًا</dt><dd id="stat-locked">—</dd></div>
					</dl>

					<form id="users-filter-form" class="member-filter" role="search">
						<div class="account-field member-filter__search">
							<label for="users-search">بحث</label>
							<input id="users-search" class="account-input" type="search" maxlength="80" placeholder="اسم المستخدم أو البريد للمدير" />
						</div>
						<div class="account-field">
							<label for="users-role">الصلاحية</label>
							<select id="users-role" class="account-select">
								<option value="">الكل</option>
								<option value="user">مستخدم</option>
								<option value="moderator">مشرف</option>
								<option value="admin">مدير</option>
							</select>
						</div>
						<div class="account-field">
							<label for="users-status">الحالة</label>
							<select id="users-status" class="account-select">
								<option value="">الكل</option>
								<option value="active">نشط</option>
								<option value="suspended">موقوف</option>
							</select>
						</div>
						<div class="member-filter__actions">
							<button class="account-button account-button--primary" type="submit">تطبيق</button>
							<button id="clear-filter-button" class="account-button" type="button">مسح</button>
						</div>
					</form>

					<p id="users-feedback" class="account-feedback account-hidden" role="status"></p>
					<div class="users-table-wrap">
						<table class="users-table member-registry-table">
							<thead>
								<tr>
									<th>العضو</th>
									<th>البريد</th>
									<th>الصلاحية</th>
									<th>الحالة</th>
									<th>آخر دخول</th>
									<th>التسجيل</th>
									<th>الجلسات</th>
									<th>الإجراءات</th>
								</tr>
							</thead>
							<tbody id="users-body"></tbody>
						</table>
					</div>
					<div class="member-pagination" aria-label="صفحات سجل الأعضاء">
						<button id="previous-page" class="account-button" type="button">السابق</button>
						<span id="pagination-label" class="account-help">—</span>
						<button id="next-page" class="account-button" type="button">التالي</button>
					</div>
				</section>

				<section id="audit-card" class="account-card account-hidden" aria-labelledby="audit-title">
					<div class="users-toolbar">
						<div>
							<h2 id="audit-title">سجل التدقيق الأمني</h2>
							<p class="account-help">يظهر للمدير فقط، ولا يخزن عنوان IP الخام.</p>
						</div>
						<button id="audit-refresh-button" class="account-button" type="button">تحديث السجل</button>
					</div>
					<p id="audit-feedback" class="account-feedback account-hidden" role="status"></p>
					<div class="users-table-wrap">
						<table class="users-table audit-table">
							<thead>
								<tr>
									<th>الوقت</th>
									<th>الحدث</th>
									<th>المنفذ</th>
									<th>العضو</th>
									<th>التفاصيل</th>
								</tr>
							</thead>
							<tbody id="audit-body"></tbody>
						</table>
					</div>
				</section>
			</div>
		</main>
		<Footer />

		<script>
			type AccountUser = {
				id: string;
				username: string;
				email?: string;
				role: 'user' | 'moderator' | 'admin';
				status: 'active' | 'suspended';
				createdAt: string;
				updatedAt?: string;
				lastLoginAt?: string | null;
				lockedUntil?: string | null;
				statusReason?: string;
				statusChangedAt?: string | null;
				activeSessions?: number;
			};

			type Pagination = { page: number; limit: number; total: number; totalPages: number };
			type AuditEvent = {
				id: number;
				occurredAt: string;
				eventType: string;
				outcome: 'success' | 'failure';
				actorUsername?: string;
				targetUsername?: string;
				metadata?: Record<string, unknown> | null;
			};

			class ApiFailure extends Error {
				payload: Record<string, unknown>;
				status: number;
				constructor(message: string, status: number, payload: Record<string, unknown>) {
					super(message);
					this.payload = payload;
					this.status = status;
				}
			}

			let actor: AccountUser | null = null;
			let currentPage = 1;
			let currentPagination: Pagination = { page: 1, limit: 50, total: 0, totalPages: 1 };

			const pageStatus = document.querySelector<HTMLElement>('#page-status');
			const bootstrapCard = document.querySelector<HTMLElement>('#bootstrap-card');
			const accessCard = document.querySelector<HTMLElement>('#access-card');
			const accessMessage = document.querySelector<HTMLElement>('#access-message');
			const securityLink = document.querySelector<HTMLAnchorElement>('#security-link');
			const usersCard = document.querySelector<HTMLElement>('#users-card');
			const auditCard = document.querySelector<HTMLElement>('#audit-card');
			const usersBody = document.querySelector<HTMLTableSectionElement>('#users-body');
			const auditBody = document.querySelector<HTMLTableSectionElement>('#audit-body');
			const usersFeedback = document.querySelector<HTMLElement>('#users-feedback');
			const auditFeedback = document.querySelector<HTMLElement>('#audit-feedback');
			const actorLabel = document.querySelector<HTMLElement>('#actor-label');
			const refreshButton = document.querySelector<HTMLButtonElement>('#refresh-button');
			const auditRefreshButton = document.querySelector<HTMLButtonElement>('#audit-refresh-button');
			const filterForm = document.querySelector<HTMLFormElement>('#users-filter-form');
			const searchInput = document.querySelector<HTMLInputElement>('#users-search');
			const roleFilter = document.querySelector<HTMLSelectElement>('#users-role');
			const statusFilter = document.querySelector<HTMLSelectElement>('#users-status');
			const clearFilterButton = document.querySelector<HTMLButtonElement>('#clear-filter-button');
			const previousPage = document.querySelector<HTMLButtonElement>('#previous-page');
			const nextPage = document.querySelector<HTMLButtonElement>('#next-page');
			const paginationLabel = document.querySelector<HTMLElement>('#pagination-label');
			const bootstrapForm = document.querySelector<HTMLFormElement>('#bootstrap-form');
			const bootstrapFeedback = document.querySelector<HTMLElement>('#bootstrap-feedback');
			const bootstrapButton = document.querySelector<HTMLButtonElement>('#bootstrap-button');

			const roleNames: Record<string, string> = { user: 'مستخدم', moderator: 'مشرف', admin: 'مدير' };
			const statusNames: Record<string, string> = { active: 'نشط', suspended: 'موقوف' };
			const eventNames: Record<string, string> = {
				'member.registered': 'تسجيل عضو',
				'member.admin.bootstrap': 'إنشاء المدير الأول',
				'auth.login.success': 'دخول ناجح',
				'auth.login.failure': 'محاولة دخول مرفوضة',
				'auth.logout': 'تسجيل خروج',
				'member.role.changed': 'تغيير صلاحية',
				'member.suspended': 'إيقاف عضو',
				'member.reactivated': 'إعادة تفعيل عضو',
				'member.login_lock.cleared': 'فتح قفل الدخول',
			};

			function feedback(element: HTMLElement | null, message: string, kind = '') {
				if (!element) return;
				element.textContent = message;
				element.dataset.kind = kind;
				element.classList.toggle('account-hidden', !message);
			}

			async function api(path: string, options: RequestInit = {}) {
				const response = await fetch(`/api/auth/${path}`, {
					credentials: 'same-origin',
					headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
					...options,
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) throw new ApiFailure(payload.error || 'تعذر تنفيذ الطلب.', response.status, payload);
				return payload;
			}

			function cell(text = '') {
				const td = document.createElement('td');
				td.textContent = text;
				return td;
			}

			function formatDate(value?: string | null, withTime = false) {
				if (!value) return '—';
				const date = new Date(value);
				if (Number.isNaN(date.getTime())) return '—';
				return withTime
					? date.toLocaleString('ar-SA', { dateStyle: 'medium', timeStyle: 'short' })
					: date.toLocaleDateString('ar-SA', { dateStyle: 'medium' });
			}

			function isLocked(user: AccountUser) {
				return Boolean(user.lockedUntil && Date.parse(user.lockedUntil) > Date.now());
			}

			function actionButton(label: string, danger = false) {
				const button = document.createElement('button');
				button.className = `account-button${danger ? ' account-button--danger' : ''}`;
				button.type = 'button';
				button.textContent = label;
				return button;
			}

			function renderStats(stats: Record<string, number> = {}) {
				for (const key of ['total', 'active', 'suspended', 'admins', 'moderators', 'locked']) {
					const element = document.querySelector<HTMLElement>(`#stat-${key}`);
					if (element) element.textContent = String(Number(stats[key] || 0).toLocaleString('ar-SA'));
				}
			}

			function renderPagination(pagination: Pagination) {
				currentPagination = pagination;
				currentPage = pagination.page;
				if (paginationLabel) paginationLabel.textContent = `صفحة ${pagination.page.toLocaleString('ar-SA')} من ${pagination.totalPages.toLocaleString('ar-SA')} — ${pagination.total.toLocaleString('ar-SA')} نتيجة`;
				if (previousPage) previousPage.disabled = pagination.page <= 1;
				if (nextPage) nextPage.disabled = pagination.page >= pagination.totalPages;
			}

			function renderUsers(users: AccountUser[]) {
				if (!usersBody || !actor) return;
				usersBody.replaceChildren();
				if (!users.length) {
					const row = document.createElement('tr');
					const empty = cell('لا توجد حسابات مطابقة.');
					empty.colSpan = 8;
					row.append(empty);
					usersBody.append(row);
					return;
				}
				for (const user of users) {
					const row = document.createElement('tr');
					const memberCell = document.createElement('td');
					const memberName = document.createElement('strong');
					memberName.textContent = user.username;
					memberCell.append(memberName);
					if (isLocked(user)) {
						const locked = document.createElement('small');
						locked.className = 'member-cell-note member-cell-note--danger';
						locked.textContent = `قفل دخول حتى ${formatDate(user.lockedUntil, true)}`;
						memberCell.append(locked);
					}
					row.append(memberCell);
					row.append(cell(user.email || '—'));

					const roleCell = document.createElement('td');
					if (actor.role === 'admin') {
						const select = document.createElement('select');
						select.className = 'account-select account-select--compact';
						select.setAttribute('aria-label', `صلاحية ${user.username}`);
						for (const value of ['user', 'moderator', 'admin'] as const) {
							const option = document.createElement('option');
							option.value = value;
							option.textContent = roleNames[value];
							option.selected = user.role === value;
							select.append(option);
						}
						select.disabled = user.id === actor.id;
						select.addEventListener('change', async () => {
							const previous = user.role;
							try {
								await api('user-role', { method: 'POST', body: JSON.stringify({ userId: user.id, role: select.value }) });
								feedback(usersFeedback, `تم تحديث صلاحية ${user.username}.`, 'success');
								await Promise.all([loadUsers(currentPage), loadAudit()]);
							} catch (error) {
								select.value = previous;
								feedback(usersFeedback, error instanceof Error ? error.message : 'تعذر تحديث الصلاحية.', 'error');
							}
						});
						roleCell.append(select);
					} else {
						roleCell.textContent = roleNames[user.role] || user.role;
					}
					row.append(roleCell);

					const statusCell = document.createElement('td');
					const badge = document.createElement('span');
					badge.className = 'status-badge';
					badge.dataset.status = user.status;
					badge.textContent = statusNames[user.status] || user.status;
					statusCell.append(badge);
					if (user.statusReason) {
						const reason = document.createElement('small');
						reason.className = 'member-cell-note';
						reason.textContent = user.statusReason;
						statusCell.append(reason);
					}
					row.append(statusCell);
					row.append(cell(formatDate(user.lastLoginAt, true)));
					row.append(cell(formatDate(user.createdAt)));
					row.append(cell(String(Number(user.activeSessions || 0).toLocaleString('ar-SA'))));

					const actionCell = document.createElement('td');
					actionCell.className = 'member-actions-cell';
					const canManage = user.id !== actor.id && (
						(actor.role === 'admin' && user.role !== 'admin') ||
						(actor.role === 'moderator' && user.role === 'user')
					);
					if (canManage) {
						const statusButton = actionButton(user.status === 'active' ? 'إيقاف' : 'تفعيل', user.status === 'active');
						statusButton.addEventListener('click', async () => {
							const nextStatus = user.status === 'active' ? 'suspended' : 'active';
							const reason = nextStatus === 'suspended'
								? (window.prompt(`سبب إيقاف ${user.username} (اختياري):`, '') || '').trim()
								: '';
							statusButton.disabled = true;
							try {
								await api('user-status', { method: 'POST', body: JSON.stringify({ userId: user.id, status: nextStatus, reason }) });
								feedback(usersFeedback, `تم تحديث حالة ${user.username}.`, 'success');
								await Promise.all([loadUsers(currentPage), loadAudit()]);
							} catch (error) {
								feedback(usersFeedback, error instanceof Error ? error.message : 'تعذر تحديث الحالة.', 'error');
								statusButton.disabled = false;
							}
						});
						actionCell.append(statusButton);

						if (isLocked(user)) {
							const unlockButton = actionButton('فتح القفل');
							unlockButton.addEventListener('click', async () => {
								unlockButton.disabled = true;
								try {
									await api('user-unlock', { method: 'POST', body: JSON.stringify({ userId: user.id }) });
									feedback(usersFeedback, `تم فتح قفل دخول ${user.username}.`, 'success');
									await Promise.all([loadUsers(currentPage), loadAudit()]);
								} catch (error) {
									feedback(usersFeedback, error instanceof Error ? error.message : 'تعذر فتح القفل.', 'error');
									unlockButton.disabled = false;
								}
							});
							actionCell.append(unlockButton);
						}
					} else {
						actionCell.textContent = '—';
					}
					row.append(actionCell);
					usersBody.append(row);
				}
			}

			function metadataText(metadata?: Record<string, unknown> | null) {
				if (!metadata) return '—';
				const parts: string[] = [];
				if (metadata.oldRole || metadata.newRole) parts.push(`${roleNames[String(metadata.oldRole)] || metadata.oldRole || '—'} ← ${roleNames[String(metadata.newRole)] || metadata.newRole || '—'}`);
				if (metadata.oldStatus || metadata.newStatus) parts.push(`${statusNames[String(metadata.oldStatus)] || metadata.oldStatus || '—'} ← ${statusNames[String(metadata.newStatus)] || metadata.newStatus || '—'}`);
				if (metadata.reason) parts.push(String(metadata.reason));
				if (metadata.lockApplied === true) parts.push('تم تطبيق قفل مؤقت');
				if (metadata.knownAccount === false) parts.push('حساب غير معروف');
				return parts.join(' • ') || '—';
			}

			function renderAudit(events: AuditEvent[]) {
				if (!auditBody) return;
				auditBody.replaceChildren();
				if (!events.length) {
					const row = document.createElement('tr');
					const empty = cell('لا توجد أحداث مسجلة حتى الآن.');
					empty.colSpan = 5;
					row.append(empty);
					auditBody.append(row);
					return;
				}
				for (const event of events) {
					const row = document.createElement('tr');
					row.append(cell(formatDate(event.occurredAt, true)));
					const eventCell = document.createElement('td');
					const badge = document.createElement('span');
					badge.className = 'audit-event-badge';
					badge.dataset.outcome = event.outcome;
					badge.textContent = eventNames[event.eventType] || event.eventType;
					eventCell.append(badge);
					row.append(eventCell);
					row.append(cell(event.actorUsername || 'النظام'));
					row.append(cell(event.targetUsername || '—'));
					row.append(cell(metadataText(event.metadata)));
					auditBody.append(row);
				}
			}

			function filterQuery(page = 1) {
				const params = new URLSearchParams({ page: String(page), limit: '50' });
				const q = searchInput?.value.trim() || '';
				const role = roleFilter?.value || '';
				const status = statusFilter?.value || '';
				if (q) params.set('q', q);
				if (role) params.set('role', role);
				if (status) params.set('status', status);
				return params.toString();
			}

			async function loadUsers(page = 1) {
				feedback(usersFeedback, 'جاري تحميل سجل الأعضاء…');
				try {
					const payload = await api(`users?${filterQuery(page)}`);
					actor = payload.actor;
					if (actorLabel && actor) actorLabel.textContent = `متصل كـ ${roleNames[actor.role] || actor.role}: ${actor.username}`;
					renderUsers(payload.users || []);
					renderStats(payload.stats || {});
					renderPagination(payload.pagination || { page: 1, limit: 50, total: 0, totalPages: 1 });
					feedback(usersFeedback, '');
					return true;
				} catch (error) {
					if (error instanceof ApiFailure && (error.payload.mfaSetupRequired || error.payload.mfaRequired)) {
						usersCard?.classList.add('account-hidden');
						accessCard?.classList.remove('account-hidden');
						if (accessMessage) accessMessage.textContent = error.message;
						securityLink?.classList.remove('account-hidden');
					}
					feedback(usersFeedback, error instanceof Error ? error.message : 'تعذر تحميل المستخدمين.', 'error');
					return false;
				}
			}

			async function loadAudit() {
				if (!actor || actor.role !== 'admin') return;
				auditCard?.classList.remove('account-hidden');
				feedback(auditFeedback, 'جاري تحميل سجل التدقيق…');
				try {
					const payload = await api('audit-log?limit=50&page=1');
					renderAudit(payload.events || []);
					feedback(auditFeedback, '');
				} catch (error) {
					feedback(auditFeedback, error instanceof Error ? error.message : 'تعذر تحميل سجل التدقيق.', 'error');
				}
			}

			async function initialize() {
				try {
					const sessionPayload = await api('session');
					if (sessionPayload.authenticated && ['moderator', 'admin'].includes(sessionPayload.user?.role)) {
						actor = sessionPayload.user;
						if (pageStatus) pageStatus.textContent = 'إدارة الحسابات والصلاحيات وسجل النشاط.';
						usersCard?.classList.remove('account-hidden');
						const loaded = await loadUsers(1);
						if (loaded) await loadAudit();
						return;
					}
					const bootstrap = await api('bootstrap-status');
					if (bootstrap.needsBootstrap) {
						if (pageStatus) pageStatus.textContent = 'يلزم إنشاء حساب المدير الأول.';
						bootstrapCard?.classList.remove('account-hidden');
					} else {
						if (pageStatus) pageStatus.textContent = 'يلزم تسجيل الدخول بحساب إداري.';
						accessCard?.classList.remove('account-hidden');
					}
				} catch (error) {
					if (pageStatus) pageStatus.textContent = error instanceof Error ? error.message : 'تعذر تهيئة سجل الأعضاء.';
					accessCard?.classList.remove('account-hidden');
				}
			}

			bootstrapForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const username = document.querySelector<HTMLInputElement>('#bootstrap-username');
				const email = document.querySelector<HTMLInputElement>('#bootstrap-email');
				const password = document.querySelector<HTMLInputElement>('#bootstrap-password');
				const confirm = document.querySelector<HTMLInputElement>('#bootstrap-confirm');
				if (!username || !email || !password || !confirm || !bootstrapButton) return;
				if (password.value !== confirm.value) {
					feedback(bootstrapFeedback, 'كلمتا المرور غير متطابقتين.', 'error');
					return;
				}
				bootstrapButton.disabled = true;
				try {
					await api('bootstrap-admin', {
						method: 'POST',
						body: JSON.stringify({ username: username.value, email: email.value, password: password.value }),
					});
					window.location.assign('/account?security=setup');
				} catch (error) {
					feedback(bootstrapFeedback, error instanceof Error ? error.message : 'تعذر إنشاء المدير الأول.', 'error');
					bootstrapButton.disabled = false;
				}
			});

			filterForm?.addEventListener('submit', async (event) => {
				event.preventDefault();
				await loadUsers(1);
			});
			clearFilterButton?.addEventListener('click', async () => {
				if (searchInput) searchInput.value = '';
				if (roleFilter) roleFilter.value = '';
				if (statusFilter) statusFilter.value = '';
				await loadUsers(1);
			});
			previousPage?.addEventListener('click', () => loadUsers(Math.max(1, currentPagination.page - 1)));
			nextPage?.addEventListener('click', () => loadUsers(Math.min(currentPagination.totalPages, currentPagination.page + 1)));
			refreshButton?.addEventListener('click', async () => {
				await loadUsers(currentPage);
				await loadAudit();
			});
			auditRefreshButton?.addEventListener('click', loadAudit);
			initialize();
		</script>
	</body>
</html>
